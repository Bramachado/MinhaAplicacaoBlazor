    @* ============================ PAGAMENTOS BANCÁRIOS ============================ *@
    private RenderFragment RenderPagamentosBancarios() => __builder =>
    {
        if (dadosPagamentos is null) return;

        <style>
            .tabela-pagamentos { white-space: nowrap; }
            .tabela-pagamentos th, .tabela-pagamentos td { white-space: nowrap; }
        </style>

        <div class="d-flex justify-content-between align-items-center mb-3 d-print-none">
            <span class="text-muted">Somente lançamentos de folhas com status <strong>Fechada</strong>.</span>
            <button class="btn btn-success" @onclick="ExportarPagamentosExcelAsync" disabled="@(dadosPagamentos.Linhas.Count == 0)">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-1" style="vertical-align:-2px;">
                    <path d="M5.884 6.68a.5.5 0 1 0-.768.64L7.349 10l-2.233 2.68a.5.5 0 0 0 .768.64L8 10.781l2.116 2.54a.5.5 0 0 0 .768-.641L8.651 10l2.233-2.68a.5.5 0 0 0-.768-.64L8 9.219z"/>
                    <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5z"/>
                </svg>
                Exportar Excel
            </button>
        </div>

        if (dadosPagamentos.Linhas.Count == 0)
        {
            <div class="alert alert-warning">Nenhum pagamento encontrado para esta competência em folhas fechadas.</div>
            return;
        }

        <div class="table-responsive">
            <table class="table table-sm table-striped table-hover align-middle tabela-pagamentos">
                <thead class="table-dark">
                    <tr>
                        <th>Unidade</th>
                        <th>Competência</th>
                        <th>Origem</th>
                        <th>Nome</th>
                        <th>CPF/CNPJ</th>
                        <th class="text-end">Valor</th>
                        <th>Forma</th>
                        <th>Tipo Pessoa</th>
                        <th>Nome Titular</th>
                        <th>Chave PIX</th>
                        <th>Banco</th>
                        <th>Código</th>
                        <th>Agência</th>
                        <th>Conta</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in dadosPagamentos.Linhas)
                    {
                        <tr>
                            <td>@l.Unidade</td>
                            <td>@l.CompetenciaTexto</td>
                            <td><span class="badge bg-secondary">@l.Origem</span></td>
                            <td>@l.Nome</td>
                            <td>@l.Cpf</td>
                            <td class="text-end fw-semibold">@Moeda(l.Valor)</td>
                            <td>@l.Forma</td>
                            <td>@l.TipoPessoa</td>
                            <td>@l.NomeTitular</td>
                            <td>@l.ChavePix</td>
                            <td>@l.Banco</td>
                            <td>@l.Codigo</td>
                            <td>@l.Agencia</td>
                            <td>@l.Conta</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <th colspan="5" class="text-end">Valor Total</th>
                        <th class="text-end text-success">@Moeda(dadosPagamentos.ValorTotal)</th>
                        <th colspan="8"></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    };
}
