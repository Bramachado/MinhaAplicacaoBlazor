    /// <summary>
    /// Consulta a SERPRO (CPF + Data de Nascimento) para cada colaborador distinto
    /// das linhas geradas e grava SituacaoCpf ("OK"/"DIVERGENTE") comparando o nome
    /// cadastrado com o nome retornado. Roda sequencialmente, com progresso ao vivo.
    /// </summary>
    private async Task AbrirConferenciaAsync()
    {
        var colaboradorIds = linhas.Select(l => l.ColaboradorId).Where(id => id > 0).Distinct().ToList();

        conferenciaAberta = true;
        conferenciaRodando = true;
        conferenciaTotal = colaboradorIds.Count;
        conferenciaProcessados = 0;
        conferenciaOk = 0;
        conferenciaDivergentes = 0;
        conferenciaErros = 0;
        conferenciaLog.Clear();
        conferenciaCts = new CancellationTokenSource();
        StateHasChanged();

        await using var context = await DbFactory.CreateDbContextAsync();

        foreach (var colaboradorId in colaboradorIds)
        {
            if (conferenciaCts.IsCancellationRequested)
                break;

            var colaborador = await context.Colaboradores.FirstOrDefaultAsync(c => c.Id == colaboradorId);
            if (colaborador is null)
            {
                conferenciaErros++;
            }
            else if (string.IsNullOrWhiteSpace(colaborador.Cpf) || colaborador.DataNascimento is not DateTime dataNascimento)
            {
                conferenciaErros++;
                conferenciaLog.Add($"{colaborador.Nome}: sem CPF ou Data de Nascimento cadastrada.");
            }
            else
            {
                var consulta = await SerproService.ConsultarAsync(colaborador.Cpf, dataNascimento, conferenciaCts.Token);
                if (consulta.Sucesso)
                {
                    colaborador.SituacaoCpf = SerproCpfConsultaService.NomesCorrespondem(colaborador.Nome, consulta.Nome)
                        ? SituacaoCpfStatus.OK
                        : SituacaoCpfStatus.DIVERGENTE;
                    await context.SaveChangesAsync();

                    if (colaborador.SituacaoCpf == SituacaoCpfStatus.OK)
                        conferenciaOk++;
                    else
                    {
                        conferenciaDivergentes++;
                        conferenciaLog.Add($"{colaborador.Nome}: DIVERGENTE (SERPRO: \"{consulta.Nome}\").");
                    }
                }
                else
                {
                    conferenciaErros++;
                    conferenciaLog.Add($"{colaborador.Nome}: {consulta.MensagemErro}");
                }
            }

            conferenciaProcessados++;
            StateHasChanged();
        }

        conferenciaRodando = false;
        StateHasChanged();
    }

    private void CancelarConferencia() => conferenciaCts?.Cancel();

    private void FecharConferencia() => conferenciaAberta = false;
}
