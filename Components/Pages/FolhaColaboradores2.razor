@page "/folha-colaboradores-2"
@attribute [Authorize(Policy = "RelatoriosFinanceiros.Ver")]
@rendermode InteractiveServer

@using System.Text
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using MinhaAplicacaoBlazor.Data
@using MinhaAplicacaoBlazor.Models
@using MinhaAplicacaoBlazor.Models.Reports
@using MinhaAplicacaoBlazor.Services

@inject RelatorioFinanceiroService Service
@inject IDbContextFactory<AppDbContext> DbFactory
@inject SerproCpfConsultaService SerproService

<PageTitle>Folha de Colaboradores 2</PageTitle>

<style>
    /* Impede quebra de linha nas células da grade: as colunas expandem conforme
       o conteúdo e a rolagem horizontal aparece para ver as últimas colunas. */
    .grid-fc2 {
        overflow-x: auto;
        max-height: 70vh;
    }

    .grid-fc2 table {
        width: auto;
        min-width: 100%;
    }

    .grid-fc2 th,
    .grid-fc2 td {
        white-space: nowrap;
    }

    /* Cabeçalho fixo ao rolar verticalmente. */
    .grid-fc2 thead th {
        position: sticky;
        top: 0;
        z-index: 1;
    }
</style>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Relatório de Pagamento de Colaboradores</h1>
    </div>

    <div class="card mb-3 d-print-none">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Competência</label>
                    <select class="form-select" @bind="competenciaSelecionadaId">
                        <option value="0">-- Selecione --</option>
                        @foreach (var c in competencias)
                        {
                            <option value="@c.Id">@c.TextoExibicao</option>
                        }
                    </select>
                </div>
                <div class="col-md-9 d-flex flex-wrap gap-2">
                    <button class="btn btn-primary" @onclick="GerarAsync" disabled="@processando">
                        @if (processando) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Gerar Relatório
                    </button>
                    <button class="btn btn-secondary" @onclick="Limpar">Limpar</button>
                    <button class="btn btn-success" @onclick="ExportarExcelAsync" disabled="@(!gerado || QuantidadeSelecionadas == 0)">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-1" style="vertical-align:-2px;">
                            <path d="M5.884 6.68a.5.5 0 1 0-.768.64L7.349 10l-2.233 2.68a.5.5 0 0 0 .768.64L8 10.781l2.116 2.54a.5.5 0 0 0 .768-.641L8.651 10l2.233-2.68a.5.5 0 0 0-.768-.64L8 9.219z"/>
                            <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5z"/>
                        </svg>
                        Exportar Excel (@QuantidadeSelecionadas)
                    </button>
                    <button class="btn btn-info text-white" @onclick="AbrirConferenciaAsync" disabled="@(!gerado || linhas.Count == 0)">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-1" style="vertical-align:-2px;">
                            <path d="M13.485 1.431a1.473 1.473 0 0 1 2.104 2.062l-7.84 9.801a1.473 1.473 0 0 1-2.12.04L.431 8.138a1.473 1.473 0 0 1 2.084-2.083l4.111 4.112 6.82-8.69a.486.486 0 0 1 .04-.045z"/>
                        </svg>
                        Conferência de Dados
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(mensagemErro))
            {
                <div class="alert alert-danger mt-3 mb-0">@mensagemErro</div>
            }
        </div>
    </div>

    @if (!gerado)
    {
        <div class="alert alert-info">Selecione uma competência e clique em <strong>Gerar Relatório</strong>.</div>
    }
    else if (linhas.Count == 0)
    {
        <div class="alert alert-warning">Nenhum item encontrado para esta competência.</div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="text-muted">
                @linhas.Count linha(s) • @QuantidadeSelecionadas selecionada(s) •
                Total (Valor Total): <strong>@Moeda(TotalSelecionado)</strong> •
                Total (Receber PIX): <strong>@Moeda(TotalPixSelecionado)</strong>
            </div>
        </div>

        <div class="table-responsive grid-fc2">
            <table class="table table-striped table-hover table-sm align-middle">
                <thead class="table-dark">
                    <tr>
                        <th style="width:38px;" class="text-center">
                            <input type="checkbox" class="form-check-input" checked="@TodosSelecionados" @onchange="AlternarTodos" title="Selecionar todos" />
                        </th>
                        <th style="width:38px;" class="text-center">Detalhes</th>
                        <th class="text-center">Status</th>
                        @foreach (var col in Colunas)
                        {
                            <th role="button" class="user-select-none @(col.Numerico ? "text-end" : "")" @onclick="() => Ordenar(col.Chave)">
                                @col.Titulo @Seta(col.Chave)
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in linhas)
                    {
                        <tr class="@(l.Selecionado ? "table-active" : "")">
                            <td class="text-center">
                                <input type="checkbox" class="form-check-input" @bind="l.Selecionado" />
                            </td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-primary" title="Visualizar detalhes"
                                        @onclick="() => VisualizarItemAsync(l.ItemId)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                                        <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                                    </svg>
                                </button>
                            </td>
                            <td class="text-center">
                                @if (DadosBancariosConferem(l.Cpf, l.CpfCnpjConta))
                                {
                                    <span class="text-success" title="CPF/CNPJ da conta bancária confere com o cadastro do colaborador.">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                                        </svg>
                                    </span>
                                }
                                else
                                {
                                    <span class="text-warning" title="CPF/CNPJ da conta bancária diverge do CPF cadastrado para este colaborador.">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
                                        </svg>
                                    </span>
                                }
                            </td>
                            <td>@l.Colaborador</td>
                            <td>@l.Cpf</td>
                            <td>@(l.DataNascimento?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td class="text-end fw-semibold">@Moeda(l.ValorTotal)</td>
                            <td class="text-end">@Moeda(l.ValorReceberPix)</td>
                            <td>@l.NomeTitular</td>
                            <td>@l.CpfCnpjConta</td>
                            <td>@l.Forma</td>
                            <td>@l.TipoPessoa</td>
                            <td>@l.TipoChavePix</td>
                            <td>@l.ChavePix</td>
                            <td>@l.CodigoBanco</td>
                            <td>@l.NomeBanco</td>
                            <td>@l.Agencia</td>
                            <td>@l.Conta</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="6" class="text-end fw-bold">Totais selecionados</td>
                        <td class="text-end fw-bold">@Moeda(TotalSelecionado)</td>
                        <td class="text-end fw-bold">@Moeda(TotalPixSelecionado)</td>
                        <td colspan="10"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>

@if (itemDetalhe is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Detalhes do Item — @itemDetalhe.Colaborador?.Nome</h5>
                    <button type="button" class="btn-close" @onclick="FecharDetalhe"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted mb-0">Colaborador</label>
                            <div class="fw-semibold">@itemDetalhe.Colaborador?.Nome</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">CPF</label>
                            <div>@(itemDetalhe.Colaborador?.Cpf ?? "—")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Cargo</label>
                            <div>@(itemDetalhe.Cargo ?? "—")</div>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Carga Horária Semanal</label>
                            <div>@(itemDetalhe.CargaHorariaSemanal?.ToString("0.##") ?? "—")</div>
                        </div>

                        <div class="col-12"><hr class="my-1" /></div>
                        <div class="col-12"><h6 class="mb-0">Proventos</h6></div>

                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Salário Base</label>
                            <div>@itemDetalhe.SalarioBase.ToString("C")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Ticket Alimentação</label>
                            <div>@itemDetalhe.TicketAlimentacao.ToString("C")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Outros Proventos</label>
                            <div>@itemDetalhe.OutrosProventos.ToString("C")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Salário Família</label>
                            <div>@itemDetalhe.SalarioFamilia.ToString("C")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Premiação Fixa</label>
                            <div>@itemDetalhe.PremiacaoFixa.ToString("C")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Premiação Variável</label>
                            <div>@itemDetalhe.PremiacaoVariavel.ToString("C")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">13º Salário</label>
                            <div>@itemDetalhe.DecimoTerceiro.ToString("C")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Férias 1/3</label>
                            <div>@itemDetalhe.FeriasUmTerco.ToString("C")</div>
                        </div>

                        <div class="col-12"><hr class="my-1" /></div>
                        <div class="col-12"><h6 class="mb-0">Faltas e Descontos</h6></div>

                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Valor Hora (calc.)</label>
                            <div>@itemDetalhe.ValorHora.ToString("C")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Horas Falta</label>
                            <div>@itemDetalhe.HorasFalta.ToString("0.##")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Valor Faltas (calc.)</label>
                            <div>@itemDetalhe.ValorFaltas.ToString("C")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Desconto INSS</label>
                            <div>@itemDetalhe.DescontoINSS.ToString("C")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Desconto IR</label>
                            <div>@itemDetalhe.DescontoIR.ToString("C")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Plano de Saúde</label>
                            <div>@itemDetalhe.PlanoSaude.ToString("C")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Vale/Consignado</label>
                            <div>@itemDetalhe.ValeConsignadoFGTS.ToString("C")</div>
                        </div>

                        <div class="col-12"><hr class="my-1" /></div>
                        <div class="col-12"><h6 class="mb-0">Resumo</h6></div>

                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Total de Proventos</label>
                            <div class="fw-semibold text-success">@itemDetalhe.TotalProventos.ToString("C")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Total de Descontos</label>
                            <div class="fw-semibold text-danger">@itemDetalhe.TotalDescontos.ToString("C")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Valor Total</label>
                            <div class="fw-semibold">@itemDetalhe.ValorTotal.ToString("C")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Valor Receber PIX</label>
                            <div class="fw-semibold text-primary">@itemDetalhe.ValorReceberPix.ToString("C")</div>
                        </div>

                        <div class="col-12"><hr class="my-1" /></div>

                        <div class="col-12">
                            <label class="form-label text-muted mb-0">Observação</label>
                            <div style="white-space:pre-wrap;">@(string.IsNullOrWhiteSpace(itemDetalhe.Observacao) ? "—" : itemDetalhe.Observacao)</div>
                        </div>
                    </div>

                    <hr />
                    <h6 class="mb-2">Anexos</h6>
                    <div class="alert alert-info mb-0">Nenhum anexo para este item.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharDetalhe">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (conferenciaAberta)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Conferência de Dados — CPF na SERPRO</h5>
                    @if (!conferenciaRodando)
                    {
                        <button type="button" class="btn-close" @onclick="FecharConferencia"></button>
                    }
                </div>
                <div class="modal-body">
                    <p class="text-muted mb-2">
                        Consultando CPF + Data de Nascimento de cada colaborador na SERPRO e comparando
                        com o nome cadastrado no sistema.
                    </p>

                    <div class="d-flex align-items-center gap-2 mb-2">
                        @if (conferenciaRodando)
                        {
                            <span class="spinner-border spinner-border-sm text-info"></span>
                        }
                        <strong>@conferenciaProcessados / @conferenciaTotal</strong>
                    </div>

                    <div class="progress mb-3" style="height: 22px;">
                        <div class="progress-bar @(conferenciaRodando ? "progress-bar-striped progress-bar-animated" : "bg-success")"
                             role="progressbar" style="width:@ConferenciaPercentual%">
                            @ConferenciaPercentual%
                        </div>
                    </div>

                    <div class="row text-center mb-2">
                        <div class="col-4">
                            <div class="fw-bold text-success">@conferenciaOk</div>
                            <div class="small text-muted">OK</div>
                        </div>
                        <div class="col-4">
                            <div class="fw-bold text-danger">@conferenciaDivergentes</div>
                            <div class="small text-muted">Divergentes</div>
                        </div>
                        <div class="col-4">
                            <div class="fw-bold text-warning">@conferenciaErros</div>
                            <div class="small text-muted">Não verificados</div>
                        </div>
                    </div>

                    @if (conferenciaLog.Count > 0)
                    {
                        <div class="border rounded p-2" style="max-height:160px; overflow-y:auto;">
                            @foreach (var linha in conferenciaLog)
                            {
                                <div class="small">@linha</div>
                            }
                        </div>
                    }

                    @if (!conferenciaRodando)
                    {
                        <div class="alert alert-secondary mt-3 mb-0">
                            Conferência concluída. As situações ficam salvas no cadastro de cada colaborador
                            (campo "Situação CPF").
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    @if (conferenciaRodando)
                    {
                        <button type="button" class="btn btn-outline-danger" @onclick="CancelarConferencia">Cancelar</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-secondary" @onclick="FecharConferencia">Fechar</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CompetenciaSelecaoDto> competencias = new();
    private int competenciaSelecionadaId;
    private bool processando;
    private bool gerado;
    private string? mensagemErro;

    private List<FolhaColaborador2LinhaDto> linhas = new();

    private string? colunaOrdenacao;
    private bool ordemAsc = true;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private FolhaColaboradorItem? itemDetalhe;

    // ---- Conferência de Dados (SERPRO em lote) ----
    private bool conferenciaAberta;
    private bool conferenciaRodando;
    private int conferenciaTotal;
    private int conferenciaProcessados;
    private int conferenciaOk;
    private int conferenciaDivergentes;
    private int conferenciaErros;
    private List<string> conferenciaLog = new();
    private CancellationTokenSource? conferenciaCts;

    private int ConferenciaPercentual => conferenciaTotal == 0 ? 0 : conferenciaProcessados * 100 / conferenciaTotal;

    // Definição das colunas ordenáveis (rótulo, chave de ordenação e alinhamento).
    private sealed record Coluna(string Chave, string Titulo, Func<FolhaColaborador2LinhaDto, object?> Selector, bool Numerico = false);

    private static readonly Coluna[] Colunas =
    {
        new("Colaborador",     "Colaborador",     l => l.Colaborador),
        new("Cpf",             "CPF",             l => l.Cpf),
        new("DataNascimento",  "Dt. Nascimento",  l => l.DataNascimento),
        new("ValorTotal",      "Valor Total",     l => l.ValorTotal, true),
        new("ValorReceberPix", "Receber PIX",     l => l.ValorReceberPix, true),
        new("NomeTitular",     "Nome Titular",    l => l.NomeTitular),
        new("CpfCnpjConta",    "CPF/CNPJ Titular",l => l.CpfCnpjConta),
        new("Forma",           "Forma",           l => l.Forma),
        new("TipoPessoa",      "Tipo Pessoa",     l => l.TipoPessoa),
        new("TipoChavePix",    "Tipo Chave PIX",  l => l.TipoChavePix),
        new("ChavePix",        "Chave PIX",       l => l.ChavePix),
        new("CodigoBanco",     "Cód. Banco",      l => l.CodigoBanco),
        new("NomeBanco",       "Nome Banco",      l => l.NomeBanco),
        new("Agencia",         "Agência",         l => l.Agencia),
        new("Conta",           "Conta",           l => l.Conta),
    };

    private int QuantidadeSelecionadas => linhas.Count(l => l.Selecionado);
    private decimal TotalSelecionado => linhas.Where(l => l.Selecionado).Sum(l => l.ValorTotal);
    private decimal TotalPixSelecionado => linhas.Where(l => l.Selecionado).Sum(l => l.ValorReceberPix);
    private bool TodosSelecionados => linhas.Count > 0 && linhas.All(l => l.Selecionado);

    protected override async Task OnInitializedAsync()
    {
        competencias = await Service.ObterCompetenciasAsync();
        var atual = competencias.FirstOrDefault(c =>
            c.Mes == DateTime.Today.Month && c.Ano == DateTime.Today.Year);
        if (atual is not null)
            competenciaSelecionadaId = atual.Id;
    }

    private async Task GerarAsync()
    {
        mensagemErro = null;
        if (competenciaSelecionadaId == 0)
        {
            mensagemErro = "Selecione uma competência para gerar o relatório.";
            gerado = false;
            return;
        }

        processando = true;
        try
        {
            linhas = await Service.GerarFolhaColaborador2Async(competenciaSelecionadaId);
            colunaOrdenacao = null;
            ordemAsc = true;
            gerado = true;
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro ao gerar relatório: {ex.Message}";
            gerado = false;
        }
        finally
        {
            processando = false;
        }
    }

    private void Limpar()
    {
        linhas = new();
        gerado = false;
        mensagemErro = null;
        colunaOrdenacao = null;
        ordemAsc = true;
    }

    private void Ordenar(string chave)
    {
        var col = Colunas.FirstOrDefault(c => c.Chave == chave);
        if (col is null) return;

        if (colunaOrdenacao == chave)
            ordemAsc = !ordemAsc;
        else
        {
            colunaOrdenacao = chave;
            ordemAsc = true;
        }

        linhas = (ordemAsc
            ? linhas.OrderBy(col.Selector)
            : linhas.OrderByDescending(col.Selector)).ToList();
    }

    private MarkupString Seta(string chave)
    {
        if (colunaOrdenacao != chave) return (MarkupString)"";
        return (MarkupString)(ordemAsc ? " &#9650;" : " &#9660;");
    }

    private void AlternarTodos(ChangeEventArgs e)
    {
        var marcar = e.Value is bool b && b;
        foreach (var l in linhas)
            l.Selecionado = marcar;
    }

    private async Task ExportarExcelAsync()
    {
        var selecionadas = linhas.Where(l => l.Selecionado).ToList();
        if (selecionadas.Count == 0) return;

        var ptBr = CultureInfo.GetCultureInfo("pt-BR");

        // Colunas: título, valor por linha, texto (preserva zeros à esquerda) e numérico.
        var colunas = new (string Titulo, Func<FolhaColaborador2LinhaDto, string> Valor, bool Texto, bool Numero)[]
        {
            ("Colaborador",     l => l.Colaborador,                          false, false),
            ("CPF",             l => l.Cpf ?? "",                            true,  false),
            ("Dt. Nascimento",  l => l.DataNascimento?.ToString("dd/MM/yyyy") ?? "", false, false),
            ("Valor Total",     l => l.ValorTotal.ToString("N2", ptBr),      false, true),
            ("Receber PIX",     l => l.ValorReceberPix.ToString("N2", ptBr), false, true),
            ("Nome Titular",    l => l.NomeTitular ?? "",                     false, false),
            ("CPF/CNPJ Titular",l => l.CpfCnpjConta ?? "",                    true,  false),
            ("Forma",           l => l.Forma ?? "",                          false, false),
            ("Tipo Pessoa",     l => l.TipoPessoa ?? "",                      false, false),
            ("Tipo Chave PIX",  l => l.TipoChavePix ?? "",                    false, false),
            ("Chave PIX",       l => l.ChavePix ?? "",                        true,  false),
            ("Cód. Banco",      l => l.CodigoBanco ?? "",                     true,  false),
            ("Nome Banco",      l => l.NomeBanco ?? "",                       false, false),
            ("Agência",         l => l.Agencia ?? "",                         true,  false),
            ("Conta",           l => l.Conta ?? "",                          false, false),
        };

        // Largura de cada coluna conforme o maior conteúdo (para não quebrar a linha).
        var larguras = new int[colunas.Length];
        for (int c = 0; c < colunas.Length; c++)
        {
            var max = colunas[c].Titulo.Length;
            foreach (var l in selecionadas)
                max = Math.Max(max, colunas[c].Valor(l).Length);
            larguras[c] = Math.Clamp(max * 8 + 16, 70, 420);
        }

        var totalValor = selecionadas.Sum(l => l.ValorTotal);
        var totalPix = selecionadas.Sum(l => l.ValorReceberPix);
        var competenciaTexto = competencias.FirstOrDefault(c => c.Id == competenciaSelecionadaId)?.TextoExibicao ?? "";

        var sb = new StringBuilder();
        sb.Append("<html xmlns:x=\"urn:schemas-microsoft-com:office:excel\"><head><meta charset=\"utf-8\" />");
        sb.Append("<style>");
        sb.Append("table{border-collapse:collapse;}");
        sb.Append("td,th{border:1px solid #b7b7b7;padding:3px 8px;white-space:nowrap;vertical-align:middle;height:22px;font-family:Calibri,Arial,sans-serif;font-size:11pt;}");
        sb.Append("th{background:#305496;color:#ffffff;text-align:left;font-weight:bold;}");
        sb.Append(".titulo{border:none;font-size:16pt;font-weight:bold;color:#1F3864;}");
        sb.Append(".sub{border:none;color:#555555;}");
        sb.Append(".txt{mso-number-format:'\\@';}");
        sb.Append(".num{mso-number-format:'#,##0.00';text-align:right;}");
        sb.Append(".tot{background:#D9E1F2;font-weight:bold;}");
        sb.Append("</style></head><body><table>");

        sb.Append("<colgroup>");
        for (int c = 0; c < colunas.Length; c++)
            sb.Append($"<col style=\"width:{larguras[c]}px;\" />");
        sb.Append("</colgroup>");

        sb.Append($"<tr><td colspan=\"{colunas.Length}\" class=\"titulo\">Folha de Colaboradores 2</td></tr>");
        sb.Append($"<tr><td colspan=\"{colunas.Length}\" class=\"sub\">Competência: {Esc(competenciaTexto)}</td></tr>");
        sb.Append($"<tr><td colspan=\"{colunas.Length}\" style=\"border:none;height:6px;\"></td></tr>");

        sb.Append("<tr>");
        foreach (var col in colunas)
            sb.Append($"<th>{Esc(col.Titulo)}</th>");
        sb.Append("</tr>");

        foreach (var l in selecionadas)
        {
            sb.Append("<tr>");
            foreach (var col in colunas)
            {
                var cls = col.Texto ? " class=\"txt\"" : col.Numero ? " class=\"num\"" : "";
                sb.Append($"<td{cls}>{Esc(col.Valor(l))}</td>");
            }
            sb.Append("</tr>");
        }

        sb.Append("<tr>");
        sb.Append("<td colspan=\"2\" class=\"tot\" style=\"text-align:right;\">Totais</td>");
        sb.Append($"<td class=\"tot num\">{totalValor.ToString("N2", ptBr)}</td>");
        sb.Append($"<td class=\"tot num\">{totalPix.ToString("N2", ptBr)}</td>");
        sb.Append($"<td colspan=\"{colunas.Length - 4}\" class=\"tot\"></td>");
        sb.Append("</tr>");

        sb.Append("</table></body></html>");

        var base64 = Convert.ToBase64String(Encoding.UTF8.GetBytes(sb.ToString()));
        var nome = $"Folha_Colaboradores_2_{competenciaTexto.Replace('/', '-').Replace(' ', '_')}.xls";
        await JS.InvokeVoidAsync("baixarArquivoBase64", nome, base64, "application/vnd.ms-excel");
    }

    private static string Esc(string? s) =>
        string.IsNullOrEmpty(s) ? "" : System.Net.WebUtility.HtmlEncode(s);

    /// <summary>Compara CPF/CNPJ (só dígitos) do colaborador com o titular da conta bancária vinculada.</summary>
    private static bool DadosBancariosConferem(string? cpfPessoa, string? cpfCnpjConta)
    {
        var pessoa = ApenasDigitos(cpfPessoa);
        var conta = ApenasDigitos(cpfCnpjConta);
        return pessoa.Length > 0 && pessoa == conta;
    }

    private static string ApenasDigitos(string? valor) =>
        valor is null ? "" : new string(valor.Where(char.IsDigit).ToArray());

    private static string Moeda(decimal v) => v.ToString("C", CultureInfo.GetCultureInfo("pt-BR"));

