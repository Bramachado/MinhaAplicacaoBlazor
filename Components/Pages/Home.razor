@page "/"
@attribute [Authorize]
@rendermode InteractiveServer

@using System.Globalization
@using ApexCharts
@using MinhaAplicacaoBlazor.Models
@using MinhaAplicacaoBlazor.Models.Reports
@using MinhaAplicacaoBlazor.Services

@inject DashboardService Service
@inject IAuthorizationService AuthorizationService

<PageTitle>Painel Financeiro</PageTitle>

<div class="container-fluid mt-4">

    <AuthorizeView Policy="RelatoriosFinanceiros.Ver">
        <Authorized>

            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <h1 class="mb-0">Painel Financeiro</h1>
                <div class="d-flex gap-2 align-items-end flex-wrap">
                    <div>
                        <label class="form-label mb-1 small text-muted">Competência</label>
                        <select class="form-select form-select-sm" @bind="competenciaId" @bind:after="RecarregarAsync">
                            @foreach (var c in competencias)
                            {
                                <option value="@c.Id">@c.TextoExibicao</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label mb-1 small text-muted">Unidade</label>
                        <select class="form-select form-select-sm" @bind="unidadeIdSelecionada" @bind:after="RecarregarAsync">
                            <option value="0">Todas as unidades</option>
                            @foreach (var u in unidades)
                            {
                                <option value="@u.Id">@u.Nome</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            @if (carregando)
            {
                <div class="text-center text-muted py-5">
                    <div class="spinner-border" role="status"></div>
                    <p class="mt-2">Carregando indicadores...</p>
                </div>
            }
            else if (dados is null || competencias.Count == 0)
            {
                <div class="alert alert-info">
                    Nenhuma competência cadastrada. Cadastre competências e lançamentos para ver o painel.
                </div>
            }
            else
            {
                <!-- ===== KPIs ===== -->
                <div class="row g-3 mb-3">
                    <div class="col-sm-6 col-xl-3">
                        <div class="card border-start border-4 border-success h-100">
                            <div class="card-body">
                                <div class="text-muted small text-uppercase">Receitas</div>
                                <div class="fs-4 fw-bold">@Moeda(dados.TotalReceitas)</div>
                                @Tendencia(dados.TotalReceitas, dados.ReceitasAnterior, true)
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl-3">
                        <div class="card border-start border-4 border-danger h-100">
                            <div class="card-body">
                                <div class="text-muted small text-uppercase">Despesas</div>
                                <div class="fs-4 fw-bold">@Moeda(dados.TotalDespesas)</div>
                                @Tendencia(dados.TotalDespesas, dados.DespesasAnterior, false)
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl-3">
                        <div class="card border-start border-4 @(dados.Saldo >= 0 ? "border-primary" : "border-warning") h-100">
                            <div class="card-body">
                                <div class="text-muted small text-uppercase">Saldo</div>
                                <div class="fs-4 fw-bold @(dados.Saldo >= 0 ? "text-primary" : "text-danger")">@Moeda(dados.Saldo)</div>
                                <div class="small text-muted">Margem: @dados.MargemPercentual.ToString("0.0", Cultura)%</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl-3">
                        <div class="card border-start border-4 border-secondary h-100">
                            <div class="card-body">
                                <div class="text-muted small text-uppercase">A Pagar (Fornecedores)</div>
                                <div class="fs-4 fw-bold">@Moeda(dados.TotalAPagar)</div>
                                <div class="small @(dados.TotalVencido > 0 ? "text-danger fw-semibold" : "text-muted")">
                                    Vencido: @Moeda(dados.TotalVencido) · @dados.QtdeContasAPagar conta(s)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ===== Linha 1: Resultado por unidade + Evolução ===== -->
                <div class="row g-3 mb-3">
                    <div class="col-xl-7">
                        <div class="card h-100">
                            <div class="card-header fw-semibold">Resultado por Unidade</div>
                            <div class="card-body">
                                @if (dados.PorUnidade.Count == 0)
                                {
                                    <p class="text-muted mb-0">Sem dados no período.</p>
                                }
                                else
                                {
                                    <ApexChart TItem="DashboardUnidadeLinhaDto" Options="opcoesBarra" Height="320" @key="@($"un-{chaveDados}")">
                                        <ApexPointSeries TItem="DashboardUnidadeLinhaDto" Items="dados.PorUnidade"
                                            Name="Receitas" SeriesType="SeriesType.Bar"
                                            XValue="@(e => e.Unidade)" YValue="@(e => e.Receitas)" />
                                        <ApexPointSeries TItem="DashboardUnidadeLinhaDto" Items="dados.PorUnidade"
                                            Name="Despesas" SeriesType="SeriesType.Bar"
                                            XValue="@(e => e.Unidade)" YValue="@(e => e.Despesas)" />
                                        <ApexPointSeries TItem="DashboardUnidadeLinhaDto" Items="dados.PorUnidade"
                                            Name="Saldo" SeriesType="SeriesType.Bar"
                                            XValue="@(e => e.Unidade)" YValue="@(e => e.Saldo)" />
                                    </ApexChart>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-5">
                        <div class="card h-100">
                            <div class="card-header fw-semibold">Evolução (últimas competências)</div>
                            <div class="card-body">
                                @if (dados.Evolucao.Count == 0)
                                {
                                    <p class="text-muted mb-0">Sem histórico.</p>
                                }
                                else
                                {
                                    <ApexChart TItem="DashboardEvolucaoPontoDto" Options="opcoesLinha" Height="320" @key="@($"ev-{chaveDados}")">
                                        <ApexPointSeries TItem="DashboardEvolucaoPontoDto" Items="dados.Evolucao"
                                            Name="Receitas" SeriesType="SeriesType.Line"
                                            XValue="@(e => e.Rotulo)" YValue="@(e => e.Receitas)" />
                                        <ApexPointSeries TItem="DashboardEvolucaoPontoDto" Items="dados.Evolucao"
                                            Name="Despesas" SeriesType="SeriesType.Line"
                                            XValue="@(e => e.Rotulo)" YValue="@(e => e.Despesas)" />
                                        <ApexPointSeries TItem="DashboardEvolucaoPontoDto" Items="dados.Evolucao"
                                            Name="Saldo" SeriesType="SeriesType.Line"
                                            XValue="@(e => e.Rotulo)" YValue="@(e => e.Saldo)" />
                                    </ApexChart>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ===== Linha 2: Composição + Plano de contas ===== -->
                <div class="row g-3 mb-3">
                    <div class="col-xl-5">
                        <div class="card h-100">
                            <div class="card-header fw-semibold">Composição das Despesas</div>
                            <div class="card-body">
                                @if (composicao.Sum(c => c.Total) == 0)
                                {
                                    <p class="text-muted mb-0">Sem despesas no período.</p>
                                }
                                else
                                {
                                    <ApexChart TItem="DashboardPlanoContaLinhaDto" Options="opcoesDonut" Height="300" @key="@($"co-{chaveDados}")">
                                        <ApexPointSeries TItem="DashboardPlanoContaLinhaDto" Items="composicao"
                                            Name="Despesas" SeriesType="SeriesType.Donut"
                                            XValue="@(e => e.PlanoConta)" YValue="@(e => e.Total)" />
                                    </ApexChart>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-7">
                        <div class="card h-100">
                            <div class="card-header fw-semibold">Despesas por Plano de Contas (Fornecedores)</div>
                            <div class="card-body">
                                @if (dados.PorPlanoConta.Count == 0)
                                {
                                    <p class="text-muted mb-0">Nenhuma despesa de fornecedor classificada por plano de contas.</p>
                                }
                                else
                                {
                                    <ApexChart TItem="DashboardPlanoContaLinhaDto" Options="opcoesBarraH" Height="300" @key="@($"pc-{chaveDados}")">
                                        <ApexPointSeries TItem="DashboardPlanoContaLinhaDto" Items="dados.PorPlanoConta"
                                            Name="Total" SeriesType="SeriesType.Bar"
                                            XValue="@(e => e.PlanoConta)" YValue="@(e => e.Total)" />
                                    </ApexChart>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ===== Linha 3: Ranking + Vencimentos ===== -->
                <div class="row g-3">
                    <div class="col-xl-7">
                        <div class="card h-100">
                            <div class="card-header fw-semibold">Ranking de Unidades</div>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0 align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Unidade</th>
                                            <th class="text-end">Receitas</th>
                                            <th class="text-end">Despesas</th>
                                            <th class="text-end">Saldo</th>
                                            <th class="text-end">Margem</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var u in dados.PorUnidade)
                                        {
                                            <tr>
                                                <td>@u.Unidade</td>
                                                <td class="text-end text-success">@Moeda(u.Receitas)</td>
                                                <td class="text-end text-danger">@Moeda(u.Despesas)</td>
                                                <td class="text-end fw-semibold @(u.Saldo >= 0 ? "text-primary" : "text-danger")">@Moeda(u.Saldo)</td>
                                                <td class="text-end">@u.MargemPercentual.ToString("0.0", Cultura)%</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="table-light fw-semibold">
                                        <tr>
                                            <td>Total</td>
                                            <td class="text-end">@Moeda(dados.TotalReceitas)</td>
                                            <td class="text-end">@Moeda(dados.TotalDespesas)</td>
                                            <td class="text-end @(dados.Saldo >= 0 ? "text-primary" : "text-danger")">@Moeda(dados.Saldo)</td>
                                            <td class="text-end">@dados.MargemPercentual.ToString("0.0", Cultura)%</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-5">
                        <div class="card h-100">
                            <div class="card-header fw-semibold">Próximos Vencimentos</div>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0 align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Venc.</th>
                                            <th>Fornecedor</th>
                                            <th class="text-end">Valor</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (dados.ProximosVencimentos.Count == 0)
                                        {
                                            <tr><td colspan="3" class="text-muted text-center py-3">Nenhuma conta em aberto.</td></tr>
                                        }
                                        else
                                        {
                                            @foreach (var v in dados.ProximosVencimentos)
                                            {
                                                <tr class="@(v.Vencido ? "table-danger" : "")">
                                                    <td>@(v.DataVencimento?.ToString("dd/MM/yy") ?? "—")</td>
                                                    <td>
                                                        @v.Fornecedor
                                                        @if (!string.IsNullOrWhiteSpace(v.Unidade))
                                                        {
                                                            <span class="text-muted small d-block">@v.Unidade</span>
                                                        }
                                                    </td>
                                                    <td class="text-end">@Moeda(v.Valor)</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </Authorized>
        <NotAuthorized>
            <div class="text-center py-5">
                <h1>Bem-vindo!</h1>
                <p class="text-muted">Você não tem permissão para visualizar o painel financeiro.</p>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private static readonly CultureInfo Cultura = CultureInfo.GetCultureInfo("pt-BR");

    private List<CompetenciaSelecaoDto> competencias = new();
    private List<Unidade> unidades = new();
    private int competenciaId;
    private int unidadeIdSelecionada;   // 0 = todas
    private bool carregando = true;
    private bool inicializado;

    private DashboardDto? dados;
    private List<DashboardPlanoContaLinhaDto> composicao = new();
    private string chaveDados = "";

    private ApexChartOptions<DashboardUnidadeLinhaDto> opcoesBarra = new();
    private ApexChartOptions<DashboardEvolucaoPontoDto> opcoesLinha = new();
    private ApexChartOptions<DashboardPlanoContaLinhaDto> opcoesDonut = new();
    private ApexChartOptions<DashboardPlanoContaLinhaDto> opcoesBarraH = new();

    protected override void OnInitialized()
    {
        ConfigurarOpcoes();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || inicializado)
            return;

        inicializado = true;

        // Só carrega dados financeiros se o usuário tiver a permissão.
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            var autorizado = (await AuthorizationService.AuthorizeAsync(user, "RelatoriosFinanceiros.Ver")).Succeeded;
            if (!autorizado)
            {
                carregando = false;
                StateHasChanged();
                return;
            }
        }

        competencias = await Service.ObterCompetenciasAsync();
        unidades = await Service.ObterUnidadesAsync();
        competenciaId = competencias.FirstOrDefault()?.Id ?? 0;

        await RecarregarAsync();
    }

    private async Task RecarregarAsync()
    {
        if (competenciaId == 0)
        {
            carregando = false;
            dados = null;
            StateHasChanged();
            return;
        }

        carregando = true;
        StateHasChanged();

        int? unidade = unidadeIdSelecionada == 0 ? null : unidadeIdSelecionada;
        dados = await Service.ObterDashboardAsync(competenciaId, unidade);

        composicao = new()
        {
            new() { PlanoConta = "Colaboradores", Total = dados.DespesaColaboradores },
            new() { PlanoConta = "Tutores", Total = dados.DespesaTutores },
            new() { PlanoConta = "Fornecedores", Total = dados.DespesaFornecedores },
        };
        composicao.RemoveAll(c => c.Total <= 0);

        chaveDados = $"{competenciaId}-{unidadeIdSelecionada}";
        carregando = false;
        StateHasChanged();
    }

    private void ConfigurarOpcoes()
    {
        var moedaFormatter = @"function (val) { if (val == null) return ''; return 'R$ ' + Number(val).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }";

        opcoesBarra = new ApexChartOptions<DashboardUnidadeLinhaDto>
        {
            Colors = new() { "#198754", "#dc3545", "#0d6efd" },
            Legend = new Legend { Position = LegendPosition.Top },
            Yaxis = new() { new YAxis { Labels = new YAxisLabels { Formatter = moedaFormatter } } },
            Tooltip = new Tooltip { Y = new TooltipY { Formatter = moedaFormatter } }
        };

        opcoesLinha = new ApexChartOptions<DashboardEvolucaoPontoDto>
        {
            Colors = new() { "#198754", "#dc3545", "#0d6efd" },
            Legend = new Legend { Position = LegendPosition.Top },
            Stroke = new Stroke { Curve = Curve.Smooth, Width = 3 },
            Yaxis = new() { new YAxis { Labels = new YAxisLabels { Formatter = moedaFormatter } } },
            Tooltip = new Tooltip { Y = new TooltipY { Formatter = moedaFormatter } }
        };

        opcoesDonut = new ApexChartOptions<DashboardPlanoContaLinhaDto>
        {
            Colors = new() { "#0d6efd", "#6610f2", "#fd7e14" },
            Legend = new Legend { Position = LegendPosition.Bottom },
            Tooltip = new Tooltip { Y = new TooltipY { Formatter = moedaFormatter } }
        };

        opcoesBarraH = new ApexChartOptions<DashboardPlanoContaLinhaDto>
        {
            Colors = new() { "#0d6efd" },
            PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { Horizontal = true } },
            Legend = new Legend { Show = false },
            Xaxis = new XAxis { Labels = new XAxisLabels { Formatter = moedaFormatter } },
            Tooltip = new Tooltip { Y = new TooltipY { Formatter = moedaFormatter } }
        };
    }

    private string Moeda(decimal valor) => valor.ToString("C2", Cultura);

    private RenderFragment Tendencia(decimal atual, decimal? anterior, bool maiorEhMelhor) => builder =>
    {
        if (anterior is null || anterior == 0)
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "small text-muted");
            builder.AddContent(2, "Sem base anterior");
            builder.CloseElement();
            return;
        }

        var variacao = (atual - anterior.Value) / Math.Abs(anterior.Value) * 100;
        var subiu = variacao >= 0;
        var bom = maiorEhMelhor ? subiu : !subiu;
        var cor = bom ? "text-success" : "text-danger";
        var seta = subiu ? "▲" : "▼";

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", $"small {cor}");
        builder.AddContent(2, $"{seta} {Math.Abs(variacao).ToString("0.0", Cultura)}% vs. anterior");
        builder.CloseElement();
    };
}
