@page "/bancos/novo"
@attribute [Authorize(Policy = "Bancos.Ver")]
@page "/bancos/editar/{Id:int}"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using MinhaAplicacaoBlazor.Data
@using MinhaAplicacaoBlazor.Models

@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>@(IsNovo ? "Novo Banco" : "Editar Banco")</PageTitle>

<div class="container mt-4">
    <div class="card">
        <div class="card-header">
            <h3 class="mb-0">@(IsNovo ? "Novo Banco" : "Editar Banco")</h3>
        </div>
        <div class="card-body">
            @if (carregando)
            {
                <p>Carregando...</p>
            }
            else
            {
                <EditForm Model="banco" OnValidSubmit="SalvarAsync" FormName="form-banco">
                    <DataAnnotationsValidator />

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Nome do Banco <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="banco.NomeBanco" />
                            <ValidationMessage For="@(() => banco.NomeBanco)" class="text-danger small" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Descrição</label>
                            <InputText class="form-control" @bind-Value="banco.Descricao" />
                            <ValidationMessage For="@(() => banco.Descricao)" class="text-danger small" />
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(mensagemErro))
                    {
                        <div class="alert alert-danger">@mensagemErro</div>
                    }

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Salvar</button>
                        <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private Banco banco = new();
    private bool carregando = true;
    private string? mensagemErro;

    private bool IsNovo => Id is null or 0;

    protected override async Task OnInitializedAsync()
    {
        if (!IsNovo)
        {
            await using var context = await DbFactory.CreateDbContextAsync();

            var existente = await context.Bancos
                .AsNoTracking()
                .FirstOrDefaultAsync(b => b.Id == Id);

            if (existente is null)
            {
                Navigation.NavigateTo("/bancos");
                return;
            }

            banco = existente;
        }

        carregando = false;
    }

    private async Task SalvarAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        var jaExiste = await context.Bancos
            .AsNoTracking()
            .AnyAsync(b => b.NomeBanco == banco.NomeBanco && b.Id != banco.Id);

        if (jaExiste)
        {
            mensagemErro = "Já existe um banco com este nome.";
            return;
        }

        mensagemErro = null;

        if (IsNovo)
            context.Bancos.Add(banco);
        else
            context.Bancos.Update(banco);

        await context.SaveChangesAsync();

        Navigation.NavigateTo("/bancos");
    }

    private void Cancelar() => Navigation.NavigateTo("/bancos");
}
