@page "/folha-tutores-2"
@attribute [Authorize(Policy = "RelatoriosFinanceiros.Ver")]
@rendermode InteractiveServer

@using System.IO.Compression
@using System.Text
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using MinhaAplicacaoBlazor.CnabBtg
@using MinhaAplicacaoBlazor.CnabBtg.Audit
@using MinhaAplicacaoBlazor.CnabBtg.Data
@using MinhaAplicacaoBlazor.CnabBtg.Generation
@using MinhaAplicacaoBlazor.CnabBtg.Payments
@using MinhaAplicacaoBlazor.Data
@using MinhaAplicacaoBlazor.Models
@using MinhaAplicacaoBlazor.Models.Reports
@using MinhaAplicacaoBlazor.Services

@inject RelatorioFinanceiroService Service
@inject IDbContextFactory<AppDbContext> DbFactory
@inject SerproCpfConsultaService SerproService
@inject CnabBtgGeracaoService CnabService
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Folha de Tutores 2</PageTitle>

<style>
    /* Impede quebra de linha nas células da grade: as colunas expandem conforme
       o conteúdo e a rolagem horizontal aparece para ver as últimas colunas. */
    .grid-ft2 {
        overflow-x: auto;
        max-height: 70vh;
    }

    .grid-ft2 table {
        width: auto;
        min-width: 100%;
    }

    .grid-ft2 th,
    .grid-ft2 td {
        white-space: nowrap;
    }

    /* Cabeçalho fixo ao rolar verticalmente. */
    .grid-ft2 thead th {
        position: sticky;
        top: 0;
        z-index: 1;
    }
</style>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Relatório de Pagamento de Tutores</h1>
    </div>

    <div class="card mb-3 d-print-none">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Competência</label>
                    <select class="form-select" @bind="competenciaSelecionadaId">
                        <option value="0">-- Selecione --</option>
                        @foreach (var c in competencias)
                        {
                            <option value="@c.Id">@c.TextoExibicao</option>
                        }
                    </select>
                </div>
                <div class="col-md-9 d-flex flex-wrap gap-2">
                    <button class="btn btn-primary" @onclick="GerarAsync" disabled="@processando">
                        @if (processando) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Gerar Relatório
                    </button>
                    <button class="btn btn-secondary" @onclick="Limpar">Limpar</button>
                    <div class="dropdown">
                        <button class="btn btn-success dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" disabled="@(!gerado || QuantidadeSelecionadas == 0)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-1" style="vertical-align:-2px;">
                                <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
                                <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708z"/>
                            </svg>
                            Exportar
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <button class="dropdown-item" type="button" @onclick="ExportarExcelAsync" disabled="@(!gerado || QuantidadeSelecionadas == 0)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-1" style="vertical-align:-2px;">
                                        <path d="M5.884 6.68a.5.5 0 1 0-.768.64L7.349 10l-2.233 2.68a.5.5 0 0 0 .768.64L8 10.781l2.116 2.54a.5.5 0 0 0 .768-.641L8.651 10l2.233-2.68a.5.5 0 0 0-.768-.64L8 9.219z"/>
                                        <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5z"/>
                                    </svg>
                                    Excel (@QuantidadeSelecionadas)
                                </button>
                            </li>
                            <li>
                                <button class="dropdown-item" type="button" @onclick="AbrirCnabExport" disabled="@(!gerado || QuantidadeSelecionadas == 0)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-1" style="vertical-align:-2px;">
                                        <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5zm-3-.5A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5z"/>
                                        <path d="M4.5 8.5a.5.5 0 0 1 .5-.5h6a.5.5 0 0 1 0 1H5a.5.5 0 0 1-.5-.5m0 2a.5.5 0 0 1 .5-.5h6a.5.5 0 0 1 0 1H5a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1H5a.5.5 0 0 1-.5-.5"/>
                                    </svg>
                                    CNAB (@QuantidadeSelecionadas)
                                </button>
                            </li>
                        </ul>
                    </div>
                    <button class="btn btn-info text-white" @onclick="AbrirConferenciaAsync" disabled="@(!gerado || linhas.Count == 0)">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-1" style="vertical-align:-2px;">
                            <path d="M13.485 1.431a1.473 1.473 0 0 1 2.104 2.062l-7.84 9.801a1.473 1.473 0 0 1-2.12.04L.431 8.138a1.473 1.473 0 0 1 2.084-2.083l4.111 4.112 6.82-8.69a.486.486 0 0 1 .04-.045z"/>
                        </svg>
                        Conferência de Dados
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(mensagemErro))
            {
                <div class="alert alert-danger mt-3 mb-0">@mensagemErro</div>
            }
        </div>
    </div>

    @if (!gerado)
    {
        <div class="alert alert-info">Selecione uma competência e clique em <strong>Gerar Relatório</strong>.</div>
    }
    else if (linhas.Count == 0)
    {
        <div class="alert alert-warning">Nenhum item encontrado para esta competência.</div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="text-muted">
                @linhas.Count linha(s) • @QuantidadeSelecionadas selecionada(s) •
                Total selecionado: <strong>@Moeda(TotalSelecionado)</strong>
            </div>
        </div>

        <div class="table-responsive grid-ft2">
            <table class="table table-striped table-hover table-sm align-middle">
                <thead class="table-dark">
                    <tr>
                        <th style="width:38px;" class="text-center">
                            <input type="checkbox" class="form-check-input" checked="@TodosSelecionados" @onchange="AlternarTodos" title="Selecionar todos" />
                        </th>
                        <th style="width:38px;" class="text-center">Detalhes</th>
                        <th class="text-center">Status</th>
                        @foreach (var col in Colunas)
                        {
                            <th role="button" class="user-select-none @(col.Numerico ? "text-end" : "")" @onclick="() => Ordenar(col.Chave)">
                                @col.Titulo @Seta(col.Chave)
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in linhas)
                    {
                        <tr class="@(l.Selecionado ? "table-active" : "")">
                            <td class="text-center">
                                <input type="checkbox" class="form-check-input" @bind="l.Selecionado" />
                            </td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-primary" title="Visualizar detalhes"
                                        @onclick="() => VisualizarItemAsync(l.ItemId)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                                        <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                                    </svg>
                                </button>
                            </td>
                            <td class="text-center">
                                @if (DadosBancariosConferem(l.Cpf, l.CpfCnpjConta))
                                {
                                    <span class="text-success" title="CPF/CNPJ da conta bancária confere com o cadastro do tutor.">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                                        </svg>
                                    </span>
                                }
                                else
                                {
                                    <span class="text-warning" title="CPF/CNPJ da conta bancária diverge do CPF cadastrado para este tutor.">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
                                        </svg>
                                    </span>
                                }
                            </td>
                            <td>@l.Tutor</td>
                            <td>@l.Cpf</td>
                            <td>@(l.DataNascimento?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td class="text-end fw-semibold">@Moeda(l.ValorTotalReceber)</td>
                            <td>@l.Unidade</td>
                            <td>@l.NomeTitular</td>
                            <td>@l.CpfCnpjConta</td>
                            <td>@l.Forma</td>
                            <td>@l.TipoPessoa</td>
                            <td>@l.TipoChavePix</td>
                            <td>@l.ChavePix</td>
                            <td>@l.CodigoBanco</td>
                            <td>@l.NomeBanco</td>
                            <td>@l.Agencia</td>
                            <td>@l.Conta</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="6" class="text-end fw-bold">Total selecionado</td>
                        <td class="text-end fw-bold">@Moeda(TotalSelecionado)</td>
                        <td colspan="11"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>

@if (itemDetalhe is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Detalhes do Item — @itemDetalhe.Tutor?.Nome</h5>
                    <button type="button" class="btn-close" @onclick="FecharDetalhe"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted mb-0">Tutor</label>
                            <div class="fw-semibold">@itemDetalhe.Tutor?.Nome</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">CPF</label>
                            <div>@(itemDetalhe.Tutor?.Cpf ?? "—")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Status Pagamento</label>
                            <div>@(itemDetalhe.StatusPagamento ?? "—")</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label text-muted mb-0">Cargo</label>
                            <div>@(itemDetalhe.Cargo ?? "—")</div>
                        </div>

                        <div class="col-12"><hr class="my-1" /></div>
                        <div class="col-12"><h6 class="mb-0">Aulas</h6></div>

                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Total Horas Normais</label>
                            <div>@itemDetalhe.TotalHorasNormais.ToString("0.##")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Valor Hora Normal</label>
                            <div>@itemDetalhe.ValorHoraNormal.ToString("C")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Total Horas Práticas</label>
                            <div>@itemDetalhe.TotalHorasPraticas.ToString("0.##")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Valor Hora Prática</label>
                            <div>@itemDetalhe.ValorHoraPratica.ToString("C")</div>
                        </div>

                        <div class="col-12"><hr class="my-1" /></div>
                        <div class="col-12"><h6 class="mb-0">Resumo</h6></div>

                        <div class="col-md-4">
                            <label class="form-label text-muted mb-0">Valor Aulas Normais</label>
                            <div>@itemDetalhe.ValorAulaNormal.ToString("C")</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted mb-0">Valor Aulas Práticas</label>
                            <div>@itemDetalhe.ValorAulaPratica.ToString("C")</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted mb-0">Valor Total a Receber</label>
                            <div class="fw-semibold text-primary">@itemDetalhe.ValorTotalReceber.ToString("C")</div>
                        </div>

                        <div class="col-12"><hr class="my-1" /></div>
                        <div class="col-12"><h6 class="mb-0">Dados Bancários</h6></div>

                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Banco</label>
                            <div>@(itemDetalhe.Banco ?? "—")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Agência</label>
                            <div>@(itemDetalhe.Agencia ?? "—")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Conta</label>
                            <div>@(itemDetalhe.Conta ?? "—")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Chave PIX</label>
                            <div>@(itemDetalhe.ChavePix ?? "—")</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted mb-0">Nome do Titular da Conta</label>
                            <div>@(itemDetalhe.NomeTitularConta ?? "—")</div>
                        </div>

                        <div class="col-12"><hr class="my-1" /></div>

                        <div class="col-12">
                            <label class="form-label text-muted mb-0">Observação</label>
                            <div style="white-space:pre-wrap;">@(string.IsNullOrWhiteSpace(itemDetalhe.Observacao) ? "—" : itemDetalhe.Observacao)</div>
                        </div>
                    </div>

                    <hr />
                    <h6 class="mb-2">Anexos</h6>
                    <div class="alert alert-info mb-0">Nenhum anexo para este item.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharDetalhe">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (conferenciaAberta)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Conferência de Dados — CPF na SERPRO</h5>
                    @if (!conferenciaRodando)
                    {
                        <button type="button" class="btn-close" @onclick="FecharConferencia"></button>
                    }
                </div>
                <div class="modal-body">
                    <p class="text-muted mb-2">
                        Consultando CPF + Data de Nascimento de cada tutor na SERPRO e comparando
                        com o nome cadastrado no sistema.
                    </p>

                    <div class="d-flex align-items-center gap-2 mb-2">
                        @if (conferenciaRodando)
                        {
                            <span class="spinner-border spinner-border-sm text-info"></span>
                        }
                        <strong>@conferenciaProcessados / @conferenciaTotal</strong>
                    </div>

                    <div class="progress mb-3" style="height: 22px;">
                        <div class="progress-bar @(conferenciaRodando ? "progress-bar-striped progress-bar-animated" : "bg-success")"
                             role="progressbar" style="width:@ConferenciaPercentual%">
                            @ConferenciaPercentual%
                        </div>
                    </div>

                    <div class="row text-center mb-2">
                        <div class="col-4">
                            <div class="fw-bold text-success">@conferenciaOk</div>
                            <div class="small text-muted">OK</div>
                        </div>
                        <div class="col-4">
                            <div class="fw-bold text-danger">@conferenciaDivergentes</div>
                            <div class="small text-muted">Divergentes</div>
                        </div>
                        <div class="col-4">
                            <div class="fw-bold text-warning">@conferenciaErros</div>
                            <div class="small text-muted">Não verificados</div>
                        </div>
                    </div>

                    @if (conferenciaLog.Count > 0)
                    {
                        <div class="border rounded p-2" style="max-height:160px; overflow-y:auto;">
                            @foreach (var linha in conferenciaLog)
                            {
                                <div class="small">@linha</div>
                            }
                        </div>
                    }

                    @if (!conferenciaRodando)
                    {
                        <div class="alert alert-secondary mt-3 mb-0">
                            Conferência concluída. As situações ficam salvas no cadastro de cada tutor
                            (campo "Situação CPF").
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    @if (conferenciaRodando)
                    {
                        <button type="button" class="btn btn-outline-danger" @onclick="CancelarConferencia">Cancelar</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-secondary" @onclick="FecharConferencia">Fechar</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (cnabExportAberto)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Exportar para CNAB</h5>
                    <button type="button" class="btn-close" @onclick="FecharCnabExport" disabled="@cnabProcessando"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(cnabErro))
                    {
                        <div class="alert alert-danger">@cnabErro</div>
                    }

                    @if (cnabResultado is null)
                    {
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Convênio</label>
                                <select class="form-select" @bind="cnabForm.EmpresaPagadora">
                                    @foreach (var e in CnabService.Empresas)
                                    {
                                        <option value="@e.Codigo">@e.Codigo — @e.RazaoSocial (conv. @e.Convenio)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Data do Pagamento</label>
                                <InputDate class="form-control" @bind-Value="cnabForm.DataPagamento" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Nome do Arquivo</label>
                                <input class="form-control" value="@cnabForm.NomeArquivo" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Tipo</label>
                                <select class="form-select" @bind="cnabForm.TipoPagamentoPrincipal">
                                    <option value="PIX">PIX</option>
                                    <option value="01">Crédito em Conta</option>
                                    <option value="41">TED</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Ambiente</label>
                                <select class="form-select" @bind="cnabForm.Ambiente">
                                    <option value="TESTE">Teste</option>
                                    <option value="PRODUCAO">Produção</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Registros Inválidos</label>
                                <select class="form-select" @bind="cnabForm.BloquearSeHouverInvalidos">
                                    <option value="false">Remover</option>
                                    <option value="true">Bloquear</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Lote</label>
                                <select class="form-select" @bind="cnabForm.SepararLotesPorForma">
                                    <option value="false">Único</option>
                                    <option value="true">Separado por forma</option>
                                </select>
                            </div>
                        </div>
                        <div class="alert alert-info mt-3 mb-0">
                            @QuantidadeSelecionadas tutor(es) selecionado(s). Cada arquivo .rem terá no máximo 48 registros;
                            se necessário, mais de um arquivo será gerado.
                        </div>
                    }
                    else
                    {
                        @if (cnabResultado.Bloqueado)
                        {
                            <div class="alert alert-danger"><strong>Geração bloqueada.</strong> @cnabResultado.MotivoBloqueio</div>
                        }
                        else
                        {
                            <div class="alert alert-success">
                                CNAB gerado com sucesso (NSA @cnabResultado.NsaInicial–@cnabResultado.NsaFinal).
                                A validação final deve ser feita no ambiente BTG.
                            </div>
                        }

                        <div class="row g-2 mb-3">
                            <div class="col"><div class="card border-secondary"><div class="card-body py-2"><small class="text-muted">Selecionados</small><h5 class="mb-0">@cnabResultado.TotalSelecionados</h5></div></div></div>
                            <div class="col"><div class="card border-success"><div class="card-body py-2"><small class="text-muted">Válidos</small><h5 class="mb-0 text-success">@cnabResultado.TotalValidos</h5></div></div></div>
                            <div class="col"><div class="card border-info"><div class="card-body py-2"><small class="text-muted">Corrigidos</small><h5 class="mb-0">@cnabResultado.TotalCorrigidos</h5></div></div></div>
                            <div class="col"><div class="card border-warning"><div class="card-body py-2"><small class="text-muted">Pendentes</small><h5 class="mb-0">@cnabResultado.TotalPendentes</h5></div></div></div>
                            <div class="col"><div class="card border-danger"><div class="card-body py-2"><small class="text-muted">Inválidos</small><h5 class="mb-0 text-danger">@cnabResultado.TotalInvalidos</h5></div></div></div>
                        </div>

                        @if (cnabResultado.Arquivos.Count > 0)
                        {
                            <h6>Arquivos gerados</h6>
                            <table class="table table-sm table-striped align-middle">
                                <thead class="table-dark">
                                    <tr><th>Arquivo</th><th>NSA</th><th class="text-end">Operações</th><th class="text-end">Registros</th><th class="text-end">Valor</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in cnabResultado.Arquivos)
                                    {
                                        <tr>
                                            <td>@a.FileName</td>
                                            <td>@a.Nsa</td>
                                            <td class="text-end">@a.Operacoes</td>
                                            <td class="text-end">@a.QuantidadeRegistros</td>
                                            <td class="text-end">@Moeda(a.ValorTotal)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        @if (CnabProblemas.Count > 0)
                        {
                            <h6 class="mt-3">Não gerados / pendentes</h6>
                            <table class="table table-sm align-middle">
                                <thead class="table-dark">
                                    <tr><th>Nome</th><th class="text-end">Valor</th><th>Status</th><th>Observações</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in CnabProblemas)
                                    {
                                        <tr>
                                            <td>@p.Nome</td>
                                            <td class="text-end">@Moeda(p.Valor)</td>
                                            <td>@p.Status</td>
                                            <td><small>@string.Join(" | ", p.Erros.Concat(p.Avisos))</small></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }
                </div>
                <div class="modal-footer">
                    @if (cnabResultado is null)
                    {
                        <button class="btn btn-secondary" @onclick="FecharCnabExport" disabled="@cnabProcessando">Cancelar</button>
                        <button class="btn btn-primary" @onclick="GerarCnabExportAsync" disabled="@cnabProcessando">
                            @if (cnabProcessando) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Gerar CNAB
                        </button>
                    }
                    else
                    {
                        @if (!cnabResultado.Bloqueado && cnabResultado.Arquivos.Count > 0)
                        {
                            <button class="btn btn-success" @onclick="BaixarCnabAsync">Baixar Arquivo(s)</button>
                        }
                        <button class="btn btn-secondary" @onclick="FecharCnabExport">Fechar</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CompetenciaSelecaoDto> competencias = new();
    private int competenciaSelecionadaId;
    private bool processando;
    private bool gerado;
    private string? mensagemErro;

    private List<FolhaTutor2LinhaDto> linhas = new();

    private string? colunaOrdenacao;
    private bool ordemAsc = true;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private FolhaTutorItem? itemDetalhe;

    // ---- Conferência de Dados (SERPRO em lote) ----
    private bool conferenciaAberta;
    private bool conferenciaRodando;
    private int conferenciaTotal;
    private int conferenciaProcessados;
    private int conferenciaOk;
    private int conferenciaDivergentes;
    private int conferenciaErros;
    private List<string> conferenciaLog = new();
    private CancellationTokenSource? conferenciaCts;

    private int ConferenciaPercentual => conferenciaTotal == 0 ? 0 : conferenciaProcessados * 100 / conferenciaTotal;

    // Definição das colunas ordenáveis (rótulo, chave de ordenação e alinhamento).
    private sealed record Coluna(string Chave, string Titulo, Func<FolhaTutor2LinhaDto, object?> Selector, bool Numerico = false);

    private static readonly Coluna[] Colunas =
    {
        new("Tutor",             "Tutor",           l => l.Tutor),
        new("Cpf",               "CPF",             l => l.Cpf),
        new("DataNascimento",    "Dt. Nascimento",  l => l.DataNascimento),
        new("ValorTotalReceber", "Valor a Receber", l => l.ValorTotalReceber, true),
        new("Unidade",           "Unidade",         l => l.Unidade),
        new("NomeTitular",       "Nome Titular",    l => l.NomeTitular),
        new("CpfCnpjConta",      "CPF/CNPJ Titular",l => l.CpfCnpjConta),
        new("Forma",             "Forma",           l => l.Forma),
        new("TipoPessoa",        "Tipo Pessoa",     l => l.TipoPessoa),
        new("TipoChavePix",      "Tipo Chave PIX",  l => l.TipoChavePix),
        new("ChavePix",          "Chave PIX",       l => l.ChavePix),
        new("CodigoBanco",       "Cód. Banco",      l => l.CodigoBanco),
        new("NomeBanco",         "Nome Banco",      l => l.NomeBanco),
        new("Agencia",           "Agência",         l => l.Agencia),
        new("Conta",             "Conta",           l => l.Conta),
    };

    private int QuantidadeSelecionadas => linhas.Count(l => l.Selecionado);
    private decimal TotalSelecionado => linhas.Where(l => l.Selecionado).Sum(l => l.ValorTotalReceber);
    private bool TodosSelecionados => linhas.Count > 0 && linhas.All(l => l.Selecionado);

    protected override async Task OnInitializedAsync()
    {
        competencias = await Service.ObterCompetenciasAsync();
        var atual = competencias.FirstOrDefault(c =>
            c.Mes == DateTime.Today.Month && c.Ano == DateTime.Today.Year);
        if (atual is not null)
            competenciaSelecionadaId = atual.Id;
    }

    private async Task GerarAsync()
    {
        mensagemErro = null;
        if (competenciaSelecionadaId == 0)
        {
            mensagemErro = "Selecione uma competência para gerar o relatório.";
            gerado = false;
            return;
        }

        processando = true;
        try
        {
            linhas = await Service.GerarFolhaTutor2Async(competenciaSelecionadaId);
            colunaOrdenacao = null;
            ordemAsc = true;
            gerado = true;
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro ao gerar relatório: {ex.Message}";
            gerado = false;
        }
        finally
        {
            processando = false;
        }
    }

    private void Limpar()
    {
        linhas = new();
        gerado = false;
        mensagemErro = null;
        colunaOrdenacao = null;
        ordemAsc = true;
    }

    private void Ordenar(string chave)
    {
        var col = Colunas.FirstOrDefault(c => c.Chave == chave);
        if (col is null) return;

        if (colunaOrdenacao == chave)
            ordemAsc = !ordemAsc;
        else
        {
            colunaOrdenacao = chave;
            ordemAsc = true;
        }

        linhas = (ordemAsc
            ? linhas.OrderBy(col.Selector)
            : linhas.OrderByDescending(col.Selector)).ToList();
    }

    private MarkupString Seta(string chave)
    {
        if (colunaOrdenacao != chave) return (MarkupString)"";
        return (MarkupString)(ordemAsc ? " &#9650;" : " &#9660;");
    }

    private void AlternarTodos(ChangeEventArgs e)
    {
        var marcar = e.Value is bool b && b;
        foreach (var l in linhas)
            l.Selecionado = marcar;
    }

    private async Task ExportarExcelAsync()
    {
        var selecionadas = linhas.Where(l => l.Selecionado).ToList();
        if (selecionadas.Count == 0) return;

        var ptBr = CultureInfo.GetCultureInfo("pt-BR");

        // Colunas: título, valor por linha, texto (preserva zeros à esquerda) e numérico.
        var colunas = new (string Titulo, Func<FolhaTutor2LinhaDto, string> Valor, bool Texto, bool Numero)[]
        {
            ("Tutor",           l => l.Tutor,                                     false, false),
            ("CPF",             l => l.Cpf ?? "",                                 true,  false),
            ("Dt. Nascimento",  l => l.DataNascimento?.ToString("dd/MM/yyyy") ?? "", false, false),
            ("Valor a Receber", l => l.ValorTotalReceber.ToString("N2", ptBr),    false, true),
            ("Unidade",         l => l.Unidade ?? "",                             false, false),
            ("Nome Titular",    l => l.NomeTitular ?? "",                          false, false),
            ("CPF/CNPJ Titular",l => l.CpfCnpjConta ?? "",                         true,  false),
            ("Forma",           l => l.Forma ?? "",                               false, false),
            ("Tipo Pessoa",     l => l.TipoPessoa ?? "",                           false, false),
            ("Tipo Chave PIX",  l => l.TipoChavePix ?? "",                         false, false),
            ("Chave PIX",       l => l.ChavePix ?? "",                             true,  false),
            ("Cód. Banco",      l => l.CodigoBanco ?? "",                          true,  false),
            ("Nome Banco",      l => l.NomeBanco ?? "",                            false, false),
            ("Agência",         l => l.Agencia ?? "",                             true,  false),
            ("Conta",           l => l.Conta ?? "",                               false, false),
        };

        // Largura de cada coluna conforme o maior conteúdo (para não quebrar a linha).
        var larguras = new int[colunas.Length];
        for (int c = 0; c < colunas.Length; c++)
        {
            var max = colunas[c].Titulo.Length;
            foreach (var l in selecionadas)
                max = Math.Max(max, colunas[c].Valor(l).Length);
            larguras[c] = Math.Clamp(max * 8 + 16, 70, 420);
        }

        var totalReceber = selecionadas.Sum(l => l.ValorTotalReceber);
        var competenciaTexto = competencias.FirstOrDefault(c => c.Id == competenciaSelecionadaId)?.TextoExibicao ?? "";

        var sb = new StringBuilder();
        sb.Append("<html xmlns:x=\"urn:schemas-microsoft-com:office:excel\"><head><meta charset=\"utf-8\" />");
        sb.Append("<style>");
        sb.Append("table{border-collapse:collapse;}");
        sb.Append("td,th{border:1px solid #b7b7b7;padding:3px 8px;white-space:nowrap;vertical-align:middle;height:22px;font-family:Calibri,Arial,sans-serif;font-size:11pt;}");
        sb.Append("th{background:#305496;color:#ffffff;text-align:left;font-weight:bold;}");
        sb.Append(".titulo{border:none;font-size:16pt;font-weight:bold;color:#1F3864;}");
        sb.Append(".sub{border:none;color:#555555;}");
        sb.Append(".txt{mso-number-format:'\\@';}");
        sb.Append(".num{mso-number-format:'#,##0.00';text-align:right;}");
        sb.Append(".tot{background:#D9E1F2;font-weight:bold;}");
        sb.Append("</style></head><body><table>");

        sb.Append("<colgroup>");
        for (int c = 0; c < colunas.Length; c++)
            sb.Append($"<col style=\"width:{larguras[c]}px;\" />");
        sb.Append("</colgroup>");

        sb.Append($"<tr><td colspan=\"{colunas.Length}\" class=\"titulo\">Folha de Tutores 2</td></tr>");
        sb.Append($"<tr><td colspan=\"{colunas.Length}\" class=\"sub\">Competência: {Esc(competenciaTexto)}</td></tr>");
        sb.Append($"<tr><td colspan=\"{colunas.Length}\" style=\"border:none;height:6px;\"></td></tr>");

        sb.Append("<tr>");
        foreach (var col in colunas)
            sb.Append($"<th>{Esc(col.Titulo)}</th>");
        sb.Append("</tr>");

        foreach (var l in selecionadas)
        {
            sb.Append("<tr>");
            foreach (var col in colunas)
            {
                var cls = col.Texto ? " class=\"txt\"" : col.Numero ? " class=\"num\"" : "";
                sb.Append($"<td{cls}>{Esc(col.Valor(l))}</td>");
            }
            sb.Append("</tr>");
        }

        sb.Append("<tr>");
        sb.Append("<td colspan=\"2\" class=\"tot\" style=\"text-align:right;\">Total</td>");
        sb.Append($"<td class=\"tot num\">{totalReceber.ToString("N2", ptBr)}</td>");
        sb.Append($"<td colspan=\"{colunas.Length - 3}\" class=\"tot\"></td>");
        sb.Append("</tr>");

        sb.Append("</table></body></html>");

        var base64 = Convert.ToBase64String(Encoding.UTF8.GetBytes(sb.ToString()));
        var nome = $"Folha_Tutores_2_{competenciaTexto.Replace('/', '-').Replace(' ', '_')}.xls";
        await JS.InvokeVoidAsync("baixarArquivoBase64", nome, base64, "application/vnd.ms-excel");
    }

    private static string Esc(string? s) =>
        string.IsNullOrEmpty(s) ? "" : System.Net.WebUtility.HtmlEncode(s);

    /// <summary>Compara CPF/CNPJ (só dígitos) do tutor com o titular da conta bancária vinculada.</summary>
    private static bool DadosBancariosConferem(string? cpfPessoa, string? cpfCnpjConta)
    {
        var pessoa = ApenasDigitos(cpfPessoa);
        var conta = ApenasDigitos(cpfCnpjConta);
        return pessoa.Length > 0 && pessoa == conta;
    }

    private static string ApenasDigitos(string? valor) =>
        valor is null ? "" : new string(valor.Where(char.IsDigit).ToArray());

    private static string Moeda(decimal v) => v.ToString("C", CultureInfo.GetCultureInfo("pt-BR"));

    private async Task VisualizarItemAsync(int itemId)
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        itemDetalhe = await context.FolhasTutoresItens
            .AsNoTracking()
            .Include(i => i.Tutor)
            .FirstOrDefaultAsync(i => i.Id == itemId);
    }

    private void FecharDetalhe() => itemDetalhe = null;

    /// <summary>
    /// Consulta a SERPRO (CPF + Data de Nascimento) para cada tutor distinto das
    /// linhas geradas e grava SituacaoCpf ("OK"/"DIVERGENTE") comparando o nome
    /// cadastrado com o nome retornado. Roda sequencialmente, com progresso ao vivo.
    /// </summary>
    private async Task AbrirConferenciaAsync()
    {
        var tutorIds = linhas.Select(l => l.TutorId).Where(id => id > 0).Distinct().ToList();

        conferenciaAberta = true;
        conferenciaRodando = true;
        conferenciaTotal = tutorIds.Count;
        conferenciaProcessados = 0;
        conferenciaOk = 0;
        conferenciaDivergentes = 0;
        conferenciaErros = 0;
        conferenciaLog.Clear();
        conferenciaCts = new CancellationTokenSource();
        StateHasChanged();

        await using var context = await DbFactory.CreateDbContextAsync();

        foreach (var tutorId in tutorIds)
        {
            if (conferenciaCts.IsCancellationRequested)
                break;

            var tutor = await context.Tutores.FirstOrDefaultAsync(t => t.Id == tutorId);
            if (tutor is null)
            {
                conferenciaErros++;
            }
            else if (string.IsNullOrWhiteSpace(tutor.Cpf) || tutor.DataNascimento is not DateTime dataNascimento)
            {
                conferenciaErros++;
                conferenciaLog.Add($"{tutor.Nome}: sem CPF ou Data de Nascimento cadastrada.");
            }
            else
            {
                var consulta = await SerproService.ConsultarAsync(tutor.Cpf, dataNascimento, conferenciaCts.Token);
                if (consulta.Sucesso)
                {
                    tutor.SituacaoCpf = SerproCpfConsultaService.NomesCorrespondem(tutor.Nome, consulta.Nome)
                        ? SituacaoCpfStatus.OK
                        : SituacaoCpfStatus.DIVERGENTE;
                    await context.SaveChangesAsync();

                    if (tutor.SituacaoCpf == SituacaoCpfStatus.OK)
                        conferenciaOk++;
                    else
                    {
                        conferenciaDivergentes++;
                        conferenciaLog.Add($"{tutor.Nome}: DIVERGENTE (SERPRO: \"{consulta.Nome}\").");
                    }
                }
                else
                {
                    conferenciaErros++;
                    conferenciaLog.Add($"{tutor.Nome}: {consulta.MensagemErro}");
                }
            }

            conferenciaProcessados++;
            StateHasChanged();
        }

        conferenciaRodando = false;
        StateHasChanged();
    }

    private void CancelarConferencia() => conferenciaCts?.Cancel();

    private void FecharConferencia() => conferenciaAberta = false;

    // ---- Exportar para CNAB ----
    private bool cnabExportAberto;
    private bool cnabProcessando;
    private string? cnabErro;
    private readonly CnabExportForm cnabForm = new();
    private CnabGenerationResult? cnabResultado;

    private List<NormalizedPayment> CnabProblemas =>
        cnabResultado?.Pagamentos
            .Where(p => p.Status is StatusPagamentoCnab.Invalido or StatusPagamentoCnab.PendenteDeConfirmacao)
            .ToList() ?? new();

    private sealed class CnabExportForm
    {
        public string EmpresaPagadora { get; set; } = string.Empty;
        public DateTime DataPagamento { get; set; } = DateTime.Today;
        public string NomeArquivo { get; set; } = string.Empty;
        public string TipoPagamentoPrincipal { get; set; } = "PIX";
        public string Ambiente { get; set; } = "TESTE";
        public bool BloquearSeHouverInvalidos { get; set; }
        public bool SepararLotesPorForma { get; set; }
    }

    private void AbrirCnabExport()
    {
        cnabForm.EmpresaPagadora = CnabService.Empresas.FirstOrDefault()?.Codigo ?? string.Empty;
        cnabForm.DataPagamento = DateTime.Today;
        cnabForm.NomeArquivo = $"CNAB_Folha_Tutor_{DateTime.Now:yyyyMMdd_HHmmss}";
        cnabForm.TipoPagamentoPrincipal = "PIX";
        cnabForm.Ambiente = "TESTE";
        cnabForm.BloquearSeHouverInvalidos = false;
        cnabForm.SepararLotesPorForma = false;
        cnabErro = null;
        cnabResultado = null;
        cnabExportAberto = true;
    }

    private void FecharCnabExport()
    {
        cnabExportAberto = false;
        cnabResultado = null;
        cnabErro = null;
    }

    /// <summary>
    /// Gera o(s) .rem a partir das linhas selecionadas no relatório (independente
    /// do status da folha), usando as classes puras do gerador CNAB BTG. O NSA é
    /// obtido/atualizado na mesma sequência (CnabSequences) usada pelo módulo
    /// "Gerenciar CNAB" para não colidir com outros lotes já enviados ao banco.
    /// </summary>
    private async Task GerarCnabExportAsync()
    {
        cnabErro = null;
        cnabProcessando = true;
        try
        {
            var selecionadas = linhas.Where(l => l.Selecionado).ToList();
            if (selecionadas.Count == 0)
            {
                cnabErro = "Nenhum tutor selecionado.";
                return;
            }

            var empresa = EmpresaPagadora.Obter(cnabForm.EmpresaPagadora, CnabService.Empresas);
            if (empresa is null)
            {
                cnabErro = "Selecione um convênio válido.";
                return;
            }

            await using var context = await DbFactory.CreateDbContextAsync();

            // O relatório não traz o dígito da conta separado: busca do cadastro do tutor.
            var tutorIds = selecionadas.Select(l => l.TutorId).Distinct().ToList();
            var digitosPorTutor = await context.Tutores.AsNoTracking()
                .Where(t => tutorIds.Contains(t.Id))
                .Select(t => new { t.Id, Digito = t.ContaBancaria!.DigitoConta })
                .ToDictionaryAsync(x => x.Id, x => x.Digito);

            var inputs = selecionadas.Select(l => new PaymentInput
            {
                Id = l.ItemId,
                Origem = "Tutor",
                Nome = l.Tutor,
                NomeTitular = l.NomeTitular,
                CpfCnpj = l.CpfCnpjConta,
                Valor = l.ValorTotalReceber,
                Forma = l.Forma, // "PIX"/"TED" do cadastro; o Tipo do popup só é usado como fallback
                TipoPessoa = l.TipoPessoa,
                ChavePix = l.ChavePix,
                TipoChavePix = l.TipoChavePix,
                BancoNome = l.NomeBanco,
                CodigoBanco = l.CodigoBanco,
                Agencia = l.Agencia,
                Conta = l.Conta,
                DigitoConta = digitosPorTutor.TryGetValue(l.TutorId, out var dv) ? dv : null
            }).ToList();

            var seq = await context.CnabSequences.FirstOrDefaultAsync(s => s.EmpresaPagadora == empresa.Codigo);
            var nsaInicial = (seq?.UltimoNsa ?? 0) + 1;

            var user = (await AuthProvider.GetAuthenticationStateAsync()).User;

            var options = new CnabGenerationOptions
            {
                Empresa = empresa,
                DataPagamento = cnabForm.DataPagamento,
                NsaInicial = nsaInicial,
                NomeBaseArquivo = cnabForm.NomeArquivo,
                TipoPagamentoPrincipal = cnabForm.TipoPagamentoPrincipal,
                Ambiente = string.Equals(cnabForm.Ambiente, "PRODUCAO", StringComparison.OrdinalIgnoreCase)
                    ? AmbienteCnab.Producao : AmbienteCnab.Teste,
                TratamentoInvalidos = cnabForm.BloquearSeHouverInvalidos ? TratamentoInvalidos.Bloquear : TratamentoInvalidos.Remover,
                SepararLotesPorForma = cnabForm.SepararLotesPorForma,
                MaxOperacoesPorArquivo = 48,
                GeradoEm = DateTime.Now,
                GeradoPor = user.Identity?.Name
            };

            var generator = new CnabBtgPaymentGenerator();
            var resultado = generator.Gerar(inputs, options);
            cnabResultado = resultado;

            if (!resultado.Bloqueado && resultado.Arquivos.Count > 0)
            {
                if (seq is null)
                {
                    context.CnabSequences.Add(new CnabSequence
                    {
                        EmpresaPagadora = empresa.Codigo,
                        UltimoNsa = resultado.NsaFinal,
                        UpdatedAt = options.GeradoEm
                    });
                }
                else
                {
                    seq.UltimoNsa = resultado.NsaFinal;
                    seq.UpdatedAt = options.GeradoEm;
                }
                await context.SaveChangesAsync();
            }
        }
        catch (Exception ex)
        {
            cnabErro = $"Erro ao gerar CNAB: {ex.Message}";
        }
        finally
        {
            cnabProcessando = false;
        }
    }

    private async Task BaixarCnabAsync()
    {
        if (cnabResultado is null || cnabResultado.Arquivos.Count == 0) return;

        if (cnabResultado.Arquivos.Count == 1)
        {
            var a = cnabResultado.Arquivos[0];
            var base64 = Convert.ToBase64String(CnabZipPacker.RemBytes(a.Conteudo));
            await JS.InvokeVoidAsync("baixarArquivoBase64", a.FileName, base64, "application/octet-stream");
            return;
        }

        using var ms = new MemoryStream();
        using (var zip = new ZipArchive(ms, ZipArchiveMode.Create, leaveOpen: true))
        {
            foreach (var a in cnabResultado.Arquivos)
            {
                var entry = zip.CreateEntry(a.FileName, CompressionLevel.Optimal);
                await using var s = entry.Open();
                var bytes = CnabZipPacker.RemBytes(a.Conteudo);
                await s.WriteAsync(bytes);
            }
        }
        var zipBase64 = Convert.ToBase64String(ms.ToArray());
        await JS.InvokeVoidAsync("baixarArquivoBase64", $"{cnabForm.NomeArquivo}.zip", zipBase64, "application/zip");
    }
}
