@page "/contas-bancarias"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using MinhaAplicacaoBlazor.Data
@using MinhaAplicacaoBlazor.Models

@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Contas Bancárias</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Contas Bancárias</h1>
        <div class="d-flex gap-2 d-print-none">
            <button class="btn btn-outline-primary" @onclick="ImprimirAsync">Imprimir</button>
            <button class="btn btn-primary" @onclick="Novo">Nova Conta Bancária</button>
        </div>
    </div>

    <div class="d-none d-print-block mb-3">
        <h5 class="mb-1">Filtros aplicados</h5>
        <div>
            <strong>Pesquisa:</strong> @(string.IsNullOrWhiteSpace(filtroTexto) ? "—" : filtroTexto) &nbsp;|&nbsp;
            <strong>Total:</strong> @ContasFiltradas.Count() registro(s)
        </div>
    </div>

    <div class="row mb-3 g-2 d-print-none">
        <div class="col-md-6">
            <input type="text"
                   class="form-control"
                   placeholder="Pesquisar por titular, CPF/CNPJ, banco ou chave PIX..."
                   @bind="filtroTexto"
                   @bind:event="oninput" />
        </div>
        <div class="col-md-2">
            <select class="form-select" @bind="pagination.ItemsPerPage">
                <option value="10">10 por página</option>
                <option value="25">25 por página</option>
                <option value="50">50 por página</option>
                <option value="100">100 por página</option>
            </select>
        </div>
    </div>

    @if (contas is null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <div class="table-responsive">
            <QuickGrid Items="ContasFiltradas" Pagination="pagination" Class="table table-striped table-hover align-middle imprimivel-sem-acoes">
                <PropertyColumn Property="@(c => c.NomeTitular)" Title="Titular" Sortable="true" InitialSortDirection="SortDirection.Ascending" IsDefaultSortColumn="true" />
                <PropertyColumn Property="@(c => c.CpfCnpj)" Title="CPF/CNPJ" Sortable="true" />
                <PropertyColumn Property="@(c => c.TipoPessoa)" Title="Tipo Pessoa" Sortable="true" />
                <PropertyColumn Property="@(c => c.Forma)" Title="Forma" Sortable="true" />
                <PropertyColumn Property="@(c => c.NomeBanco)" Title="Banco" Sortable="true" />
                <TemplateColumn Title="Ações" Align="Align.End">
                    <button class="btn btn-sm btn-outline-secondary me-1"
                            title="Editar"
                            @onclick="() => Editar(context.Id)">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
                        </svg>
                    </button>
                    <button class="btn btn-sm btn-outline-danger"
                            title="Excluir"
                            @onclick="() => ExcluirAsync(context.Id)">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                        </svg>
                    </button>
                </TemplateColumn>
            </QuickGrid>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-2 d-print-none">
            <small class="text-muted">@(ContasFiltradas.Count()) registro(s) encontrado(s)</small>
            <Paginator State="pagination" />
        </div>
    }
</div>

@code {
    private List<ContaBancaria>? contas;
    private string filtroTexto = string.Empty;
    private readonly PaginationState pagination = new() { ItemsPerPage = 10 };

    private IQueryable<ContaBancaria> ContasFiltradas
    {
        get
        {
            if (contas is null)
                return Enumerable.Empty<ContaBancaria>().AsQueryable();

            IEnumerable<ContaBancaria> resultado = contas;

            if (!string.IsNullOrWhiteSpace(filtroTexto))
            {
                var termo = filtroTexto.Trim();
                resultado = resultado.Where(c =>
                    c.NomeTitular.Contains(termo, StringComparison.OrdinalIgnoreCase) ||
                    c.CpfCnpj.Contains(termo, StringComparison.OrdinalIgnoreCase) ||
                    (c.NomeBanco != null && c.NomeBanco.Contains(termo, StringComparison.OrdinalIgnoreCase)) ||
                    (c.ChavePix != null && c.ChavePix.Contains(termo, StringComparison.OrdinalIgnoreCase)));
            }

            return resultado.AsQueryable();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CarregarDadosAsync();
    }

    private async Task CarregarDadosAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        contas = await context.ContasBancarias
            .AsNoTracking()
            .OrderBy(c => c.NomeTitular)
            .ToListAsync();
    }

    private async Task ImprimirAsync()
    {
        var anteriores = pagination.ItemsPerPage;
        await pagination.SetCurrentPageIndexAsync(0);
        pagination.ItemsPerPage = int.MaxValue;
        StateHasChanged();
        await Task.Yield();
        await JS.InvokeVoidAsync("window.print");
        pagination.ItemsPerPage = anteriores;
    }

    private void Novo() => Navigation.NavigateTo("/contas-bancarias/novo");
    private void Editar(int id) => Navigation.NavigateTo($"/contas-bancarias/editar/{id}");

    private async Task ExcluirAsync(int id)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", "Deseja realmente excluir esta conta bancária?");
        if (!confirmado) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        var entidade = await context.ContasBancarias.FindAsync(id);

        if (entidade is not null)
        {
            context.ContasBancarias.Remove(entidade);
            await context.SaveChangesAsync();
            await CarregarDadosAsync();
        }
    }
}
