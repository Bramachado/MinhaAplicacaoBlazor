@page "/titulacoes"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using MinhaAplicacaoBlazor.Data
@using MinhaAplicacaoBlazor.Models

@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Titulações</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Titulações</h1>
        <button class="btn btn-primary" @onclick="Nova">
            Nova Titulação
        </button>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <input type="text"
                   class="form-control"
                   placeholder="Pesquisar por nome..."
                   @bind="filtroNome"
                   @bind:event="oninput" />
        </div>
    </div>

    @if (titulacoes is null)
    {
        <p>Carregando...</p>
    }
    else if (!TitulacoesFiltradas.Any())
    {
        <div class="alert alert-info">Nenhuma titulação encontrada.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Nome</th>
                        <th>Valor Hora Aula Normal</th>
                        <th>Valor Hora Aula Prática</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in TitulacoesFiltradas)
                    {
                        <tr>
                            <td>@t.Nome</td>
                            <td>@t.ValorHoraAulaNormal.ToString("C")</td>
                            <td>@t.ValorHoraAulaPratica.ToString("C")</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary me-1"
                                        title="Editar"
                                        @onclick="() => Editar(t.Id)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
                                    </svg>
                                </button>
                                <button class="btn btn-sm btn-outline-danger"
                                        title="Excluir"
                                        @onclick="() => ExcluirAsync(t.Id)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                        <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                    </svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Titulacao>? titulacoes;
    private string filtroNome = string.Empty;

    private IEnumerable<Titulacao> TitulacoesFiltradas =>
        titulacoes is null
            ? Enumerable.Empty<Titulacao>()
            : string.IsNullOrWhiteSpace(filtroNome)
                ? titulacoes
                : titulacoes.Where(t => t.Nome.Contains(filtroNome, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await CarregarDadosAsync();
    }

    private async Task CarregarDadosAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        titulacoes = await context.Titulacoes
            .AsNoTracking()
            .OrderBy(t => t.Nome)
            .ToListAsync();
    }

    private void Nova()
    {
        Navigation.NavigateTo("/titulacoes/novo");
    }

    private void Editar(int id)
    {
        Navigation.NavigateTo($"/titulacoes/editar/{id}");
    }

    private async Task ExcluirAsync(int id)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", "Deseja realmente excluir esta titulação?");

        if (!confirmado)
            return;

        await using var context = await DbFactory.CreateDbContextAsync();

        var entidade = await context.Titulacoes.FindAsync(id);

        if (entidade is not null)
        {
            context.Titulacoes.Remove(entidade);
            await context.SaveChangesAsync();
            await CarregarDadosAsync();
        }
    }
}
