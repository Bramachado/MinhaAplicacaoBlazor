@page "/financeiro/cnab/remessas/{Id:int}"
@attribute [Authorize(Policy = "Cnab.Ver")]
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using MinhaAplicacaoBlazor.Data
@using MinhaAplicacaoBlazor.Models.Cnab
@using MinhaAplicacaoBlazor.Services.Cnab

@inject IDbContextFactory<AppDbContext> DbFactory
@inject ICnabPagamentoService Service
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Detalhes Remessa CNAB</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Detalhes da Remessa</h1>
        <button class="btn btn-secondary" @onclick="@(() => Navigation.NavigateTo("/financeiro/cnab/remessas"))">Voltar</button>
    </div>

    @if (remessa is null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3"><strong>NSA:</strong> @remessa.NumeroSequencial</div>
                    <div class="col-md-5"><strong>Arquivo:</strong> @remessa.NomeArquivo</div>
                    <div class="col-md-2"><strong>Geração:</strong> @remessa.DataGeracao.ToString("dd/MM/yyyy HH:mm")</div>
                    <div class="col-md-2"><strong>Status:</strong> <span class="badge @StatusBadge(remessa.Status)">@remessa.Status</span></div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-6"><strong>Empresa:</strong> @remessa.ConfiguracaoCnab?.RazaoSocial — CNPJ @remessa.ConfiguracaoCnab?.CNPJ</div>
                    <div class="col-md-3"><strong>Banco:</strong> @remessa.ConfiguracaoCnab?.BancoCodigo - @remessa.ConfiguracaoCnab?.BancoNome</div>
                    <div class="col-md-3"><strong>Ag/Conta:</strong> @remessa.ConfiguracaoCnab?.Agencia / @remessa.ConfiguracaoCnab?.Conta-@remessa.ConfiguracaoCnab?.ContaDV</div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-3"><strong>Pagamentos:</strong> @remessa.QuantidadePagamentos</div>
                    <div class="col-md-3"><strong>Registros:</strong> @remessa.QuantidadeRegistros</div>
                    <div class="col-md-3"><strong>Valor Total:</strong> @remessa.ValorTotal.ToString("C")</div>
                    <div class="col-md-3"><strong>Competência:</strong> @(remessa.Competencia is not null ? $"{remessa.Competencia.Mes:00}/{remessa.Competencia.Ano}" : "—")</div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mb-3 flex-wrap">
            <button class="btn btn-success" @onclick="BaixarAsync">Baixar .rem</button>
            <PermissaoView Requer="Cnab.Editar">
                @if (remessa.Status == "Gerada")
                {
                    <button class="btn btn-info" @onclick="MarcarEnviadaAsync">Marcar como Enviada</button>
                }
                @if (remessa.Status != "Cancelada" && remessa.Status != "Processada")
                {
                    <button class="btn btn-danger" @onclick="CancelarAsync">Cancelar Remessa</button>
                }
            </PermissaoView>
            <button class="btn btn-outline-primary" @onclick="IrImportarRetorno">Importar Retorno</button>
            <button class="btn btn-outline-secondary" @onclick="ToggleConteudo">@(mostrarConteudo ? "Ocultar" : "Visualizar") Conteúdo</button>
        </div>

        @if (mostrarConteudo)
        {
            <div class="card mb-3">
                <div class="card-header">Conteúdo do Arquivo</div>
                <pre class="card-body" style="font-family: 'Courier New', monospace; font-size: 11px; max-height: 400px; overflow: auto;">@remessa.ConteudoArquivo</pre>
            </div>
        }

        <div class="card">
            <div class="card-header"><strong>Itens</strong></div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Seu Número</th>
                                <th>Favorecido</th>
                                <th>CPF/CNPJ</th>
                                <th>Forma</th>
                                <th>Banco/Ag./Conta</th>
                                <th>Chave PIX</th>
                                <th class="text-end">Valor</th>
                                <th>Data Pgto</th>
                                <th>Status</th>
                                <th>Ocorrência</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in remessa.Itens)
                            {
                                <tr>
                                    <td>@i.SeuNumero</td>
                                    <td>@i.NomeFavorecido</td>
                                    <td>@i.CPF_CNPJ_Favorecido</td>
                                    <td>@i.FormaLancamentoCnab?.Codigo - @i.FormaLancamentoCnab?.Nome</td>
                                    <td>@i.BancoFavorecido / @i.AgenciaFavorecido / @i.ContaFavorecido</td>
                                    <td>@i.ChavePix</td>
                                    <td class="text-end fw-semibold">@i.ValorPagamento.ToString("C")</td>
                                    <td>@i.DataPagamento.ToString("dd/MM/yyyy")</td>
                                    <td><span class="badge @StatusItemBadge(i.Status)">@i.Status</span></td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(i.MensagemOcorrencia))
                                        {
                                            <small class="text-danger">@i.CodigoOcorrencia: @i.MensagemOcorrencia</small>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private RemessaCnab? remessa;
    private bool mostrarConteudo;

    protected override async Task OnInitializedAsync() => await CarregarAsync();

    private async Task CarregarAsync()
    {
        await using var ctx = await DbFactory.CreateDbContextAsync();
        remessa = await ctx.RemessasCnab.AsNoTracking()
            .Include(r => r.ConfiguracaoCnab)
            .Include(r => r.Competencia)
            .Include(r => r.Itens).ThenInclude(i => i.FormaLancamentoCnab)
            .FirstOrDefaultAsync(r => r.Id == Id);
    }

    private async Task BaixarAsync()
    {
        if (remessa is null) return;
        var bytes = await Service.BaixarArquivoRemessaAsync(Id);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("eval",
            $"(function(){{var a=document.createElement('a');a.href='data:application/octet-stream;base64,{base64}';a.download='{remessa.NomeArquivo}';document.body.appendChild(a);a.click();a.remove();}})()");
    }

    private async Task MarcarEnviadaAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Marcar como enviada?")) return;
        try { await Service.MarcarComoEnviadaAsync(Id); await CarregarAsync(); }
        catch (Exception ex) { await JS.InvokeVoidAsync("alert", ex.Message); }
    }

    private async Task CancelarAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Cancelar esta remessa?")) return;
        try { await Service.CancelarRemessaAsync(Id); await CarregarAsync(); }
        catch (Exception ex) { await JS.InvokeVoidAsync("alert", ex.Message); }
    }

    private void ToggleConteudo() => mostrarConteudo = !mostrarConteudo;

    private void IrImportarRetorno()
    {
        if (remessa is null) return;
        Navigation.NavigateTo($"/financeiro/cnab/importar-retorno?remessaId={remessa.Id}");
    }

    private static string StatusBadge(string s) => s switch
    {
        "Gerada" => "bg-warning text-dark",
        "Enviada" => "bg-info text-dark",
        "Aceita" => "bg-success",
        "Processada" => "bg-primary",
        "Rejeitada" => "bg-danger",
        "Cancelada" => "bg-secondary",
        _ => "bg-light text-dark"
    };

    private static string StatusItemBadge(string s) => s switch
    {
        "Pendente" => "bg-warning text-dark",
        "Validado" => "bg-info text-dark",
        "EmRemessa" => "bg-info text-dark",
        "Aceito" => "bg-success",
        "Pago" => "bg-success",
        "Rejeitado" => "bg-danger",
        "ComErro" => "bg-danger",
        "Cancelado" => "bg-secondary",
        _ => "bg-light text-dark"
    };
}
