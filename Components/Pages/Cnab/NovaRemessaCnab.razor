@page "/financeiro/cnab/nova-remessa"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using MinhaAplicacaoBlazor.Data
@using MinhaAplicacaoBlazor.Models
@using MinhaAplicacaoBlazor.Models.Cnab
@using MinhaAplicacaoBlazor.Models.Cnab.Dtos
@using MinhaAplicacaoBlazor.Services.Cnab

@inject IDbContextFactory<AppDbContext> DbFactory
@inject ICnabPagamentoService Service
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Nova Remessa CNAB</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Nova Remessa CNAB</h1>
        <button class="btn btn-secondary" @onclick="@(() => Navigation.NavigateTo("/financeiro/cnab/remessas"))">Voltar</button>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label">Configuração</label>
                    <select class="form-select" @bind="cfgId">
                        <option value="0">-- Selecione --</option>
                        @foreach (var c in configuracoes)
                        {
                            <option value="@c.Id">@c.NomeConfiguracao</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Competência</label>
                    <select class="form-select" @bind="competenciaId">
                        <option value="0">-- Selecione --</option>
                        @foreach (var c in competencias)
                        {
                            <option value="@c.Id">@($"{c.Mes:00}/{c.Ano}")</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Data Pagamento</label>
                    <input type="date" class="form-control" @bind="dataPagamento" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Forma de Lançamento</label>
                    <select class="form-select" @bind="formaId">
                        <option value="0">-- Selecione --</option>
                        @foreach (var f in formas.Where(x => x.Ativa))
                        {
                            <option value="@f.Id">@f.Codigo - @f.Nome</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Origem</label>
                    <select class="form-select" @bind="origem">
                        <option value="LancamentoFinanceiro">Lançamentos Financeiros</option>
                        <option value="FolhaColaborador">Folha Colaboradores</option>
                        <option value="FolhaTutor">Folha Tutores</option>
                    </select>
                </div>
            </div>

            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-primary" @onclick="CarregarPagamentosAsync" disabled="@(competenciaId == 0)">Carregar Pagamentos</button>
                <button class="btn btn-info" @onclick="ValidarAsync" disabled="@(pagamentos.Count == 0)">Validar</button>
                <button class="btn btn-success" @onclick="GerarRemessaAsync" disabled="@(pagamentos.Count == 0 || formaId == 0 || cfgId == 0)">Gerar Remessa</button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensagem))
    {
        <div class="alert @(mensagemOk ? "alert-success" : "alert-danger")">@mensagem</div>
    }

    @if (pagamentos.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-body py-2">
                <div class="row text-center">
                    <div class="col"><small class="text-muted">Total na lista</small><h5 class="mb-0">@pagamentos.Count</h5></div>
                    <div class="col"><small class="text-muted">Selecionados</small><h5 class="mb-0">@pagamentos.Count(p => p.Selecionado)</h5></div>
                    <div class="col"><small class="text-muted">Valor selecionado</small><h5 class="mb-0">@TotalSelecionado.ToString("C")</h5></div>
                    <div class="col"><small class="text-muted">Já em remessa</small><h5 class="mb-0">@pagamentos.Count(p => p.JaEmRemessa)</h5></div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th><input type="checkbox" @onchange="ToggleSelecionarTodos" checked="@todosSelecionados" /></th>
                        <th>Favorecido</th>
                        <th>CPF/CNPJ</th>
                        <th>Banco</th>
                        <th>Agência</th>
                        <th>Conta</th>
                        <th>Chave PIX</th>
                        <th class="text-end">Valor</th>
                        <th>Descrição</th>
                        <th>Validação</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int idx = 0; idx < pagamentos.Count; idx++)
                    {
                        var i = idx;
                        var p = pagamentos[i];
                        <tr class="@(p.JaEmRemessa ? "table-secondary" : "")">
                            <td><input type="checkbox" @bind="p.Selecionado" disabled="@p.JaEmRemessa" /></td>
                            <td>@p.NomeFavorecido</td>
                            <td>@p.CPF_CNPJ_Favorecido</td>
                            <td>@p.Banco</td>
                            <td>@p.Agencia</td>
                            <td>@p.Conta</td>
                            <td>@p.ChavePix</td>
                            <td class="text-end fw-semibold">@p.Valor.ToString("C")</td>
                            <td>@p.Descricao</td>
                            <td>
                                @if (p.JaEmRemessa)
                                {
                                    <span class="badge bg-secondary">Já em remessa</span>
                                }
                                else if (p.ErrosValidacao.Count > 0)
                                {
                                    @foreach (var e in p.ErrosValidacao)
                                    {
                                        <div class="text-danger small">@e</div>
                                    }
                                }
                                else if (validouOK)
                                {
                                    <span class="badge bg-success">OK</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<ConfiguracaoCnab> configuracoes = new();
    private List<Competencia> competencias = new();
    private List<FormaLancamentoCnab> formas = new();

    private int cfgId;
    private int competenciaId;
    private int formaId;
    private DateTime dataPagamento = DateTime.Today;
    private string origem = "LancamentoFinanceiro";

    private List<PagamentoPendenteCnabDto> pagamentos = new();
    private bool todosSelecionados;
    private string? mensagem;
    private bool mensagemOk;
    private bool validouOK;

    private decimal TotalSelecionado => pagamentos.Where(p => p.Selecionado).Sum(p => p.Valor);

    protected override async Task OnInitializedAsync()
    {
        await using var ctx = await DbFactory.CreateDbContextAsync();
        configuracoes = await ctx.ConfiguracoesCnab.AsNoTracking().Where(c => c.Ativa).OrderBy(c => c.NomeConfiguracao).ToListAsync();
        competencias = await ctx.Competencias.AsNoTracking().OrderByDescending(c => c.Ano).ThenByDescending(c => c.Mes).ToListAsync();
        formas = await ctx.FormasLancamentoCnab.AsNoTracking().OrderBy(f => f.Codigo).ToListAsync();

        var primeira = configuracoes.FirstOrDefault();
        if (primeira is not null) cfgId = primeira.Id;
        var formaPadrao = formas.FirstOrDefault(f => f.Codigo == "01");
        if (formaPadrao is not null) formaId = formaPadrao.Id;
    }

    private async Task CarregarPagamentosAsync()
    {
        mensagem = null;
        validouOK = false;
        if (competenciaId == 0) return;
        pagamentos = await Service.ListarPagamentosPendentesAsync(competenciaId, origem);
        todosSelecionados = false;
    }

    private void ToggleSelecionarTodos(ChangeEventArgs e)
    {
        todosSelecionados = (bool)e.Value!;
        foreach (var p in pagamentos.Where(x => !x.JaEmRemessa))
            p.Selecionado = todosSelecionados;
    }

    private async Task ValidarAsync()
    {
        var req = MontarRequest();
        var res = await Service.ValidarRemessaAsync(req);

        foreach (var p in pagamentos) p.ErrosValidacao.Clear();
        var selecionados = pagamentos.Where(p => p.Selecionado && !p.JaEmRemessa).ToList();
        foreach (var erro in res.ItensComErro)
        {
            if (erro.Indice < selecionados.Count)
                selecionados[erro.Indice].ErrosValidacao = erro.Erros;
        }

        if (res.Valido)
        {
            mensagem = $"Validação OK. {res.QuantidadeValidada} pagamentos, total {res.ValorTotal:C}.";
            mensagemOk = true;
            validouOK = true;
        }
        else
        {
            mensagem = "Há erros de validação. " + string.Join(" / ", res.ErrosGerais);
            mensagemOk = false;
            validouOK = false;
        }
    }

    private async Task GerarRemessaAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Confirma a geração da remessa CNAB?")) return;

        try
        {
            var req = MontarRequest();
            var rem = await Service.CriarRemessaAsync(req);
            mensagem = $"Remessa #{rem.NumeroSequencial} gerada com sucesso ({rem.NomeArquivo}).";
            mensagemOk = true;
            Navigation.NavigateTo($"/financeiro/cnab/remessas/{rem.Id}");
        }
        catch (Exception ex)
        {
            mensagem = ex.Message;
            mensagemOk = false;
        }
    }

    private CriarRemessaCnabRequest MontarRequest()
    {
        return new CriarRemessaCnabRequest
        {
            ConfiguracaoCnabId = cfgId,
            CompetenciaId = competenciaId == 0 ? null : competenciaId,
            DataPagamento = dataPagamento,
            FormaLancamentoCnabId = formaId,
            Origem = origem,
            ItensSelecionados = pagamentos
                .Where(p => p.Selecionado && !p.JaEmRemessa)
                .Select(p => new CriarRemessaCnabItemRequest
                {
                    LancamentoFinanceiroId = origem == "LancamentoFinanceiro" ? p.OrigemId : null,
                    FolhaColaboradorItemId = origem == "FolhaColaborador" ? p.OrigemId : null,
                    FolhaTutorItemId = origem == "FolhaTutor" ? p.OrigemId : null,
                    NomeFavorecido = p.NomeFavorecido,
                    CPF_CNPJ_Favorecido = p.CPF_CNPJ_Favorecido,
                    BancoFavorecido = p.Banco,
                    AgenciaFavorecido = p.Agencia,
                    ContaFavorecido = p.Conta,
                    ChavePix = p.ChavePix,
                    TipoChavePix = string.IsNullOrWhiteSpace(p.ChavePix) ? null : DetectarTipoPix(p.ChavePix),
                    ValorPagamento = p.Valor
                })
                .ToList()
        };
    }

    private static string? DetectarTipoPix(string? chave)
    {
        if (string.IsNullOrWhiteSpace(chave)) return null;
        if (chave.Contains('@')) return "EMAIL";
        if (chave.All(char.IsDigit) && (chave.Length == 11 || chave.Length == 14)) return "CPF/CNPJ";
        if (chave.StartsWith("+") || (chave.All(char.IsDigit) && chave.Length >= 10 && chave.Length <= 13)) return "TELEFONE";
        return "ALEATORIA";
    }
}
