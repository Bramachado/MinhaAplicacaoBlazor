@page "/financeiro/cnab/configuracoes"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using MinhaAplicacaoBlazor.Data
@using MinhaAplicacaoBlazor.Models.Cnab

@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS

<PageTitle>Configurações CNAB</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Configurações CNAB</h1>
        <button class="btn btn-primary" @onclick="Nova">Nova Configuração</button>
    </div>

    @if (configuracoes is null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Nome</th>
                        <th>Banco</th>
                        <th>Razão Social</th>
                        <th>CNPJ</th>
                        <th>Ag./Conta</th>
                        <th>Layout</th>
                        <th class="text-end">Próx. NSA</th>
                        <th>Ativa</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in configuracoes)
                    {
                        <tr>
                            <td>@c.NomeConfiguracao</td>
                            <td>@c.BancoCodigo - @c.BancoNome</td>
                            <td>@c.RazaoSocial</td>
                            <td>@c.CNPJ</td>
                            <td>@c.Agencia / @c.Conta-@c.ContaDV</td>
                            <td>@c.Layout</td>
                            <td class="text-end">@c.SequencialArquivo</td>
                            <td>
                                @if (c.Ativa)
                                {
                                    <span class="badge bg-success">Sim</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Não</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => Editar(c)">Editar</button>
                                <button class="btn btn-sm btn-outline-warning" @onclick="() => AlternarAtivaAsync(c)">@(c.Ativa ? "Inativar" : "Ativar")</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (editando is not null)
    {
        <div class="card mt-3">
            <div class="card-header">
                <h4 class="mb-0">@(editando.Id == 0 ? "Nova Configuração" : "Editar Configuração")</h4>
            </div>
            <div class="card-body">
                <EditForm Model="editando" OnValidSubmit="SalvarAsync" FormName="form-cfg-cnab">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />
                    <div class="row">
                        <div class="col-md-6 mb-3"><label class="form-label">Nome da Configuração</label><InputText class="form-control" @bind-Value="editando.NomeConfiguracao" /></div>
                        <div class="col-md-3 mb-3"><label class="form-label">Banco (cód.)</label><InputText class="form-control" @bind-Value="editando.BancoCodigo" /></div>
                        <div class="col-md-3 mb-3"><label class="form-label">Banco (nome)</label><InputText class="form-control" @bind-Value="editando.BancoNome" /></div>
                    </div>
                    <div class="row">
                        <div class="col-md-8 mb-3"><label class="form-label">Razão Social</label><InputText class="form-control" @bind-Value="editando.RazaoSocial" /></div>
                        <div class="col-md-4 mb-3"><label class="form-label">CNPJ</label><InputText class="form-control" @bind-Value="editando.CNPJ" /></div>
                    </div>
                    <div class="row">
                        <div class="col-md-2 mb-3"><label class="form-label">Agência</label><InputText class="form-control" @bind-Value="editando.Agencia" /></div>
                        <div class="col-md-1 mb-3"><label class="form-label">DV Ag.</label><InputText class="form-control" @bind-Value="editando.AgenciaDV" /></div>
                        <div class="col-md-3 mb-3"><label class="form-label">Conta</label><InputText class="form-control" @bind-Value="editando.Conta" /></div>
                        <div class="col-md-1 mb-3"><label class="form-label">DV Conta</label><InputText class="form-control" @bind-Value="editando.ContaDV" /></div>
                        <div class="col-md-3 mb-3"><label class="form-label">Convênio</label><InputText class="form-control" @bind-Value="editando.Convenio" /></div>
                        <div class="col-md-2 mb-3"><label class="form-label">Layout</label><InputText class="form-control" @bind-Value="editando.Layout" /></div>
                    </div>
                    <div class="row">
                        <div class="col-md-2 mb-3"><label class="form-label">V. Layout Arq.</label><InputText class="form-control" @bind-Value="editando.VersaoLayoutArquivo" /></div>
                        <div class="col-md-2 mb-3"><label class="form-label">V. Layout Lote</label><InputText class="form-control" @bind-Value="editando.VersaoLayoutLote" /></div>
                        <div class="col-md-3 mb-3"><label class="form-label">Próximo NSA</label><InputNumber class="form-control" @bind-Value="editando.SequencialArquivo" /></div>
                        <div class="col-md-2 mb-3 d-flex align-items-end"><div class="form-check"><InputCheckbox class="form-check-input" id="cfg-ativa" @bind-Value="editando.Ativa" /><label class="form-check-label" for="cfg-ativa">Ativa</label></div></div>
                    </div>

                    @if (!string.IsNullOrEmpty(mensagemErro))
                    {
                        <div class="alert alert-danger">@mensagemErro</div>
                    }

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Salvar</button>
                        <button type="button" class="btn btn-secondary" @onclick="() => editando = null">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    private List<ConfiguracaoCnab>? configuracoes;
    private ConfiguracaoCnab? editando;
    private string? mensagemErro;

    protected override async Task OnInitializedAsync() => await CarregarAsync();

    private async Task CarregarAsync()
    {
        await using var ctx = await DbFactory.CreateDbContextAsync();
        configuracoes = await ctx.ConfiguracoesCnab.AsNoTracking()
            .OrderByDescending(c => c.Ativa).ThenBy(c => c.NomeConfiguracao)
            .ToListAsync();
    }

    private void Nova() => editando = new ConfiguracaoCnab();
    private void Editar(ConfiguracaoCnab c) => editando = new ConfiguracaoCnab
    {
        Id = c.Id, NomeConfiguracao = c.NomeConfiguracao, BancoCodigo = c.BancoCodigo,
        BancoNome = c.BancoNome, RazaoSocial = c.RazaoSocial, CNPJ = c.CNPJ,
        Agencia = c.Agencia, AgenciaDV = c.AgenciaDV, Conta = c.Conta, ContaDV = c.ContaDV,
        Convenio = c.Convenio, Layout = c.Layout,
        VersaoLayoutArquivo = c.VersaoLayoutArquivo, VersaoLayoutLote = c.VersaoLayoutLote,
        SequencialArquivo = c.SequencialArquivo, Ativa = c.Ativa, DataCadastro = c.DataCadastro
    };

    private async Task SalvarAsync()
    {
        if (editando is null) return;
        mensagemErro = null;

        await using var ctx = await DbFactory.CreateDbContextAsync();
        var jaExiste = await ctx.ConfiguracoesCnab
            .AnyAsync(c => c.NomeConfiguracao == editando.NomeConfiguracao && c.Id != editando.Id);
        if (jaExiste)
        {
            mensagemErro = "Já existe configuração com este nome.";
            return;
        }

        if (editando.Id == 0)
        {
            editando.DataCadastro = DateTime.Now;
            ctx.ConfiguracoesCnab.Add(editando);
        }
        else
        {
            ctx.ConfiguracoesCnab.Update(editando);
        }
        await ctx.SaveChangesAsync();
        editando = null;
        await CarregarAsync();
    }

    private async Task AlternarAtivaAsync(ConfiguracaoCnab c)
    {
        var msg = c.Ativa ? "Deseja inativar esta configuração?" : "Deseja ativar esta configuração?";
        if (!await JS.InvokeAsync<bool>("confirm", msg)) return;

        await using var ctx = await DbFactory.CreateDbContextAsync();
        var entity = await ctx.ConfiguracoesCnab.FirstOrDefaultAsync(x => x.Id == c.Id);
        if (entity is not null)
        {
            entity.Ativa = !entity.Ativa;
            await ctx.SaveChangesAsync();
            await CarregarAsync();
        }
    }
}
