@page "/cnab-btg/historico"
@attribute [Authorize(Policy = "Cnab.Ver")]
@rendermode InteractiveServer

@using MinhaAplicacaoBlazor.CnabBtg
@inject CnabBtgGeracaoService CnabService
@inject IJSRuntime JS

<PageTitle>Histórico CNAB (BTG)</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Histórico CNAB — BTG</h1>
        <button class="btn btn-outline-secondary" @onclick="CarregarAsync" disabled="@carregando">Atualizar</button>
    </div>

    @if (carregando)
    {
        <p>Carregando...</p>
    }
    else if (historico.Count == 0)
    {
        <div class="alert alert-info">Nenhuma geração de CNAB registrada.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Gerado em</th>
                        <th>Empresa</th>
                        <th>Ambiente</th>
                        <th>NSA</th>
                        <th class="text-end">Arquivos</th>
                        <th class="text-end">Gerados</th>
                        <th class="text-end">Valor</th>
                        <th>Status</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in historico)
                    {
                        <tr>
                            <td>@h.BatchId</td>
                            <td>@h.GeradoEm.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@h.EmpresaPagadora</td>
                            <td><span class="badge @(h.Ambiente == "PRODUCAO" ? "bg-danger" : "bg-secondary")">@h.Ambiente</span></td>
                            <td>@h.NsaInicial–@h.NsaFinal</td>
                            <td class="text-end">@h.QuantidadeArquivos</td>
                            <td class="text-end">@h.TotalGerados</td>
                            <td class="text-end">@h.ValorTotal.ToString("C")</td>
                            <td><span class="badge @(h.Status == "GERADO" ? "bg-success" : "bg-warning text-dark")">@h.Status</span></td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => VerDetalheAsync(h.BatchId)">Detalhes</button>
                                @if (h.Status == "GERADO")
                                {
                                    <button class="btn btn-sm btn-success" @onclick="() => BaixarZipAsync(h.BatchId)">ZIP</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (detalhe is not null)
        {
            <div class="card mt-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Lote #@detalhe.Cabecalho.BatchId — @detalhe.NomeBaseArquivo</h4>
                    <button class="btn-close" @onclick="() => detalhe = null"></button>
                </div>
                <div class="card-body">
                    <div class="row g-2 mb-3">
                        <div class="col"><small class="text-muted d-block">Válidos</small><strong class="text-success">@detalhe.TotalValidos</strong></div>
                        <div class="col"><small class="text-muted d-block">Corrigidos</small><strong>@detalhe.TotalCorrigidos</strong></div>
                        <div class="col"><small class="text-muted d-block">Pendentes</small><strong class="text-warning">@detalhe.TotalPendentes</strong></div>
                        <div class="col"><small class="text-muted d-block">Inválidos</small><strong class="text-danger">@detalhe.TotalInvalidos</strong></div>
                        <div class="col"><small class="text-muted d-block">Convênio</small><strong>@detalhe.Convenio</strong></div>
                    </div>

                    <h6>Arquivos</h6>
                    <table class="table table-sm table-striped align-middle">
                        <thead class="table-dark">
                            <tr><th>Arquivo</th><th>NSA</th><th class="text-end">Operações</th><th class="text-end">Registros</th><th class="text-end">Valor</th><th>240?</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var a in detalhe.Arquivos)
                            {
                                <tr>
                                    <td>@a.FileName</td>
                                    <td>@a.Nsa</td>
                                    <td class="text-end">@a.Operacoes</td>
                                    <td class="text-end">@a.QuantidadeRegistros</td>
                                    <td class="text-end">@a.ValorTotal.ToString("C")</td>
                                    <td>@(a.TodasLinhas240 ? "✔" : "✖")</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <h6 class="mt-3">Pagamentos</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-striped align-middle">
                            <thead class="table-dark">
                                <tr><th>Origem</th><th>Nome</th><th>CPF/CNPJ</th><th class="text-end">Valor</th><th>Forma</th><th>Status</th><th>Status CNAB</th><th>Arquivo</th><th>Obs.</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var p in detalhe.Pagamentos)
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary">@p.Origem</span></td>
                                        <td>@p.Nome</td>
                                        <td>@p.CpfCnpj</td>
                                        <td class="text-end">@p.Valor.ToString("C")</td>
                                        <td>@p.Forma</td>
                                        <td><span class="badge @StatusBadge(p.Status)">@p.Status</span></td>
                                        <td>@p.StatusCnab</td>
                                        <td>@p.ArquivoDestino</td>
                                        <td><small>@p.Observacoes</small></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private List<CnabBtgHistoricoDto> historico = new();
    private CnabBtgBatchDetalheDto? detalhe;
    private bool carregando = true;

    protected override async Task OnInitializedAsync() => await CarregarAsync();

    private async Task CarregarAsync()
    {
        carregando = true;
        detalhe = null;
        historico = await CnabService.ObterHistoricoAsync();
        carregando = false;
    }

    private async Task VerDetalheAsync(int batchId)
        => detalhe = await CnabService.ObterDetalheAsync(batchId);

    private async Task BaixarZipAsync(int batchId)
    {
        var zip = await CnabService.ObterZipAsync(batchId);
        if (zip is null) return;
        var base64 = Convert.ToBase64String(zip.Value.Bytes);
        await JS.InvokeVoidAsync("baixarArquivoBase64", zip.Value.FileName, base64, "application/zip");
    }

    private static string StatusBadge(string status) => status switch
    {
        "Valido" => "bg-success",
        "CorrigidoAutomaticamente" => "bg-info text-dark",
        "PendenteDeConfirmacao" => "bg-warning text-dark",
        "Invalido" => "bg-danger",
        _ => "bg-secondary"
    };
}
