@using Microsoft.AspNetCore.Components.Authorization
@using MinhaAplicacaoBlazor.CnabBtg
@inject CnabBtgGeracaoService CnabService
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS

@if (visivel)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Gerar CNAB — Pagamentos Bancários</h5>
                    <button type="button" class="btn-close" @onclick="Fechar" disabled="@processando"></button>
                </div>
                <div class="modal-body">
                    @if (resultado is null)
                    {
                        @RenderFormulario
                    }
                    else
                    {
                        @RenderResultado
                    }
                </div>
                <div class="modal-footer">
                    @if (resultado is null)
                    {
                        <button class="btn btn-secondary" @onclick="Fechar" disabled="@processando">Cancelar</button>
                        <button class="btn btn-primary" @onclick="GerarAsync" disabled="@(processando || SelecionadosCount == 0)">
                            @if (processando) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Gerar CNAB (@SelecionadosCount)
                        </button>
                    }
                    else
                    {
                        @if (resultado.Status == "GERADO")
                        {
                            <button class="btn btn-success" @onclick="BaixarZipAsync">Baixar ZIP</button>
                        }
                        <button class="btn btn-secondary" @onclick="Fechar">Fechar</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int CompetenciaId { get; set; }

    private bool visivel;
    private bool processando;
    private bool carregando;
    private string? erro;

    private List<CnabBtgPagamentoDto> candidatos = new();
    private readonly HashSet<string> selecionados = new();
    private readonly CnabBtgGerarRequest form = new();
    private CnabBtgGeracaoResultadoDto? resultado;

    private int SelecionadosCount => selecionados.Count;

    private List<CnabBtgPagamentoResultadoDto> Problemas =>
        resultado?.Pagamentos.Where(p => p.Status is "Invalido" or "PendenteDeConfirmacao").ToList()
            ?? new();

    public async Task AbrirAsync(int competenciaId)
    {
        CompetenciaId = competenciaId;
        visivel = true;
        processando = false;
        carregando = true;
        erro = null;
        resultado = null;
        selecionados.Clear();
        StateHasChanged();

        try
        {
            candidatos = await CnabService.ObterPagamentosAsync(competenciaId);
            foreach (var c in candidatos.Where(c => !c.JaEmCnab))
                selecionados.Add(c.Chave);

            var user = (await AuthProvider.GetAuthenticationStateAsync()).User;

            form.CompetenciaId = competenciaId;
            form.DataPagamento = DateTime.Today;
            form.UsarNsaAutomatico = true;
            form.NsaInicial = null;
            form.NomeArquivo = $"pagamentos_{DateTime.Today:yyyy_MM_dd}";
            form.TipoPagamentoPrincipal = "PIX";
            form.Ambiente = "TESTE";
            form.BloquearSeHouverInvalidos = false;
            form.SepararLotesPorForma = false;
            form.EmpresaPagadora = CnabService.Empresas.FirstOrDefault()?.Codigo ?? "EDUNORTE";
            form.GeradoPor = user.Identity?.Name;
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
        finally
        {
            carregando = false;
            StateHasChanged();
        }
    }

    private void Fechar() => visivel = false;

    private void ToggleSelecionado(string chave, bool marcado)
    {
        if (marcado) selecionados.Add(chave);
        else selecionados.Remove(chave);
    }

    private void SelecionarTodos(bool marcar)
    {
        selecionados.Clear();
        if (marcar)
            foreach (var c in candidatos.Where(c => !c.JaEmCnab))
                selecionados.Add(c.Chave);
    }

    private decimal TotalSelecionado =>
        candidatos.Where(c => selecionados.Contains(c.Chave)).Sum(c => c.Valor);

    private async Task GerarAsync()
    {
        processando = true;
        erro = null;
        try
        {
            form.ChavesSelecionadas = selecionados.ToList();
            resultado = await CnabService.GerarAsync(form);
        }
        catch (Exception ex)
        {
            erro = ex.Message;
        }
        finally
        {
            processando = false;
        }
    }

    private async Task BaixarZipAsync()
    {
        if (resultado is null) return;
        var zip = await CnabService.ObterZipAsync(resultado.BatchId);
        if (zip is null) return;
        var base64 = Convert.ToBase64String(zip.Value.Bytes);
        await JS.InvokeVoidAsync("baixarArquivoBase64", zip.Value.FileName, base64, "application/zip");
    }

    private static string Moeda(decimal v) => v.ToString("C");

    private static string StatusBadge(string status) => status switch
    {
        "Valido" => "bg-success",
        "CorrigidoAutomaticamente" => "bg-info text-dark",
        "PendenteDeConfirmacao" => "bg-warning text-dark",
        "Invalido" => "bg-danger",
        _ => "bg-secondary"
    };

    private RenderFragment RenderFormulario => __builder =>
    {
        if (carregando)
        {
            <p>Carregando pagamentos...</p>
            return;
        }

        if (!string.IsNullOrEmpty(erro))
        {
            <div class="alert alert-danger">@erro</div>
        }

        <div class="row g-3 mb-3">
            <div class="col-md-3">
                <label class="form-label">Empresa Pagadora</label>
                <select class="form-select" @bind="form.EmpresaPagadora">
                    @foreach (var e in CnabService.Empresas)
                    {
                        <option value="@e.Codigo">@e.Codigo — @e.RazaoSocial</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Data de Pagamento</label>
                <InputDate class="form-control" @bind-Value="form.DataPagamento" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Tipo Principal</label>
                <select class="form-select" @bind="form.TipoPagamentoPrincipal">
                    <option value="PIX">PIX (45)</option>
                    <option value="01">Crédito em Conta (01)</option>
                    <option value="05">Poupança (05)</option>
                    <option value="41">TED Outra Titularidade (41)</option>
                    <option value="43">TED Mesma Titularidade (43)</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Ambiente</label>
                <select class="form-select" @bind="form.Ambiente">
                    <option value="TESTE">Teste</option>
                    <option value="PRODUCAO">Produção</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Nome base do arquivo</label>
                <input class="form-control" @bind="form.NomeArquivo" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Convênio (opcional)</label>
                <input class="form-control" @bind="form.Convenio" placeholder="padrão da empresa" />
            </div>
            <div class="col-md-3">
                <label class="form-label">NSA</label>
                <div class="form-check mt-1">
                    <InputCheckbox class="form-check-input" id="nsa-auto" @bind-Value="form.UsarNsaAutomatico" />
                    <label class="form-check-label" for="nsa-auto">Automático</label>
                </div>
                @if (!form.UsarNsaAutomatico)
                {
                    <input type="number" class="form-control mt-1" @bind="form.NsaInicial" placeholder="NSA inicial" />
                }
            </div>
            <div class="col-md-3 d-flex flex-column justify-content-end">
                <div class="form-check">
                    <InputCheckbox class="form-check-input" id="bloquear" @bind-Value="form.BloquearSeHouverInvalidos" />
                    <label class="form-check-label" for="bloquear">Bloquear se houver inválidos</label>
                </div>
                <div class="form-check">
                    <InputCheckbox class="form-check-input" id="separar" @bind-Value="form.SepararLotesPorForma" />
                    <label class="form-check-label" for="separar">Separar lotes por forma</label>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => SelecionarTodos(true)">Selecionar todos</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => SelecionarTodos(false)">Limpar</button>
            </div>
            <span class="fw-semibold">@SelecionadosCount selecionado(s) — @Moeda(TotalSelecionado)</span>
        </div>

        <div class="table-responsive" style="max-height: 40vh;">
            <table class="table table-sm table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th></th>
                        <th>Origem</th>
                        <th>Nome</th>
                        <th>CPF/CNPJ</th>
                        <th class="text-end">Valor</th>
                        <th>Forma</th>
                        <th>Banco</th>
                        <th>Ag.</th>
                        <th>Conta</th>
                        <th>Chave PIX</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in candidatos)
                    {
                        <tr class="@(c.JaEmCnab ? "table-warning" : "")">
                            <td>
                                <input type="checkbox" class="form-check-input"
                                       checked="@selecionados.Contains(c.Chave)"
                                       disabled="@c.JaEmCnab"
                                       @onchange="e => ToggleSelecionado(c.Chave, (bool)e.Value!)" />
                            </td>
                            <td><span class="badge bg-secondary">@c.Origem</span></td>
                            <td>@c.Nome @if (c.JaEmCnab) { <span class="badge bg-warning text-dark ms-1">já em CNAB</span> }</td>
                            <td>@c.CpfCnpj</td>
                            <td class="text-end">@Moeda(c.Valor)</td>
                            <td>@c.Forma</td>
                            <td>@c.Banco</td>
                            <td>@c.Agencia</td>
                            <td>@c.Conta</td>
                            <td>@c.ChavePix</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    };

    private RenderFragment RenderResultado => __builder =>
    {
        if (resultado is null) return;

        if (resultado.Status != "GERADO")
        {
            <div class="alert alert-danger">
                <strong>Geração bloqueada.</strong> @resultado.MotivoBloqueio
            </div>
        }
        else
        {
            <div class="alert alert-success">
                CNAB gerado (lote #@resultado.BatchId). Arquivo gerado conforme regras estruturais CNAB.
                A validação final deve ser feita no ambiente BTG.
            </div>
        }

        <div class="row g-2 mb-3">
            <div class="col"><div class="card border-secondary"><div class="card-body py-2"><small class="text-muted">Selecionados</small><h5 class="mb-0">@resultado.TotalSelecionados</h5></div></div></div>
            <div class="col"><div class="card border-success"><div class="card-body py-2"><small class="text-muted">Válidos</small><h5 class="mb-0 text-success">@resultado.TotalValidos</h5></div></div></div>
            <div class="col"><div class="card border-info"><div class="card-body py-2"><small class="text-muted">Corrigidos</small><h5 class="mb-0">@resultado.TotalCorrigidos</h5></div></div></div>
            <div class="col"><div class="card border-warning"><div class="card-body py-2"><small class="text-muted">Pendentes</small><h5 class="mb-0">@resultado.TotalPendentes</h5></div></div></div>
            <div class="col"><div class="card border-danger"><div class="card-body py-2"><small class="text-muted">Inválidos</small><h5 class="mb-0 text-danger">@resultado.TotalInvalidos</h5></div></div></div>
            <div class="col"><div class="card border-primary"><div class="card-body py-2"><small class="text-muted">NSA</small><h5 class="mb-0">@resultado.NsaInicial–@resultado.NsaFinal</h5></div></div></div>
        </div>

        @if (resultado.Arquivos.Count > 0)
        {
            <h6>Arquivos gerados</h6>
            <table class="table table-sm table-striped align-middle">
                <thead class="table-dark">
                    <tr><th>Arquivo</th><th>NSA</th><th class="text-end">Operações</th><th class="text-end">Registros</th><th class="text-end">Valor</th><th>240?</th></tr>
                </thead>
                <tbody>
                    @foreach (var a in resultado.Arquivos)
                    {
                        <tr>
                            <td>@a.FileName</td>
                            <td>@a.Nsa</td>
                            <td class="text-end">@a.Operacoes</td>
                            <td class="text-end">@a.QuantidadeRegistros</td>
                            <td class="text-end">@Moeda(a.ValorTotal)</td>
                            <td>@(a.TodasLinhas240 ? "✔" : "✖")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (Problemas.Count > 0)
        {
            <h6 class="mt-3">Pagamentos não gerados / pendentes</h6>
            <table class="table table-sm align-middle">
                <thead class="table-dark">
                    <tr><th>Origem</th><th>Nome</th><th class="text-end">Valor</th><th>Status</th><th>Observações</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in Problemas)
                    {
                        <tr>
                            <td>@p.Origem</td>
                            <td>@p.Nome</td>
                            <td class="text-end">@Moeda(p.Valor)</td>
                            <td><span class="badge @StatusBadge(p.Status)">@p.Status</span></td>
                            <td><small>@p.Observacoes</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    };
}
