@page "/tutores"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using MinhaAplicacaoBlazor.Data
@using MinhaAplicacaoBlazor.Models

@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Tutores</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Tutores</h1>
        <div class="d-flex gap-2 d-print-none">
            <button class="btn btn-outline-primary" @onclick="ImprimirAsync">
                Imprimir
            </button>
            <button class="btn btn-primary" @onclick="NovoTutor">
                Novo Tutor
            </button>
        </div>
    </div>

    <div class="d-none d-print-block mb-3">
        <h5 class="mb-1">Filtros aplicados</h5>
        <div>
            <strong>Pesquisa:</strong> @(string.IsNullOrWhiteSpace(filtroTexto) ? "—" : filtroTexto) &nbsp;|&nbsp;
            <strong>Unidade:</strong> @NomeUnidadeFiltro &nbsp;|&nbsp;
            <strong>Curso:</strong> @NomeCursoFiltro &nbsp;|&nbsp;
            <strong>Status:</strong> @StatusFiltro &nbsp;|&nbsp;
            <strong>Total:</strong> @TutoresFiltrados.Count() registro(s)
        </div>
    </div>

    <div class="row mb-3 g-2 d-print-none">
        <div class="col-md-4">
            <input type="text"
                   class="form-control"
                   placeholder="Pesquisar por nome ou CPF..."
                   @bind="filtroTexto"
                   @bind:event="oninput" />
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="filtroUnidadeId">
                <option value="0">Todas as Unidades</option>
                @foreach (var u in unidades)
                {
                    <option value="@u.Id">@u.Nome</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="filtroCursoId">
                <option value="0">Todos os Cursos</option>
                @foreach (var c in cursos)
                {
                    <option value="@c.Id">@c.NomeCurso</option>
                }
            </select>
        </div>
        <div class="col-md-1">
            <select class="form-select" @bind="filtroAtivo">
                <option value="">Todos</option>
                <option value="true">Ativos</option>
                <option value="false">Inativos</option>
            </select>
        </div>
        <div class="col-md-1">
            <select class="form-select" @bind="pagination.ItemsPerPage">
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>

    @if (tutores is null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <div class="table-responsive">
            <QuickGrid Items="TutoresFiltrados" Pagination="pagination" Class="table table-striped table-hover align-middle imprimivel-sem-acoes">
                <PropertyColumn Property="@(t => t.Nome)" Title="Nome" Sortable="true" InitialSortDirection="SortDirection.Ascending" IsDefaultSortColumn="true" />
                <PropertyColumn Property="@(t => t.Cpf)" Title="CPF" Sortable="true" />
                <PropertyColumn Property="@(t => t.Titulacao!.Nome)" Title="Titulação" Sortable="true" />
                <PropertyColumn Property="@(t => t.Unidade!.Nome)" Title="Unidade" Sortable="true" />
                <PropertyColumn Property="@(t => t.Curso!.NomeCurso)" Title="Curso" Sortable="true" />
                <PropertyColumn Property="@(t => t.Banco)" Title="Banco" Sortable="true" />
                <PropertyColumn Property="@(t => t.Agencia)" Title="Agência" />
                <PropertyColumn Property="@(t => t.Conta)" Title="Conta" />
                <TemplateColumn Title="Ativo" Sortable="true" SortBy="@sortPorAtivo" Align="Align.Center">
                    @if (context.Ativo)
                    {
                        <span class="badge bg-success">Sim</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Não</span>
                    }
                </TemplateColumn>
                <TemplateColumn Title="Ações" Align="Align.End">
                    <button class="btn btn-sm btn-secondary me-1"
                            @onclick="() => Editar(context.Id)">
                        Editar
                    </button>
                    <button class="btn btn-sm btn-danger"
                            @onclick="() => ExcluirAsync(context.Id)">
                        Excluir
                    </button>
                </TemplateColumn>
            </QuickGrid>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-2 d-print-none">
            <small class="text-muted">
                @(TutoresFiltrados.Count()) registro(s) encontrado(s)
            </small>
            <Paginator State="pagination" />
        </div>
    }
</div>

@code {
    private List<Tutor>? tutores;
    private List<Unidade> unidades = new();
    private List<Curso> cursos = new();
    private string filtroTexto = string.Empty;
    private int filtroUnidadeId;
    private int filtroCursoId;
    private string filtroAtivo = string.Empty;

    private readonly PaginationState pagination = new() { ItemsPerPage = 10 };

    private readonly GridSort<Tutor> sortPorAtivo = GridSort<Tutor>.ByAscending(t => t.Ativo);

    private IQueryable<Tutor> TutoresFiltrados
    {
        get
        {
            if (tutores is null)
                return Enumerable.Empty<Tutor>().AsQueryable();

            IEnumerable<Tutor> resultado = tutores;

            if (!string.IsNullOrWhiteSpace(filtroTexto))
            {
                var termo = filtroTexto.Trim();
                resultado = resultado.Where(t =>
                    t.Nome.Contains(termo, StringComparison.OrdinalIgnoreCase) ||
                    t.Cpf.Contains(termo, StringComparison.OrdinalIgnoreCase));
            }

            if (filtroUnidadeId > 0)
                resultado = resultado.Where(t => t.UnidadeId == filtroUnidadeId);

            if (filtroCursoId > 0)
                resultado = resultado.Where(t => t.CursoId == filtroCursoId);

            if (bool.TryParse(filtroAtivo, out var ativo))
                resultado = resultado.Where(t => t.Ativo == ativo);

            return resultado.AsQueryable();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CarregarDadosAsync();
    }

    private async Task CarregarDadosAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        tutores = await context.Tutores
            .AsNoTracking()
            .Include(t => t.Titulacao)
            .Include(t => t.Unidade)
            .Include(t => t.Curso)
            .OrderBy(t => t.Nome)
            .ToListAsync();

        unidades = await context.Unidades
            .AsNoTracking()
            .OrderBy(u => u.Nome)
            .ToListAsync();

        cursos = await context.Cursos
            .AsNoTracking()
            .OrderBy(c => c.NomeCurso)
            .ToListAsync();
    }

    private string NomeUnidadeFiltro =>
        filtroUnidadeId == 0
            ? "Todas"
            : unidades.FirstOrDefault(u => u.Id == filtroUnidadeId)?.Nome ?? "—";

    private string NomeCursoFiltro =>
        filtroCursoId == 0
            ? "Todos"
            : cursos.FirstOrDefault(c => c.Id == filtroCursoId)?.NomeCurso ?? "—";

    private string StatusFiltro => filtroAtivo switch
    {
        "true" => "Apenas Ativos",
        "false" => "Apenas Inativos",
        _ => "Todos"
    };

    private async Task ImprimirAsync()
    {
        var itensAnteriores = pagination.ItemsPerPage;
        await pagination.SetCurrentPageIndexAsync(0);
        pagination.ItemsPerPage = int.MaxValue;
        StateHasChanged();
        await Task.Yield();
        await JS.InvokeVoidAsync("window.print");
        pagination.ItemsPerPage = itensAnteriores;
    }

    private void NovoTutor()
    {
        Navigation.NavigateTo("/tutores/novo");
    }

    private void Editar(int id)
    {
        Navigation.NavigateTo($"/tutores/editar/{id}");
    }

    private async Task ExcluirAsync(int id)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", "Deseja realmente excluir este tutor?");

        if (!confirmado)
            return;

        await using var context = await DbFactory.CreateDbContextAsync();

        var entidade = await context.Tutores.FindAsync(id);

        if (entidade is not null)
        {
            context.Tutores.Remove(entidade);
            await context.SaveChangesAsync();
            await CarregarDadosAsync();
        }
    }
}
