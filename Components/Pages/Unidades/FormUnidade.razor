@page "/unidades/novo"
@attribute [Authorize(Policy = "Unidades.Ver")]
@page "/unidades/editar/{Id:int}"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using MinhaAplicacaoBlazor.Data
@using MinhaAplicacaoBlazor.Models

@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>@(IsNovo ? "Nova Unidade" : "Editar Unidade")</PageTitle>

<div class="container mt-4">
    <div class="card">
        <div class="card-header">
            <h3 class="mb-0">@(IsNovo ? "Nova Unidade" : "Editar Unidade")</h3>
        </div>
        <div class="card-body">
            @if (carregando)
            {
                <p>Carregando...</p>
            }
            else
            {
                <EditForm Model="unidade" OnValidSubmit="SalvarAsync" FormName="form-unidade">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />

                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Código</label>
                            <InputText class="form-control" @bind-Value="unidade.Codigo" />
                        </div>

                        <div class="col-md-9 mb-3">
                            <label class="form-label">Nome</label>
                            <InputText class="form-control" @bind-Value="unidade.Nome" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Endereço</label>
                            <InputText class="form-control" @bind-Value="unidade.Endereco" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Telefone</label>
                            <InputText class="form-control" @bind-Value="unidade.Telefone" />
                        </div>

                        <div class="col-md-4 mb-3 d-flex align-items-end">
                            <div class="form-check">
                                <InputCheckbox class="form-check-input" id="ativa-unidade" @bind-Value="unidade.Ativa" />
                                <label class="form-check-label" for="ativa-unidade">Ativa</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Salvar</button>
                        <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private Unidade unidade = new();
    private bool carregando = true;

    private bool IsNovo => Id is null or 0;

    protected override async Task OnInitializedAsync()
    {
        if (!IsNovo)
        {
            await using var context = await DbFactory.CreateDbContextAsync();

            var existente = await context.Unidades
                .AsNoTracking()
                .FirstOrDefaultAsync(u => u.Id == Id);

            if (existente is null)
            {
                Navigation.NavigateTo("/unidades");
                return;
            }

            unidade = existente;
        }

        carregando = false;
    }

    private async Task SalvarAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        if (IsNovo)
        {
            context.Unidades.Add(unidade);
        }
        else
        {
            context.Unidades.Update(unidade);
        }

        await context.SaveChangesAsync();

        Navigation.NavigateTo("/unidades");
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/unidades");
    }
}
