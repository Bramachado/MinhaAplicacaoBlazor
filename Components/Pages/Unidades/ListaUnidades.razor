@page "/unidades"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using MinhaAplicacaoBlazor.Data
@using MinhaAplicacaoBlazor.Models

@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Unidades</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Unidades</h1>
        <button class="btn btn-primary" @onclick="Nova">
            Nova Unidade
        </button>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <input type="text"
                   class="form-control"
                   placeholder="Pesquisar por nome..."
                   @bind="filtroNome"
                   @bind:event="oninput" />
        </div>
    </div>

    @if (unidades is null)
    {
        <p>Carregando...</p>
    }
    else if (!UnidadesFiltradas.Any())
    {
        <div class="alert alert-info">Nenhuma unidade encontrada.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Código</th>
                        <th>Nome</th>
                        <th>Endereço</th>
                        <th>Telefone</th>
                        <th>Ativa</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in UnidadesFiltradas)
                    {
                        <tr>
                            <td>@u.Codigo</td>
                            <td>@u.Nome</td>
                            <td>@u.Endereco</td>
                            <td>@u.Telefone</td>
                            <td>
                                @if (u.Ativa)
                                {
                                    <span class="badge bg-success">Sim</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Não</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-secondary me-1"
                                        @onclick="() => Editar(u.Id)">
                                    Editar
                                </button>
                                <button class="btn btn-sm btn-danger"
                                        @onclick="() => ExcluirAsync(u.Id)">
                                    Excluir
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Unidade>? unidades;
    private string filtroNome = string.Empty;

    private IEnumerable<Unidade> UnidadesFiltradas =>
        unidades is null
            ? Enumerable.Empty<Unidade>()
            : string.IsNullOrWhiteSpace(filtroNome)
                ? unidades
                : unidades.Where(u => u.Nome.Contains(filtroNome, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await CarregarDadosAsync();
    }

    private async Task CarregarDadosAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        unidades = await context.Unidades
            .AsNoTracking()
            .OrderBy(u => u.Nome)
            .ToListAsync();
    }

    private void Nova()
    {
        Navigation.NavigateTo("/unidades/novo");
    }

    private void Editar(int id)
    {
        Navigation.NavigateTo($"/unidades/editar/{id}");
    }

    private async Task ExcluirAsync(int id)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", "Deseja realmente excluir esta unidade?");

        if (!confirmado)
            return;

        await using var context = await DbFactory.CreateDbContextAsync();

        var entidade = await context.Unidades.FindAsync(id);

        if (entidade is not null)
        {
            context.Unidades.Remove(entidade);
            await context.SaveChangesAsync();
            await CarregarDadosAsync();
        }
    }
}
