@page "/cursos/novo"
@page "/cursos/editar/{Id:int}"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using MinhaAplicacaoBlazor.Data
@using MinhaAplicacaoBlazor.Models

@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>@(IsNovo ? "Novo Curso" : "Editar Curso")</PageTitle>

<div class="container mt-4">
    <div class="card">
        <div class="card-header">
            <h3 class="mb-0">@(IsNovo ? "Novo Curso" : "Editar Curso")</h3>
        </div>
        <div class="card-body">
            @if (carregando)
            {
                <p>Carregando...</p>
            }
            else
            {
                <EditForm Model="curso" OnValidSubmit="SalvarAsync" FormName="form-curso">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Nome do Curso</label>
                            <InputText class="form-control" @bind-Value="curso.NomeCurso" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Carga Horária Total</label>
                            <InputNumber class="form-control" @bind-Value="curso.CargaHorariaTotal" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Total de Anos</label>
                            <InputNumber class="form-control" @bind-Value="curso.TotalAnos" />
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Salvar</button>
                        <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private Curso curso = new();
    private bool carregando = true;

    private bool IsNovo => Id is null or 0;

    protected override async Task OnInitializedAsync()
    {
        if (!IsNovo)
        {
            await using var context = await DbFactory.CreateDbContextAsync();

            var existente = await context.Cursos
                .AsNoTracking()
                .FirstOrDefaultAsync(c => c.Id == Id);

            if (existente is null)
            {
                Navigation.NavigateTo("/cursos");
                return;
            }

            curso = existente;
        }

        carregando = false;
    }

    private async Task SalvarAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        if (IsNovo)
        {
            context.Cursos.Add(curso);
        }
        else
        {
            context.Cursos.Update(curso);
        }

        await context.SaveChangesAsync();

        Navigation.NavigateTo("/cursos");
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/cursos");
    }
}
