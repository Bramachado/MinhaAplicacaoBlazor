@page "/crm/contatos"
@attribute [Authorize(Policy = "CrmContatos.Ver")]
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using MinhaAplicacaoBlazor.Data
@using MinhaAplicacaoBlazor.Models.Crm
@using MinhaAplicacaoBlazor.Services.Auth

@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Contatos (CRM)</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Contatos</h1>
        <PermissaoView Requer="CrmContatos.Criar">
            <button class="btn btn-primary" @onclick="Novo">Novo Contato</button>
        </PermissaoView>
    </div>

    @if (!podeVerTodos)
    {
        <div class="alert alert-info py-2">Você está vendo apenas os contatos sob sua responsabilidade.</div>
    }

    <div class="row mb-3 g-2">
        <div class="col-md-6">
            <input type="text"
                   class="form-control"
                   placeholder="Pesquisar por nome, e-mail ou empresa..."
                   @bind="filtroTexto"
                   @bind:event="oninput" />
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="filtroSituacao">
                <option value="">Ativos e Inativos</option>
                <option value="true">Apenas Ativos</option>
                <option value="false">Apenas Inativos</option>
            </select>
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="pagination.ItemsPerPage">
                <option value="10">10 por página</option>
                <option value="25">25 por página</option>
                <option value="50">50 por página</option>
                <option value="100">100 por página</option>
            </select>
        </div>
    </div>

    @if (contatos is null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <div class="table-responsive">
            <QuickGrid Items="ContatosFiltrados" Pagination="@pagination.QuandoNecessario(ContatosFiltrados)" Class="table table-striped table-hover align-middle">
                <PropertyColumn Property="@(c => c.Nome)" Title="Nome" Sortable="true" InitialSortDirection="SortDirection.Ascending" IsDefaultSortColumn="true" />
                <PropertyColumn Property="@(c => c.EmpresaNome)" Title="Empresa" Sortable="true" />
                <PropertyColumn Property="@(c => c.Email)" Title="E-mail" Sortable="true" />
                <PropertyColumn Property="@(c => c.Telefone)" Title="Telefone" />
                <PropertyColumn Property="@(c => c.Origem)" Title="Origem" Sortable="true" />
                <PropertyColumn Property="@(c => c.ResponsavelNome)" Title="Responsável" Sortable="true" />
                <TemplateColumn Title="Situação" Sortable="true" SortBy="@sortPorAtivo" Align="Align.Center">
                    @if (context.Ativo)
                    {
                        <span class="badge bg-success">Ativo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inativo</span>
                    }
                </TemplateColumn>
                <TemplateColumn Title="Ações" Align="Align.End">
                    <PermissaoView Requer="CrmContatos.Editar">
                        <button class="btn btn-sm btn-outline-secondary me-1" title="Editar" @onclick="() => Editar(context.Id)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
                            </svg>
                        </button>
                    </PermissaoView>
                    <PermissaoView Requer="CrmContatos.Excluir">
                        <button class="btn btn-sm btn-outline-danger" title="Excluir" @onclick="() => ExcluirAsync(context.Id)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                            </svg>
                        </button>
                    </PermissaoView>
                </TemplateColumn>
            </QuickGrid>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-2">
            <small class="text-muted">@(ContatosFiltrados.Count()) registro(s) encontrado(s)</small>
            <Paginator State="pagination" />
        </div>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<CrmContato>? contatos;
    private string filtroTexto = string.Empty;
    private string filtroSituacao = string.Empty;
    private readonly PaginationState pagination = new() { ItemsPerPage = 25 };

    private readonly GridSort<CrmContato> sortPorAtivo = GridSort<CrmContato>.ByAscending(c => c.Ativo);

    private string? meuId;
    private bool podeVerTodos;

    private IQueryable<CrmContato> ContatosFiltrados
    {
        get
        {
            if (contatos is null)
                return Enumerable.Empty<CrmContato>().AsQueryable();

            IEnumerable<CrmContato> resultado = contatos;

            if (!string.IsNullOrWhiteSpace(filtroTexto))
            {
                var termo = filtroTexto.Trim();
                resultado = resultado.Where(c =>
                    c.Nome.Contains(termo, StringComparison.OrdinalIgnoreCase) ||
                    (c.Email != null && c.Email.Contains(termo, StringComparison.OrdinalIgnoreCase)) ||
                    (c.EmpresaNome != null && c.EmpresaNome.Contains(termo, StringComparison.OrdinalIgnoreCase)));
            }

            if (bool.TryParse(filtroSituacao, out var ativo))
                resultado = resultado.Where(c => c.Ativo == ativo);

            return resultado.AsQueryable();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            meuId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            podeVerTodos = user.Claims.Any(c =>
                c.Type == ClaimsPermissao.TipoPermissao && c.Value == "CrmContatos.VerTodos");
        }

        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        var query = context.CrmContatos.AsNoTracking();

        if (!podeVerTodos)
            query = query.Where(c => c.ResponsavelUserId == meuId);

        contatos = await query.OrderBy(c => c.Nome).ToListAsync();
    }

    private void Novo() => Navigation.NavigateTo("/crm/contatos/novo");
    private void Editar(int id) => Navigation.NavigateTo($"/crm/contatos/editar/{id}");

    private async Task ExcluirAsync(int id)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", "Deseja realmente excluir este contato?");
        if (!confirmado)
            return;

        var usuario = AuthState is null ? null : (await AuthState).User;
        await using var context = await DbFactory.CreateDbContextAsync(usuario);

        var entidade = await context.CrmContatos.FindAsync(id);
        if (entidade is null)
            return;

        var temOportunidades = await context.CrmOportunidades.AnyAsync(o => o.CrmContatoId == id);
        if (temOportunidades)
        {
            await JS.InvokeVoidAsync("alert", "Não é possível excluir: este contato possui oportunidades vinculadas.");
            return;
        }

        context.CrmContatos.Remove(entidade);
        await context.SaveChangesAsync();
        await CarregarAsync();
    }
}
