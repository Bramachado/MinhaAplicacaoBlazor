@page "/crm/oportunidades/novo"
@attribute [Authorize(Policy = "CrmOportunidades.Ver")]
@page "/crm/oportunidades/editar/{Id:int}"
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using MinhaAplicacaoBlazor.Data
@using MinhaAplicacaoBlazor.Models.Crm
@using MinhaAplicacaoBlazor.Services.Auth

@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>@(IsNovo ? "Nova Oportunidade" : "Editar Oportunidade")</PageTitle>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header">
            <h3 class="mb-0">@(IsNovo ? "Nova Oportunidade" : "Editar Oportunidade")</h3>
        </div>
        <div class="card-body">
            @if (carregando)
            {
                <p>Carregando...</p>
            }
            else
            {
                <EditForm Model="oportunidade" OnValidSubmit="SalvarAsync" FormName="form-crm-oportunidade">
                    <DataAnnotationsValidator />

                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label class="form-label">Título <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="oportunidade.Titulo" />
                            <ValidationMessage For="@(() => oportunidade.Titulo)" class="text-danger small" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Valor (R$)</label>
                            <InputNumber class="form-control" @bind-Value="oportunidade.Valor" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Contato <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="oportunidade.CrmContatoId">
                                <option value="0">-- Selecione --</option>
                                @foreach (var c in contatos)
                                {
                                    <option value="@c.Id">@c.Nome @(string.IsNullOrWhiteSpace(c.EmpresaNome) ? "" : $"({c.EmpresaNome})")</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Etapa <span class="text-danger">*</span></label>
                            <InputSelect class="form-select" @bind-Value="oportunidade.CrmEtapaFunilId">
                                <option value="0">-- Selecione --</option>
                                @foreach (var e in etapas)
                                {
                                    <option value="@e.Id">@e.Nome</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Status</label>
                            <InputSelect class="form-select" @bind-Value="oportunidade.Status">
                                <option value="@StatusOportunidade.Aberta">Aberta</option>
                                <option value="@StatusOportunidade.Ganha">Ganha</option>
                                <option value="@StatusOportunidade.Perdida">Perdida</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Previsão de fechamento</label>
                            <InputDate class="form-control" @bind-Value="oportunidade.DataPrevisao" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Data de fechamento</label>
                            <InputDate class="form-control" @bind-Value="oportunidade.DataFechamento" />
                        </div>
                    </div>

                    @if (oportunidade.Status == StatusOportunidade.Perdida)
                    {
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label class="form-label">Motivo da perda</label>
                                <InputText class="form-control" @bind-Value="oportunidade.MotivoPerda" />
                            </div>
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Descrição</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="oportunidade.Descricao" />
                        </div>
                    </div>

                    @if (!IsNovo && !string.IsNullOrWhiteSpace(oportunidade.ResponsavelNome))
                    {
                        <p class="text-muted small">Responsável: <strong>@oportunidade.ResponsavelNome</strong></p>
                    }

                    @if (!string.IsNullOrEmpty(mensagemErro))
                    {
                        <div class="alert alert-danger">@mensagemErro</div>
                    }

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary" disabled="@salvando">
                            @(salvando ? "Salvando..." : "Salvar")
                        </button>
                        <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private CrmOportunidade oportunidade = new();
    private List<CrmContato> contatos = new();
    private List<CrmEtapaFunil> etapas = new();

    private bool carregando = true;
    private bool salvando;
    private string? mensagemErro;

    private string? meuId;
    private string meuNome = string.Empty;
    private bool podeVerTodos;

    private bool IsNovo => Id is null or 0;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            meuId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            meuNome = user.FindFirst("nome_completo")?.Value ?? user.Identity?.Name ?? "Desconhecido";
            podeVerTodos = user.Claims.Any(c =>
                c.Type == ClaimsPermissao.TipoPermissao && c.Value == "CrmOportunidades.VerTodos");
        }

        await using var context = await DbFactory.CreateDbContextAsync();

        etapas = await context.CrmEtapasFunil.AsNoTracking()
            .Where(e => e.Ativa)
            .OrderBy(e => e.Ordem)
            .ToListAsync();

        var contatosQuery = context.CrmContatos.AsNoTracking().Where(c => c.Ativo);
        var podeVerTodosContatos = AuthState is not null &&
            (await AuthState).User.Claims.Any(c =>
                c.Type == ClaimsPermissao.TipoPermissao && c.Value == "CrmContatos.VerTodos");
        if (!podeVerTodosContatos)
            contatosQuery = contatosQuery.Where(c => c.ResponsavelUserId == meuId);
        contatos = await contatosQuery.OrderBy(c => c.Nome).ToListAsync();

        if (!IsNovo)
        {
            var existente = await context.CrmOportunidades.AsNoTracking().FirstOrDefaultAsync(o => o.Id == Id);

            if (existente is null || (!podeVerTodos && existente.ResponsavelUserId != meuId))
            {
                Navigation.NavigateTo("/crm/oportunidades");
                return;
            }

            oportunidade = existente;
        }
        else
        {
            oportunidade.Status = StatusOportunidade.Aberta;
            if (etapas.Count > 0)
                oportunidade.CrmEtapaFunilId = etapas[0].Id;
        }

        carregando = false;
    }

    private async Task SalvarAsync()
    {
        mensagemErro = null;

        if (oportunidade.CrmContatoId == 0)
        {
            mensagemErro = "Selecione um contato.";
            return;
        }

        if (oportunidade.CrmEtapaFunilId == 0)
        {
            mensagemErro = "Selecione uma etapa.";
            return;
        }

        salvando = true;
        try
        {
            var usuario = AuthState is null ? null : (await AuthState).User;
            await using var context = await DbFactory.CreateDbContextAsync(usuario);

            if (IsNovo)
            {
                oportunidade.ResponsavelUserId = meuId;
                oportunidade.ResponsavelNome = meuNome;
                context.CrmOportunidades.Add(oportunidade);
            }
            else
            {
                context.CrmOportunidades.Update(oportunidade);
            }

            await context.SaveChangesAsync();
            Navigation.NavigateTo("/crm/oportunidades");
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro ao salvar: {ex.Message}";
        }
        finally
        {
            salvando = false;
        }
    }

    private void Cancelar() => Navigation.NavigateTo("/crm/oportunidades");
}
