@page "/crm/etapas"
@attribute [Authorize(Policy = "CrmFunil.Ver")]
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using MinhaAplicacaoBlazor.Data
@using MinhaAplicacaoBlazor.Models.Crm

@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Etapas do Funil (CRM)</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Etapas do Funil</h1>
        <PermissaoView Requer="CrmFunil.Criar">
            <button class="btn btn-primary" @onclick="Nova">Nova Etapa</button>
        </PermissaoView>
    </div>

    @if (etapas is null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th style="width:90px">Ordem</th>
                        <th>Nome</th>
                        <th style="width:120px">Cor</th>
                        <th class="text-center" style="width:120px">Situação</th>
                        <th class="text-end" style="width:140px">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in etapas)
                    {
                        <tr>
                            <td>@e.Ordem</td>
                            <td>@e.Nome</td>
                            <td>
                                <span class="badge" style="background-color:@(string.IsNullOrWhiteSpace(e.Cor) ? "#6c757d" : e.Cor)">
                                    @(e.Cor ?? "—")
                                </span>
                            </td>
                            <td class="text-center">
                                @if (e.Ativa)
                                {
                                    <span class="badge bg-success">Ativa</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inativa</span>
                                }
                            </td>
                            <td class="text-end">
                                <PermissaoView Requer="CrmFunil.Editar">
                                    <button class="btn btn-sm btn-outline-secondary me-1" title="Editar" @onclick="() => Editar(e.Id)">Editar</button>
                                </PermissaoView>
                                <PermissaoView Requer="CrmFunil.Excluir">
                                    <button class="btn btn-sm btn-outline-danger" title="Excluir" @onclick="() => ExcluirAsync(e.Id)">Excluir</button>
                                </PermissaoView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <small class="text-muted">@etapas.Count etapa(s)</small>
    }
</div>

@code {
    private List<CrmEtapaFunil>? etapas;

    protected override async Task OnInitializedAsync() => await CarregarAsync();

    private async Task CarregarAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        etapas = await context.CrmEtapasFunil
            .AsNoTracking()
            .OrderBy(e => e.Ordem)
            .ThenBy(e => e.Nome)
            .ToListAsync();
    }

    private void Nova() => Navigation.NavigateTo("/crm/etapas/novo");
    private void Editar(int id) => Navigation.NavigateTo($"/crm/etapas/editar/{id}");

    private async Task ExcluirAsync(int id)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", "Deseja realmente excluir esta etapa?");
        if (!confirmado)
            return;

        await using var context = await DbFactory.CreateDbContextAsync();

        var emUso = await context.CrmOportunidades.AnyAsync(o => o.CrmEtapaFunilId == id);
        if (emUso)
        {
            await JS.InvokeVoidAsync("alert", "Não é possível excluir: existem oportunidades nesta etapa.");
            return;
        }

        var etapa = await context.CrmEtapasFunil.FindAsync(id);
        if (etapa is not null)
        {
            context.CrmEtapasFunil.Remove(etapa);
            await context.SaveChangesAsync();
            await CarregarAsync();
        }
    }
}
