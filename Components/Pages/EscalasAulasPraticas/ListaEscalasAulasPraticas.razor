@page "/escalas-aulas-praticas"
@attribute [Authorize(Policy = "EscalasAulasPraticas.Ver")]
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using MinhaAplicacaoBlazor.Data
@using MinhaAplicacaoBlazor.Models

@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Escalas de Aula Prática</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Escalas de Aula Prática</h1>
        <div class="d-flex gap-2 d-print-none">
            <button class="btn btn-outline-primary" @onclick="ImprimirAsync">
                Imprimir
            </button>
            <PermissaoView Requer="EscalasAulasPraticas.Criar">
                <button class="btn btn-primary" @onclick="Nova">
                    Nova Escala
                </button>
            </PermissaoView>
        </div>
    </div>

    <div class="d-none d-print-block mb-3">
        <h5 class="mb-1">Filtros aplicados</h5>
        <div>
            <strong>Pesquisa:</strong> @(string.IsNullOrWhiteSpace(filtroTexto) ? "—" : filtroTexto) &nbsp;|&nbsp;
            <strong>Unidade:</strong> @NomeUnidadeFiltro &nbsp;|&nbsp;
            <strong>Mês:</strong> @(string.IsNullOrWhiteSpace(filtroMes) ? "—" : filtroMes) &nbsp;|&nbsp;
            <strong>Status:</strong> @StatusFiltro &nbsp;|&nbsp;
            <strong>Total:</strong> @EscalasFiltradas.Count() registro(s)
        </div>
    </div>

    <div class="row mb-3 g-2 d-print-none">
        <div class="col-md-4">
            <input type="text"
                   class="form-control"
                   placeholder="Pesquisar por tutor, curso/turma ou sala..."
                   @bind="filtroTexto"
                   @bind:event="oninput" />
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="filtroUnidadeId">
                <option value="0">Todas as Unidades</option>
                @foreach (var u in unidades)
                {
                    <option value="@u.Id">@u.Nome</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <input type="text"
                   class="form-control"
                   placeholder="Mês (MM/AAAA)"
                   @bind="filtroMes"
                   @bind:event="oninput" />
        </div>
        <div class="col-md-2">
            <select class="form-select" @bind="filtroAtivo">
                <option value="">Ativos e Inativos</option>
                <option value="true">Apenas Ativos</option>
                <option value="false">Apenas Inativos</option>
            </select>
        </div>
        <div class="col-md-1">
            <select class="form-select" @bind="pagination.ItemsPerPage">
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>

    @if (escalas is null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <div class="table-responsive">
            <QuickGrid Items="EscalasFiltradas" Pagination="@pagination.QuandoNecessario(EscalasFiltradas)" Class="table table-striped table-hover align-middle imprimivel-sem-acoes">
                <PropertyColumn Property="@(e => e.Tutor!.Nome)" Title="Tutor" Sortable="true" InitialSortDirection="SortDirection.Ascending" IsDefaultSortColumn="true" />
                <PropertyColumn Property="@(e => e.Tutor!.Unidade!.Nome)" Title="Unidade" Sortable="true" />
                <PropertyColumn Property="@(e => e.MesAulaPratica)" Title="Mês Aula Prática" Sortable="true" />
                <PropertyColumn Property="@(e => e.CursoTurma)" Title="Curso/Turma" Sortable="true" />
                <PropertyColumn Property="@(e => e.SalaLab)" Title="Sala/Lab" Sortable="true" />
                <PropertyColumn Property="@(e => e.DiaSemana)" Title="Dia da Semana" Sortable="true" />
                <TemplateColumn Title="Hora Início" Sortable="true" SortBy="@sortPorHoraInicio">
                    @context.HoraInicio.ToString(@"hh\:mm")
                </TemplateColumn>
                <TemplateColumn Title="Hora Fim" Sortable="true" SortBy="@sortPorHoraFim">
                    @context.HoraFim.ToString(@"hh\:mm")
                </TemplateColumn>
                <TemplateColumn Title="Ativo" Sortable="true" SortBy="@sortPorAtivo" Align="Align.Center">
                    @if (context.Ativo)
                    {
                        <span class="badge bg-success">Sim</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Não</span>
                    }
                </TemplateColumn>
                <TemplateColumn Title="Ações" Align="Align.End">
                    <PermissaoView Requer="EscalasAulasPraticas.Editar">
                        <button class="btn btn-sm btn-outline-secondary me-1"
                                title="Editar"
                                @onclick="() => Editar(context.Id)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
                            </svg>
                        </button>
                    </PermissaoView>
                    <PermissaoView Requer="EscalasAulasPraticas.Excluir">
                        <button class="btn btn-sm btn-outline-danger"
                                title="Excluir"
                                @onclick="() => ExcluirAsync(context.Id)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                            </svg>
                        </button>
                    </PermissaoView>
                </TemplateColumn>
            </QuickGrid>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-2 d-print-none">
            <small class="text-muted">
                @(EscalasFiltradas.Count()) registro(s) encontrado(s)
            </small>
            <Paginator State="pagination" />
        </div>
    }
</div>

@code {
    private List<EscalaAulaPratica>? escalas;
    private List<Unidade> unidades = new();
    private string filtroTexto = string.Empty;
    private int filtroUnidadeId;
    private string filtroMes = string.Empty;
    private string filtroAtivo = string.Empty;
    private readonly PaginationState pagination = new() { ItemsPerPage = 10 };
    private readonly GridSort<EscalaAulaPratica> sortPorHoraInicio = GridSort<EscalaAulaPratica>.ByAscending(e => e.HoraInicio);
    private readonly GridSort<EscalaAulaPratica> sortPorHoraFim = GridSort<EscalaAulaPratica>.ByAscending(e => e.HoraFim);
    private readonly GridSort<EscalaAulaPratica> sortPorAtivo = GridSort<EscalaAulaPratica>.ByAscending(e => e.Ativo);

    private IQueryable<EscalaAulaPratica> EscalasFiltradas
    {
        get
        {
            if (escalas is null)
                return Enumerable.Empty<EscalaAulaPratica>().AsQueryable();

            IEnumerable<EscalaAulaPratica> resultado = escalas;

            if (!string.IsNullOrWhiteSpace(filtroTexto))
            {
                var termo = filtroTexto.Trim();
                resultado = resultado.Where(e =>
                    (e.Tutor != null && e.Tutor.Nome.Contains(termo, StringComparison.OrdinalIgnoreCase)) ||
                    (e.CursoTurma != null && e.CursoTurma.Contains(termo, StringComparison.OrdinalIgnoreCase)) ||
                    (e.SalaLab != null && e.SalaLab.Contains(termo, StringComparison.OrdinalIgnoreCase)));
            }

            if (filtroUnidadeId > 0)
                resultado = resultado.Where(e =>
                    e.Tutor != null && e.Tutor.UnidadeId == filtroUnidadeId);

            if (!string.IsNullOrWhiteSpace(filtroMes))
                resultado = resultado.Where(e =>
                    e.MesAulaPratica.Contains(filtroMes.Trim(), StringComparison.OrdinalIgnoreCase));

            if (bool.TryParse(filtroAtivo, out var ativo))
                resultado = resultado.Where(e => e.Ativo == ativo);

            return resultado.AsQueryable();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CarregarDadosAsync();
    }

    private async Task CarregarDadosAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        escalas = await context.EscalasAulasPraticas
            .AsNoTracking()
            .Include(e => e.Tutor)
                .ThenInclude(t => t!.Unidade)
            .OrderBy(e => e.Tutor!.Nome)
            .ThenBy(e => e.MesAulaPratica)
            .ThenBy(e => e.DiaSemana)
            .ToListAsync();

        unidades = await context.Unidades
            .AsNoTracking()
            .OrderBy(u => u.Nome)
            .ToListAsync();
    }

    private string NomeUnidadeFiltro =>
        filtroUnidadeId == 0
            ? "Todas"
            : unidades.FirstOrDefault(u => u.Id == filtroUnidadeId)?.Nome ?? "—";

    private string StatusFiltro => filtroAtivo switch
    {
        "true" => "Apenas Ativos",
        "false" => "Apenas Inativos",
        _ => "Todos"
    };

    private async Task ImprimirAsync()
    {
        var itensAnteriores = pagination.ItemsPerPage;
        await pagination.SetCurrentPageIndexAsync(0);
        pagination.ItemsPerPage = int.MaxValue;
        StateHasChanged();
        await Task.Yield();
        await JS.InvokeVoidAsync("window.print");
        pagination.ItemsPerPage = itensAnteriores;
    }

    private void Nova()
    {
        Navigation.NavigateTo("/escalas-aulas-praticas/novo");
    }

    private void Editar(int id)
    {
        Navigation.NavigateTo($"/escalas-aulas-praticas/editar/{id}");
    }

    private async Task ExcluirAsync(int id)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", "Deseja realmente excluir esta escala?");

        if (!confirmado)
            return;

        await using var context = await DbFactory.CreateDbContextAsync();

        var entidade = await context.EscalasAulasPraticas.FindAsync(id);

        if (entidade is not null)
        {
            context.EscalasAulasPraticas.Remove(entidade);
            await context.SaveChangesAsync();
            await CarregarDadosAsync();
        }
    }
}
