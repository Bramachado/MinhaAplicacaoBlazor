@page "/folha-fornecedores-2"
@attribute [Authorize(Policy = "RelatoriosFinanceiros.Ver")]
@rendermode InteractiveServer

@using System.Text
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using MinhaAplicacaoBlazor.Data
@using MinhaAplicacaoBlazor.Models
@using MinhaAplicacaoBlazor.Models.Reports
@using MinhaAplicacaoBlazor.Services

@inject RelatorioFinanceiroService Service
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Folha de Fornecedores 2</PageTitle>

<style>
    /* Impede quebra de linha nas células da grade: as colunas expandem conforme
       o conteúdo e a rolagem horizontal aparece para ver as últimas colunas. */
    .grid-ff2 {
        overflow-x: auto;
        max-height: 70vh;
    }

    .grid-ff2 table {
        width: auto;
        min-width: 100%;
    }

    .grid-ff2 th,
    .grid-ff2 td {
        white-space: nowrap;
    }

    /* Cabeçalho fixo ao rolar verticalmente. */
    .grid-ff2 thead th {
        position: sticky;
        top: 0;
        z-index: 1;
    }
</style>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Relatório de Pagamento de Fornecedores</h1>
    </div>

    <div class="card mb-3 d-print-none">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Competência</label>
                    <select class="form-select" @bind="competenciaSelecionadaId">
                        <option value="0">-- Selecione --</option>
                        @foreach (var c in competencias)
                        {
                            <option value="@c.Id">@c.TextoExibicao</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Tipo de Pagamento</label>
                    <select class="form-select" @bind="tipoPagamento">
                        <option value="Todos">Todos</option>
                        <option value="Boleto">Boleto</option>
                        <option value="Transferencia">Transferência</option>
                    </select>
                </div>
                <div class="col-md-6 d-flex flex-wrap gap-2">
                    <button class="btn btn-primary" @onclick="GerarAsync" disabled="@processando">
                        @if (processando) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Gerar Relatório
                    </button>
                    <button class="btn btn-secondary" @onclick="Limpar">Limpar</button>
                    <button class="btn btn-success" @onclick="ExportarExcelAsync" disabled="@(!gerado || QuantidadeSelecionadas == 0)">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-1" style="vertical-align:-2px;">
                            <path d="M5.884 6.68a.5.5 0 1 0-.768.64L7.349 10l-2.233 2.68a.5.5 0 0 0 .768.64L8 10.781l2.116 2.54a.5.5 0 0 0 .768-.641L8.651 10l2.233-2.68a.5.5 0 0 0-.768-.64L8 9.219z"/>
                            <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5z"/>
                        </svg>
                        Exportar Excel (@QuantidadeSelecionadas)
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(mensagemErro))
            {
                <div class="alert alert-danger mt-3 mb-0">@mensagemErro</div>
            }
        </div>
    </div>

    @if (!gerado)
    {
        <div class="alert alert-info">Selecione uma competência e clique em <strong>Gerar Relatório</strong>.</div>
    }
    else if (linhas.Count == 0)
    {
        <div class="alert alert-warning">Nenhum item encontrado para esta competência com o filtro selecionado.</div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="text-muted">
                @linhas.Count linha(s) • @QuantidadeSelecionadas selecionada(s) •
                Total selecionado: <strong>@Moeda(TotalSelecionado)</strong>
            </div>
        </div>

        <div class="table-responsive grid-ff2">
            <table class="table table-striped table-hover table-sm align-middle">
                <thead class="table-dark">
                    <tr>
                        <th style="width:38px;" class="text-center">
                            <input type="checkbox" class="form-check-input" checked="@TodosSelecionados" @onchange="AlternarTodos" title="Selecionar todos" />
                        </th>
                        <th style="width:38px;" class="text-center">Detalhes</th>
                        @foreach (var col in Colunas)
                        {
                            <th role="button" class="user-select-none @(col.Numerico ? "text-end" : "")" @onclick="() => Ordenar(col.Chave)">
                                @col.Titulo @Seta(col.Chave)
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in linhas)
                    {
                        <tr class="@(l.Selecionado ? "table-active" : "")">
                            <td class="text-center">
                                <input type="checkbox" class="form-check-input" @bind="l.Selecionado" />
                            </td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-primary" title="Visualizar detalhes"
                                        @onclick="() => VisualizarItemAsync(l.ItemId)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                                        <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                                    </svg>
                                </button>
                            </td>
                            <td>@l.Fornecedor</td>
                            <td>@l.CpfCnpjFornecedor</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(l.TipoPagamento))
                                {
                                    <span class="badge @TipoPagamentoBadge(l.TipoPagamento!)">@l.TipoPagamento</span>
                                }
                            </td>
                            <td class="text-end fw-semibold">@Moeda(l.ValorTotalPagar)</td>
                            <td>@l.BancoPagador</td>
                            <td>@l.NomeTitular</td>
                            <td>@l.CpfCnpjConta</td>
                            <td>@l.Forma</td>
                            <td>@l.TipoPessoa</td>
                            <td>@l.TipoChavePix</td>
                            <td>@l.ChavePix</td>
                            <td>@l.CodigoBanco</td>
                            <td>@l.NomeBanco</td>
                            <td>@l.Agencia</td>
                            <td>@l.Conta</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <th colspan="6" class="text-end">Total selecionado</th>
                        <th colspan="11"></th>
                    </tr>
                    <tr>
                        <td colspan="5"></td>
                        <td class="text-end fw-bold">@Moeda(TotalSelecionado)</td>
                        <td colspan="11"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>

@if (itemDetalhe is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Detalhes do Item — @itemDetalhe.Fornecedor?.NomeRazaoSocial</h5>
                    <button type="button" class="btn-close" @onclick="FecharDetalhe"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted mb-0">Fornecedor</label>
                            <div class="fw-semibold">@itemDetalhe.Fornecedor?.NomeRazaoSocial</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">CPF/CNPJ</label>
                            <div>@(itemDetalhe.Fornecedor?.CpfCnpj ?? "—")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Status Pagamento</label>
                            <div>@(itemDetalhe.StatusPagamento ?? "—")</div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label text-muted mb-0">Tipo de Pagamento</label>
                            <div>@(itemDetalhe.TipoPagamento ?? "—")</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted mb-0">Banco Pagador</label>
                            <div>@(itemDetalhe.BancoPagador?.NomeBanco ?? "—")</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted mb-0">Data Vencimento</label>
                            <div>@(itemDetalhe.DataVencimento?.ToString("dd/MM/yyyy") ?? "—")</div>
                        </div>

                        <div class="col-12">
                            <label class="form-label text-muted mb-0">Descrição</label>
                            <div>@(itemDetalhe.Descricao ?? "—")</div>
                        </div>

                        <div class="col-12"><hr class="my-1" /></div>

                        <div class="col-12">
                            <label class="form-label text-muted mb-2">Notas deste pagamento</label>
                            @if (itemDetalhe.Notas.Count == 0)
                            {
                                <div class="text-muted">Nenhuma nota lançada.</div>
                            }
                            else
                            {
                                <table class="table table-sm table-striped align-middle mb-0">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Nº Documento / NF</th>
                                            <th>Descrição</th>
                                            <th class="text-end">Valor</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var n in itemDetalhe.Notas)
                                        {
                                            <tr>
                                                <td>@(n.NumeroDocumento ?? "—")</td>
                                                <td>@(n.Descricao ?? "—")</td>
                                                <td class="text-end">@n.Valor.ToString("C")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                        <div class="col-12">
                            <label class="form-label text-muted mb-0">Valor Total a Pagar</label>
                            <div class="fw-semibold text-primary">@itemDetalhe.ValorTotalPagar.ToString("C")</div>
                        </div>

                        <div class="col-12"><hr class="my-1" /></div>

                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Banco</label>
                            <div>@(itemDetalhe.Banco ?? "—")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Agência</label>
                            <div>@(itemDetalhe.Agencia ?? "—")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Conta</label>
                            <div>@(itemDetalhe.Conta ?? "—")</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted mb-0">Chave PIX</label>
                            <div>@(itemDetalhe.ChavePix ?? "—")</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted mb-0">Nome do Titular da Conta</label>
                            <div>@(itemDetalhe.NomeTitularConta ?? "—")</div>
                        </div>

                        <div class="col-12"><hr class="my-1" /></div>

                        <div class="col-12">
                            <label class="form-label text-muted mb-0">Observação</label>
                            <div style="white-space:pre-wrap;">@(string.IsNullOrWhiteSpace(itemDetalhe.Observacao) ? "—" : itemDetalhe.Observacao)</div>
                        </div>
                    </div>

                    <hr />
                    <h6 class="mb-2">Anexos</h6>
                    @if (anexosDetalhe.Count == 0)
                    {
                        <div class="alert alert-info mb-0">Nenhum anexo para este item.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-striped align-middle mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Data</th>
                                        <th>Descrição</th>
                                        <th>Arquivo</th>
                                        <th class="text-end">Tamanho</th>
                                        <th class="text-end">Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in anexosDetalhe)
                                    {
                                        <tr>
                                            <td>@a.Data.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@a.Descricao</td>
                                            <td>@a.NomeArquivo</td>
                                            <td class="text-end">@FormatarTamanho(a.TamanhoBytes)</td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-outline-primary" title="Visualizar anexo"
                                                        @onclick="() => VisualizarAnexoAsync(a.Id)">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                                        <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                                                        <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                                                    </svg>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharDetalhe">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (anexoVisualizado is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6); z-index: 1080;">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @anexoVisualizado.Descricao
                        <small class="text-muted d-block">@anexoVisualizado.NomeArquivo</small>
                    </h5>
                    <button type="button" class="btn-close" @onclick="FecharAnexo"></button>
                </div>
                <div class="modal-body text-center" style="min-height: 60vh;">
                    @if (IsImagem(anexoVisualizado.ContentType))
                    {
                        <img src="@anexoDataUrl" alt="@anexoVisualizado.NomeArquivo" class="img-fluid" style="max-height: 75vh;" />
                    }
                    else if (IsPdf(anexoVisualizado.ContentType))
                    {
                        <iframe src="@anexoDataUrl" style="width: 100%; height: 75vh; border: none;" title="@anexoVisualizado.NomeArquivo"></iframe>
                    }
                    else
                    {
                        <p class="text-muted">Pré-visualização não disponível para este tipo de arquivo.</p>
                    }
                </div>
                <div class="modal-footer">
                    <a class="btn btn-outline-primary me-auto" href="@anexoDataUrl" download="@anexoVisualizado.NomeArquivo">Baixar</a>
                    <button type="button" class="btn btn-secondary" @onclick="FecharAnexo">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CompetenciaSelecaoDto> competencias = new();
    private int competenciaSelecionadaId;
    private string tipoPagamento = "Todos";
    private bool processando;
    private bool gerado;
    private string? mensagemErro;

    private List<FolhaFornecedor2LinhaDto> linhas = new();

    private string? colunaOrdenacao;
    private bool ordemAsc = true;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private FolhaFornecedorItem? itemDetalhe;
    private List<Arquivo> anexosDetalhe = new();
    private Arquivo? anexoVisualizado;
    private string? anexoDataUrl;

    // Definição das colunas ordenáveis (rótulo, chave de ordenação e alinhamento).
    private sealed record Coluna(string Chave, string Titulo, Func<FolhaFornecedor2LinhaDto, object?> Selector, bool Numerico = false);

    private static readonly Coluna[] Colunas =
    {
        new("Fornecedor",        "Fornecedor",       l => l.Fornecedor),
        new("CpfCnpjFornecedor", "CPF/CNPJ",         l => l.CpfCnpjFornecedor),
        new("TipoPagamento",     "Tipo Pagamento",   l => l.TipoPagamento),
        new("ValorTotalPagar",   "Valor a Pagar",    l => l.ValorTotalPagar, true),
        new("BancoPagador",      "Banco Pagador",    l => l.BancoPagador),
        new("NomeTitular",       "Nome Titular",     l => l.NomeTitular),
        new("CpfCnpjConta",      "CPF/CNPJ Titular", l => l.CpfCnpjConta),
        new("Forma",             "Forma",            l => l.Forma),
        new("TipoPessoa",        "Tipo Pessoa",      l => l.TipoPessoa),
        new("TipoChavePix",      "Tipo Chave PIX",   l => l.TipoChavePix),
        new("ChavePix",          "Chave PIX",        l => l.ChavePix),
        new("CodigoBanco",       "Cód. Banco",       l => l.CodigoBanco),
        new("NomeBanco",         "Nome Banco",       l => l.NomeBanco),
        new("Agencia",           "Agência",          l => l.Agencia),
        new("Conta",             "Conta",            l => l.Conta),
    };

    private int QuantidadeSelecionadas => linhas.Count(l => l.Selecionado);
    private decimal TotalSelecionado => linhas.Where(l => l.Selecionado).Sum(l => l.ValorTotalPagar);
    private bool TodosSelecionados => linhas.Count > 0 && linhas.All(l => l.Selecionado);

    protected override async Task OnInitializedAsync()
    {
        competencias = await Service.ObterCompetenciasAsync();
        var atual = competencias.FirstOrDefault(c =>
            c.Mes == DateTime.Today.Month && c.Ano == DateTime.Today.Year);
        if (atual is not null)
            competenciaSelecionadaId = atual.Id;
    }

    private async Task GerarAsync()
    {
        mensagemErro = null;
        if (competenciaSelecionadaId == 0)
        {
            mensagemErro = "Selecione uma competência para gerar o relatório.";
            gerado = false;
            return;
        }

        processando = true;
        try
        {
            linhas = await Service.GerarFolhaFornecedor2Async(competenciaSelecionadaId, tipoPagamento);
            colunaOrdenacao = null;
            ordemAsc = true;
            gerado = true;
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro ao gerar relatório: {ex.Message}";
            gerado = false;
        }
        finally
        {
            processando = false;
        }
    }

    private void Limpar()
    {
        linhas = new();
        gerado = false;
        mensagemErro = null;
        colunaOrdenacao = null;
        ordemAsc = true;
    }

    private void Ordenar(string chave)
    {
        var col = Colunas.FirstOrDefault(c => c.Chave == chave);
        if (col is null) return;

        if (colunaOrdenacao == chave)
            ordemAsc = !ordemAsc;
        else
        {
            colunaOrdenacao = chave;
            ordemAsc = true;
        }

        linhas = (ordemAsc
            ? linhas.OrderBy(col.Selector)
            : linhas.OrderByDescending(col.Selector)).ToList();
    }

    private MarkupString Seta(string chave)
    {
        if (colunaOrdenacao != chave) return (MarkupString)"";
        return (MarkupString)(ordemAsc ? " &#9650;" : " &#9660;");
    }

    private void AlternarTodos(ChangeEventArgs e)
    {
        var marcar = e.Value is bool b && b;
        foreach (var l in linhas)
            l.Selecionado = marcar;
    }

    private async Task ExportarExcelAsync()
    {
        var selecionadas = linhas.Where(l => l.Selecionado).ToList();
        if (selecionadas.Count == 0) return;

        var ptBr = CultureInfo.GetCultureInfo("pt-BR");

        // Colunas: título, valor por linha, texto (preserva zeros à esquerda) e numérico.
        var colunas = new (string Titulo, Func<FolhaFornecedor2LinhaDto, string> Valor, bool Texto, bool Numero)[]
        {
            ("Fornecedor",      l => l.Fornecedor,                       false, false),
            ("CPF/CNPJ",        l => l.CpfCnpjFornecedor ?? "",          true,  false),
            ("Tipo Pagamento",  l => l.TipoPagamento ?? "",              false, false),
            ("Valor a Pagar",   l => l.ValorTotalPagar.ToString("N2", ptBr), false, true),
            ("Banco Pagador",   l => l.BancoPagador ?? "",               false, false),
            ("Nome Titular",    l => l.NomeTitular ?? "",                false, false),
            ("CPF/CNPJ Titular",l => l.CpfCnpjConta ?? "",               true,  false),
            ("Forma",           l => l.Forma ?? "",                      false, false),
            ("Tipo Pessoa",     l => l.TipoPessoa ?? "",                 false, false),
            ("Tipo Chave PIX",  l => l.TipoChavePix ?? "",               false, false),
            ("Chave PIX",       l => l.ChavePix ?? "",                   true,  false),
            ("Cód. Banco",      l => l.CodigoBanco ?? "",                true,  false),
            ("Nome Banco",      l => l.NomeBanco ?? "",                  false, false),
            ("Agência",         l => l.Agencia ?? "",                    true,  false),
            ("Conta",           l => l.Conta ?? "",                      false, false),
        };

        // Largura de cada coluna conforme o maior conteúdo (para não quebrar a linha).
        var larguras = new int[colunas.Length];
        for (int c = 0; c < colunas.Length; c++)
        {
            var max = colunas[c].Titulo.Length;
            foreach (var l in selecionadas)
                max = Math.Max(max, colunas[c].Valor(l).Length);
            larguras[c] = Math.Clamp(max * 8 + 16, 70, 420);
        }

        var totalSelecionado = selecionadas.Sum(l => l.ValorTotalPagar);
        var competenciaTexto = competencias.FirstOrDefault(c => c.Id == competenciaSelecionadaId)?.TextoExibicao ?? "";

        var sb = new StringBuilder();
        sb.Append("<html xmlns:x=\"urn:schemas-microsoft-com:office:excel\"><head><meta charset=\"utf-8\" />");
        sb.Append("<style>");
        sb.Append("table{border-collapse:collapse;}");
        sb.Append("td,th{border:1px solid #b7b7b7;padding:3px 8px;white-space:nowrap;vertical-align:middle;height:22px;font-family:Calibri,Arial,sans-serif;font-size:11pt;}");
        sb.Append("th{background:#305496;color:#ffffff;text-align:left;font-weight:bold;}");
        sb.Append(".titulo{border:none;font-size:16pt;font-weight:bold;color:#1F3864;}");
        sb.Append(".sub{border:none;color:#555555;}");
        sb.Append(".txt{mso-number-format:'\\@';}");
        sb.Append(".num{mso-number-format:'#,##0.00';text-align:right;}");
        sb.Append(".tot{background:#D9E1F2;font-weight:bold;}");
        sb.Append("</style></head><body><table>");

        sb.Append("<colgroup>");
        for (int c = 0; c < colunas.Length; c++)
            sb.Append($"<col style=\"width:{larguras[c]}px;\" />");
        sb.Append("</colgroup>");

        sb.Append($"<tr><td colspan=\"{colunas.Length}\" class=\"titulo\">Folha de Fornecedores 2</td></tr>");
        sb.Append($"<tr><td colspan=\"{colunas.Length}\" class=\"sub\">Competência: {Esc(competenciaTexto)} — Tipo de Pagamento: {Esc(tipoPagamento)}</td></tr>");
        sb.Append($"<tr><td colspan=\"{colunas.Length}\" style=\"border:none;height:6px;\"></td></tr>");

        sb.Append("<tr>");
        foreach (var col in colunas)
            sb.Append($"<th>{Esc(col.Titulo)}</th>");
        sb.Append("</tr>");

        foreach (var l in selecionadas)
        {
            sb.Append("<tr>");
            foreach (var col in colunas)
            {
                var cls = col.Texto ? " class=\"txt\"" : col.Numero ? " class=\"num\"" : "";
                sb.Append($"<td{cls}>{Esc(col.Valor(l))}</td>");
            }
            sb.Append("</tr>");
        }

        sb.Append("<tr>");
        sb.Append("<td colspan=\"3\" class=\"tot\" style=\"text-align:right;\">Total</td>");
        sb.Append($"<td class=\"tot num\">{totalSelecionado.ToString("N2", ptBr)}</td>");
        sb.Append($"<td colspan=\"{colunas.Length - 4}\" class=\"tot\"></td>");
        sb.Append("</tr>");

        sb.Append("</table></body></html>");

        var base64 = Convert.ToBase64String(Encoding.UTF8.GetBytes(sb.ToString()));
        var nome = $"Folha_Fornecedores_2_{competenciaTexto.Replace('/', '-').Replace(' ', '_')}.xls";
        await JS.InvokeVoidAsync("baixarArquivoBase64", nome, base64, "application/vnd.ms-excel");
    }

    private static string Esc(string? s) =>
        string.IsNullOrEmpty(s) ? "" : System.Net.WebUtility.HtmlEncode(s);

    private static string Moeda(decimal v) => v.ToString("C", CultureInfo.GetCultureInfo("pt-BR"));

    private static string TipoPagamentoBadge(string tipo) => tipo switch
    {
        "Boleto" => "bg-info text-dark",
        "Transferencia" => "bg-primary",
        "Transferência" => "bg-primary",
        _ => "bg-light text-dark"
    };

    private async Task VisualizarItemAsync(int itemId)
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        itemDetalhe = await context.FolhasFornecedoresItens
            .AsNoTracking()
            .Include(i => i.Fornecedor)
            .Include(i => i.BancoPagador)
            .Include(i => i.Notas)
            .FirstOrDefaultAsync(i => i.Id == itemId);

        anexosDetalhe = await context.Arquivos
            .AsNoTracking()
            .Where(a => a.FolhaFornecedorItemId == itemId)
            .OrderByDescending(a => a.Data)
            .Select(a => new Arquivo
            {
                Id = a.Id,
                Data = a.Data,
                Descricao = a.Descricao,
                NomeArquivo = a.NomeArquivo,
                ContentType = a.ContentType,
                TamanhoBytes = a.TamanhoBytes,
                Conteudo = Array.Empty<byte>()
            })
            .ToListAsync();
    }

    private void FecharDetalhe()
    {
        itemDetalhe = null;
        anexosDetalhe = new();
        FecharAnexo();
    }

    private async Task VisualizarAnexoAsync(int id)
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        var arquivo = await context.Arquivos.AsNoTracking().FirstOrDefaultAsync(a => a.Id == id);
        if (arquivo is null) return;

        anexoVisualizado = arquivo;
        anexoDataUrl = $"data:{arquivo.ContentType};base64,{Convert.ToBase64String(arquivo.Conteudo)}";
    }

    private void FecharAnexo()
    {
        anexoVisualizado = null;
        anexoDataUrl = null;
    }

    private static bool IsImagem(string contentType) =>
        contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);

    private static bool IsPdf(string contentType) =>
        contentType.Equals("application/pdf", StringComparison.OrdinalIgnoreCase);

    private static string FormatarTamanho(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024d:0.#} KB";
        return $"{bytes / (1024d * 1024d):0.#} MB";
    }
}
