    private static bool IsImagem(string contentType) =>
        contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);

    private static bool IsPdf(string contentType) =>
        contentType.Equals("application/pdf", StringComparison.OrdinalIgnoreCase);

    private static string FormatarTamanho(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024d:0.#} KB";
        return $"{bytes / (1024d * 1024d):0.#} MB";
    }

    // ---- Exportar para CNAB ----
    private bool cnabExportAberto;
    private bool cnabProcessando;
    private string? cnabErro;
    private readonly CnabExportForm cnabForm = new();
    private CnabGenerationResult? cnabResultado;

    private List<NormalizedPayment> CnabProblemas =>
        cnabResultado?.Pagamentos
            .Where(p => p.Status is StatusPagamentoCnab.Invalido or StatusPagamentoCnab.PendenteDeConfirmacao)
            .ToList() ?? new();

    private sealed class CnabExportForm
    {
        public string EmpresaPagadora { get; set; } = string.Empty;
        public DateTime DataPagamento { get; set; } = DateTime.Today;
        public string NomeArquivo { get; set; } = string.Empty;
        public string TipoPagamentoPrincipal { get; set; } = "PIX";
        public string Ambiente { get; set; } = "TESTE";
        public bool BloquearSeHouverInvalidos { get; set; }
        public bool SepararLotesPorForma { get; set; }
    }

    private void AbrirCnabExport()
    {
        cnabForm.EmpresaPagadora = CnabService.Empresas.FirstOrDefault()?.Codigo ?? string.Empty;
        cnabForm.DataPagamento = DateTime.Today;
        cnabForm.NomeArquivo = $"CNAB_Folha_Fornecedor_{DateTime.Now:yyyyMMdd_HHmmss}";
        cnabForm.TipoPagamentoPrincipal = "PIX";
        cnabForm.Ambiente = "TESTE";
        cnabForm.BloquearSeHouverInvalidos = false;
        cnabForm.SepararLotesPorForma = false;
        cnabErro = null;
        cnabResultado = null;
        cnabExportAberto = true;
    }

    private void FecharCnabExport()
    {
        cnabExportAberto = false;
        cnabResultado = null;
        cnabErro = null;
    }

    /// <summary>
    /// Gera o(s) .rem a partir das linhas selecionadas do tipo Transferência (Boleto e
    /// qualquer outro tipo diferente de Transferência nunca entram no CNAB), usando as
    /// classes puras do gerador CNAB BTG. O NSA é obtido/atualizado na mesma sequência
    /// (CnabSequences) usada pelo módulo "Gerenciar CNAB" para não colidir com outros
    /// lotes já enviados ao banco.
    /// </summary>
    private async Task GerarCnabExportAsync()
    {
        cnabErro = null;
        cnabProcessando = true;
        try
        {
            var selecionadas = linhas.Where(l => l.Selecionado && EhTransferencia(l.TipoPagamento)).ToList();
            if (selecionadas.Count == 0)
            {
                cnabErro = "Nenhum fornecedor do tipo Transferência selecionado.";
                return;
            }

            var empresa = EmpresaPagadora.Obter(cnabForm.EmpresaPagadora, CnabService.Empresas);
            if (empresa is null)
            {
                cnabErro = "Selecione um convênio válido.";
                return;
            }

            await using var context = await DbFactory.CreateDbContextAsync();

            // O relatório não traz o dígito da conta separado: busca do cadastro do fornecedor.
            var fornecedorIds = selecionadas.Select(l => l.FornecedorId).Distinct().ToList();
            var digitosPorFornecedor = await context.Fornecedores.AsNoTracking()
                .Where(f => fornecedorIds.Contains(f.Id))
                .Select(f => new { f.Id, Digito = f.ContaBancaria!.DigitoConta })
                .ToDictionaryAsync(x => x.Id, x => x.Digito);

            var inputs = selecionadas.Select(l => new PaymentInput
            {
                Id = l.ItemId,
                Origem = "Fornecedor",
                Nome = l.Fornecedor,
                NomeTitular = l.NomeTitular,
                CpfCnpj = l.CpfCnpjConta,
                Valor = l.ValorTotalPagar,
                Forma = l.Forma, // "PIX"/"TED" do cadastro; o Tipo do popup só é usado como fallback
                TipoPessoa = l.TipoPessoa,
                ChavePix = l.ChavePix,
                TipoChavePix = l.TipoChavePix,
                BancoNome = l.NomeBanco,
                CodigoBanco = l.CodigoBanco,
                Agencia = l.Agencia,
                Conta = l.Conta,
                DigitoConta = digitosPorFornecedor.TryGetValue(l.FornecedorId, out var dv) ? dv : null
            }).ToList();

            var seq = await context.CnabSequences.FirstOrDefaultAsync(s => s.EmpresaPagadora == empresa.Codigo);
            var nsaInicial = (seq?.UltimoNsa ?? 0) + 1;

            var user = (await AuthProvider.GetAuthenticationStateAsync()).User;

            var options = new CnabGenerationOptions
            {
                Empresa = empresa,
                DataPagamento = cnabForm.DataPagamento,
                NsaInicial = nsaInicial,
                NomeBaseArquivo = cnabForm.NomeArquivo,
                TipoPagamentoPrincipal = cnabForm.TipoPagamentoPrincipal,
                Ambiente = string.Equals(cnabForm.Ambiente, "PRODUCAO", StringComparison.OrdinalIgnoreCase)
                    ? AmbienteCnab.Producao : AmbienteCnab.Teste,
                TratamentoInvalidos = cnabForm.BloquearSeHouverInvalidos ? TratamentoInvalidos.Bloquear : TratamentoInvalidos.Remover,
                SepararLotesPorForma = cnabForm.SepararLotesPorForma,
                MaxOperacoesPorArquivo = 48,
                GeradoEm = DateTime.Now,
                GeradoPor = user.Identity?.Name
            };

            var generator = new CnabBtgPaymentGenerator();
            var resultado = generator.Gerar(inputs, options);
            cnabResultado = resultado;

            if (!resultado.Bloqueado && resultado.Arquivos.Count > 0)
            {
                if (seq is null)
                {
                    context.CnabSequences.Add(new CnabSequence
                    {
                        EmpresaPagadora = empresa.Codigo,
                        UltimoNsa = resultado.NsaFinal,
                        UpdatedAt = options.GeradoEm
                    });
                }
                else
                {
                    seq.UltimoNsa = resultado.NsaFinal;
                    seq.UpdatedAt = options.GeradoEm;
                }
                await context.SaveChangesAsync();
            }
        }
        catch (Exception ex)
        {
            cnabErro = $"Erro ao gerar CNAB: {ex.Message}";
        }
        finally
        {
            cnabProcessando = false;
        }
    }

    private async Task BaixarCnabAsync()
    {
        if (cnabResultado is null || cnabResultado.Arquivos.Count == 0) return;

        if (cnabResultado.Arquivos.Count == 1)
        {
            var a = cnabResultado.Arquivos[0];
            var base64 = Convert.ToBase64String(CnabZipPacker.RemBytes(a.Conteudo));
            await JS.InvokeVoidAsync("baixarArquivoBase64", a.FileName, base64, "application/octet-stream");
            return;
        }

        using var ms = new MemoryStream();
        using (var zip = new ZipArchive(ms, ZipArchiveMode.Create, leaveOpen: true))
        {
            foreach (var a in cnabResultado.Arquivos)
            {
                var entry = zip.CreateEntry(a.FileName, CompressionLevel.Optimal);
                await using var s = entry.Open();
                var bytes = CnabZipPacker.RemBytes(a.Conteudo);
                await s.WriteAsync(bytes);
            }
        }
        var zipBase64 = Convert.ToBase64String(ms.ToArray());
        await JS.InvokeVoidAsync("baixarArquivoBase64", $"{cnabForm.NomeArquivo}.zip", zipBase64, "application/zip");
    }
}
