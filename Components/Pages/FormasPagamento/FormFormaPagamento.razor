@page "/formas-pagamento/novo"
@page "/formas-pagamento/editar/{Id:int}"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using MinhaAplicacaoBlazor.Data
@using MinhaAplicacaoBlazor.Models

@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>@(IsNovo ? "Nova Forma de Pagamento" : "Editar Forma de Pagamento")</PageTitle>

<div class="container mt-4">
    <div class="card">
        <div class="card-header">
            <h3 class="mb-0">@(IsNovo ? "Nova Forma de Pagamento" : "Editar Forma de Pagamento")</h3>
        </div>
        <div class="card-body">
            @if (carregando)
            {
                <p>Carregando...</p>
            }
            else
            {
                <EditForm Model="forma" OnValidSubmit="SalvarAsync" FormName="form-forma-pagamento">
                    <DataAnnotationsValidator />

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Nome <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="forma.Nome" />
                            <ValidationMessage For="@(() => forma.Nome)" class="text-danger small" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <div class="form-check">
                                <InputCheckbox class="form-check-input" id="ativa-forma-pgto" @bind-Value="forma.Ativa" />
                                <label class="form-check-label" for="ativa-forma-pgto">Ativa</label>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(mensagemErro))
                    {
                        <div class="alert alert-danger">@mensagemErro</div>
                    }

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Salvar</button>
                        <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private FormaPagamento forma = new();
    private bool carregando = true;
    private string? mensagemErro;

    private bool IsNovo => Id is null or 0;

    protected override async Task OnInitializedAsync()
    {
        if (!IsNovo)
        {
            await using var context = await DbFactory.CreateDbContextAsync();

            var existente = await context.FormasPagamento
                .AsNoTracking()
                .FirstOrDefaultAsync(f => f.Id == Id);

            if (existente is null)
            {
                Navigation.NavigateTo("/formas-pagamento");
                return;
            }

            forma = existente;
        }

        carregando = false;
    }

    private async Task SalvarAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        var jaExiste = await context.FormasPagamento
            .AsNoTracking()
            .AnyAsync(f => f.Nome == forma.Nome && f.Id != forma.Id);

        if (jaExiste)
        {
            mensagemErro = "Já existe uma forma de pagamento com este nome.";
            return;
        }

        mensagemErro = null;

        if (IsNovo)
            context.FormasPagamento.Add(forma);
        else
            context.FormasPagamento.Update(forma);

        await context.SaveChangesAsync();

        Navigation.NavigateTo("/formas-pagamento");
    }

    private void Cancelar() => Navigation.NavigateTo("/formas-pagamento");
}
