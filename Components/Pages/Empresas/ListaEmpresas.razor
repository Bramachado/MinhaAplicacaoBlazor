@page "/empresas"
@attribute [Authorize(Policy = "Empresas.Ver")]
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using MinhaAplicacaoBlazor.Data
@using MinhaAplicacaoBlazor.Models

@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>Empresas</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Empresas</h1>
        <PermissaoView Requer="Empresas.Criar">
            <button class="btn btn-primary" @onclick="Nova">Nova Empresa</button>
        </PermissaoView>
    </div>

    <div class="alert alert-secondary small">
        Cada empresa é uma fronteira de isolamento: usuários de uma empresa não enxergam
        dados de outra. Depois de criar a empresa, cadastre um usuário administrador dela
        em <a href="admin/usuarios">Usuários</a>; ao entrar, esse usuário verá apenas os
        dados da própria empresa.
    </div>

    @if (empresas is null)
    {
        <p>Carregando...</p>
    }
    else if (empresas.Count == 0)
    {
        <div class="alert alert-info">Nenhuma empresa cadastrada.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Nome</th>
                        <th>CNPJ</th>
                        <th>Ativa</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in empresas)
                    {
                        <tr>
                            <td>@e.Nome</td>
                            <td>@e.Cnpj</td>
                            <td>
                                @if (e.Ativa)
                                {
                                    <span class="badge bg-success">Sim</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Não</span>
                                }
                            </td>
                            <td class="text-end">
                                <PermissaoView Requer="Empresas.Editar">
                                    <button class="btn btn-sm btn-outline-secondary"
                                            title="Editar" @onclick="() => Editar(e.Id)">
                                        Editar
                                    </button>
                                </PermissaoView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Empresa>? empresas;

    protected override async Task OnInitializedAsync()
    {
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();
        empresas = await context.Empresas
            .AsNoTracking()
            .OrderBy(e => e.Nome)
            .ToListAsync();
    }

    private void Nova() => Navigation.NavigateTo("/empresas/novo");
    private void Editar(int id) => Navigation.NavigateTo($"/empresas/editar/{id}");
}
