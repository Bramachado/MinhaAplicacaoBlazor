@page "/fornecedores"
@attribute [Authorize(Policy = "Fornecedores.Ver")]
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using MinhaAplicacaoBlazor.Data
@using MinhaAplicacaoBlazor.Models

@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Fornecedores</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Fornecedores</h1>
        <div class="d-flex gap-2 d-print-none">
            <button class="btn btn-outline-primary" @onclick="ImprimirAsync">Imprimir</button>
            <PermissaoView Requer="Fornecedores.Criar">
                <button class="btn btn-primary" @onclick="Novo">Novo Fornecedor</button>
            </PermissaoView>
        </div>
    </div>

    <div class="d-none d-print-block mb-3">
        <h5 class="mb-1">Filtros aplicados</h5>
        <div>
            <strong>Pesquisa:</strong> @(string.IsNullOrWhiteSpace(filtroTexto) ? "—" : filtroTexto) &nbsp;|&nbsp;
            <strong>Unidade:</strong> @NomeUnidadeFiltro &nbsp;|&nbsp;
            <strong>Categoria:</strong> @NomeCategoriaFiltro &nbsp;|&nbsp;
            <strong>Status:</strong> @StatusFiltro &nbsp;|&nbsp;
            <strong>Total:</strong> @FornecedoresFiltrados.Count() registro(s)
        </div>
    </div>

    <div class="row mb-3 g-2 d-print-none">
        <div class="col-md-4">
            <input type="text"
                   class="form-control"
                   placeholder="Pesquisar por nome, fantasia ou CPF/CNPJ..."
                   @bind="filtroTexto"
                   @bind:event="oninput" />
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="filtroUnidadeId">
                <option value="0">Todas as Unidades</option>
                @foreach (var u in unidades)
                {
                    <option value="@u.Id">@u.Nome</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="filtroCategoriaId">
                <option value="0">Todas as Categorias</option>
                @foreach (var c in categorias)
                {
                    <option value="@c.Id">@c.Nome</option>
                }
            </select>
        </div>
        <div class="col-md-1">
            <select class="form-select" @bind="filtroAtivo">
                <option value="">Todos</option>
                <option value="true">Ativos</option>
                <option value="false">Inativos</option>
            </select>
        </div>
        <div class="col-md-1">
            <select class="form-select" @bind="pagination.ItemsPerPage">
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
    </div>

    @if (fornecedores is null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <div class="table-responsive">
            <QuickGrid Items="FornecedoresFiltrados" Pagination="@pagination.QuandoNecessario(FornecedoresFiltrados)" Class="table table-striped table-hover align-middle imprimivel-sem-acoes">
                <PropertyColumn Property="@(f => f.NomeRazaoSocial)" Title="Nome / Razão Social" Sortable="true" InitialSortDirection="SortDirection.Ascending" IsDefaultSortColumn="true" />
                <PropertyColumn Property="@(f => f.CpfCnpj)" Title="CPF/CNPJ" />
                <PropertyColumn Property="@(f => f.CategoriaFornecedor!.Nome)" Title="Categoria" Sortable="true" />
                <PropertyColumn Property="@(f => f.Unidade!.Nome)" Title="Unidade" Sortable="true" />
                <PropertyColumn Property="@(f => f.Telefone)" Title="Telefone" />
                <TemplateColumn Title="Ativo" Sortable="true" SortBy="@sortPorAtivo" Align="Align.Center">
                    @if (context.Ativo)
                    {
                        <span class="badge bg-success">Sim</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Não</span>
                    }
                </TemplateColumn>
                <TemplateColumn Title="Conta" Sortable="true" SortBy="@sortPorConta" Align="Align.Center">
                    @if (context.ContaBancariaId.HasValue)
                    {
                        <span class="badge bg-success">Sim</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Não</span>
                    }
                </TemplateColumn>
                <TemplateColumn Title="Ações" Align="Align.End">
                    <PermissaoView Requer="Fornecedores.Editar">
                        <button class="btn btn-sm btn-outline-secondary me-1"
                                title="Editar"
                                @onclick="() => Editar(context.Id)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
                            </svg>
                        </button>
                    </PermissaoView>
                    <PermissaoView Requer="Fornecedores.Excluir">
                        <button class="btn btn-sm btn-outline-danger"
                                title="Excluir"
                                @onclick="() => ExcluirAsync(context.Id)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                            </svg>
                        </button>
                    </PermissaoView>
                </TemplateColumn>
            </QuickGrid>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-2 d-print-none">
            <small class="text-muted">@(FornecedoresFiltrados.Count()) registro(s) encontrado(s)</small>
            <Paginator State="pagination" />
        </div>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<Fornecedor>? fornecedores;
    private List<Unidade> unidades = new();
    private List<CategoriaFornecedor> categorias = new();
    private string filtroTexto = string.Empty;
    private int filtroUnidadeId;
    private int filtroCategoriaId;
    private string filtroAtivo = string.Empty;
    private readonly PaginationState pagination = new() { ItemsPerPage = 10 };

    private readonly GridSort<Fornecedor> sortPorAtivo = GridSort<Fornecedor>.ByAscending(f => f.Ativo);

    private readonly GridSort<Fornecedor> sortPorConta = GridSort<Fornecedor>.ByAscending(f => f.ContaBancariaId != null);

    private IQueryable<Fornecedor> FornecedoresFiltrados
    {
        get
        {
            if (fornecedores is null)
                return Enumerable.Empty<Fornecedor>().AsQueryable();

            IEnumerable<Fornecedor> resultado = fornecedores;

            if (!string.IsNullOrWhiteSpace(filtroTexto))
            {
                var termo = filtroTexto.Trim();
                resultado = resultado.Where(f =>
                    f.NomeRazaoSocial.Contains(termo, StringComparison.OrdinalIgnoreCase) ||
                    (f.NomeFantasia != null && f.NomeFantasia.Contains(termo, StringComparison.OrdinalIgnoreCase)) ||
                    (f.CpfCnpj != null && f.CpfCnpj.Contains(termo, StringComparison.OrdinalIgnoreCase)));
            }

            if (filtroUnidadeId > 0)
                resultado = resultado.Where(f => f.UnidadeId == filtroUnidadeId);

            if (filtroCategoriaId > 0)
                resultado = resultado.Where(f => f.CategoriaFornecedorId == filtroCategoriaId);

            if (bool.TryParse(filtroAtivo, out var ativo))
                resultado = resultado.Where(f => f.Ativo == ativo);

            return resultado.AsQueryable();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CarregarDadosAsync();
    }

    private async Task CarregarDadosAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        fornecedores = await context.Fornecedores
            .AsNoTracking()
            .Include(f => f.Unidade)
            .Include(f => f.CategoriaFornecedor)
            .OrderBy(f => f.NomeRazaoSocial)
            .ToListAsync();

        unidades = await context.Unidades
            .AsNoTracking()
            .OrderBy(u => u.Nome)
            .ToListAsync();

        categorias = await context.CategoriasFornecedores
            .AsNoTracking()
            .OrderBy(c => c.Nome)
            .ToListAsync();
    }

    private string NomeUnidadeFiltro =>
        filtroUnidadeId == 0 ? "Todas" : unidades.FirstOrDefault(u => u.Id == filtroUnidadeId)?.Nome ?? "—";

    private string NomeCategoriaFiltro =>
        filtroCategoriaId == 0 ? "Todas" : categorias.FirstOrDefault(c => c.Id == filtroCategoriaId)?.Nome ?? "—";

    private string StatusFiltro => filtroAtivo switch
    {
        "true" => "Apenas Ativos",
        "false" => "Apenas Inativos",
        _ => "Todos"
    };

    private async Task ImprimirAsync()
    {
        var anteriores = pagination.ItemsPerPage;
        await pagination.SetCurrentPageIndexAsync(0);
        pagination.ItemsPerPage = int.MaxValue;
        StateHasChanged();
        await Task.Yield();
        await JS.InvokeVoidAsync("window.print");
        pagination.ItemsPerPage = anteriores;
    }

    private void Novo() => Navigation.NavigateTo("/fornecedores/novo");
    private void Editar(int id) => Navigation.NavigateTo($"/fornecedores/editar/{id}");

    private async Task ExcluirAsync(int id)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", "Deseja realmente excluir este fornecedor?");
        if (!confirmado) return;

        var usuario = AuthState is null ? null : (await AuthState).User;
        await using var context = await DbFactory.CreateDbContextAsync(usuario);
        var entidade = await context.Fornecedores.FindAsync(id);

        if (entidade is not null)
        {
            context.Fornecedores.Remove(entidade);
            await context.SaveChangesAsync();
            await CarregarDadosAsync();
        }
    }
}
