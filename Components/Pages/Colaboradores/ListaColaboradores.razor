@page "/colaboradores"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using MinhaAplicacaoBlazor.Data
@using MinhaAplicacaoBlazor.Models

@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Colaboradores</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Colaboradores</h1>
        <div class="d-flex gap-2 d-print-none">
            <button class="btn btn-outline-primary" @onclick="ImprimirAsync">
                Imprimir
            </button>
            <button class="btn btn-primary" @onclick="NovoColaborador">
                Novo Colaborador
            </button>
        </div>
    </div>

    <div class="d-none d-print-block mb-3">
        <h5 class="mb-1">Filtros aplicados</h5>
        <div>
            <strong>Pesquisa:</strong> @(string.IsNullOrWhiteSpace(filtroTexto) ? "—" : filtroTexto) &nbsp;|&nbsp;
            <strong>Unidade:</strong> @NomeUnidadeFiltro &nbsp;|&nbsp;
            <strong>Status:</strong> @StatusFiltro &nbsp;|&nbsp;
            <strong>Total:</strong> @ColaboradoresFiltrados.Count() registro(s)
        </div>
    </div>

    <div class="row mb-3 g-2 d-print-none">
        <div class="col-md-5">
            <input type="text"
                   class="form-control"
                   placeholder="Pesquisar por nome ou CPF..."
                   @bind="filtroTexto"
                   @bind:event="oninput" />
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="filtroUnidadeId">
                <option value="0">Todas as Unidades</option>
                @foreach (var u in unidades)
                {
                    <option value="@u.Id">@u.Nome</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select class="form-select" @bind="filtroAtivo">
                <option value="">Ativos e Inativos</option>
                <option value="true">Apenas Ativos</option>
                <option value="false">Apenas Inativos</option>
            </select>
        </div>
        <div class="col-md-2">
            <select class="form-select" @bind="pagination.ItemsPerPage">
                <option value="10">10 por página</option>
                <option value="25">25 por página</option>
                <option value="50">50 por página</option>
                <option value="100">100 por página</option>
            </select>
        </div>
    </div>

    @if (colaboradores is null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <div class="table-responsive">
            <QuickGrid Items="ColaboradoresFiltrados" Pagination="pagination" Class="table table-striped table-hover align-middle imprimivel-sem-acoes">
                <PropertyColumn Property="@(c => c.Nome)" Title="Nome" Sortable="true" InitialSortDirection="SortDirection.Ascending" IsDefaultSortColumn="true" />
                <PropertyColumn Property="@(c => c.Cpf)" Title="CPF" Sortable="true" />
                <PropertyColumn Property="@(c => c.Cargo)" Title="Cargo" Sortable="true" />
                <PropertyColumn Property="@(c => c.Unidade!.Nome)" Title="Unidade" Sortable="true" />
                <PropertyColumn Property="@(c => c.Telefone)" Title="Telefone" />
                <PropertyColumn Property="@(c => c.Email)" Title="Email" Sortable="true" />
                <PropertyColumn Property="@(c => c.Banco)" Title="Banco" Sortable="true" />
                <PropertyColumn Property="@(c => c.Agencia)" Title="Agência" />
                <PropertyColumn Property="@(c => c.Conta)" Title="Conta" />
                <TemplateColumn Title="Ativo" Sortable="true" SortBy="@sortPorAtivo" Align="Align.Center">
                    @if (context.Ativo)
                    {
                        <span class="badge bg-success">Sim</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Não</span>
                    }
                </TemplateColumn>
                <TemplateColumn Title="Ações" Align="Align.End">
                    <button class="btn btn-sm btn-outline-secondary me-1"
                            title="Editar"
                            @onclick="() => Editar(context.Id)">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
                        </svg>
                    </button>
                    <button class="btn btn-sm btn-outline-danger"
                            title="Excluir"
                            @onclick="() => ExcluirAsync(context.Id)">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                        </svg>
                    </button>
                </TemplateColumn>
            </QuickGrid>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-2 d-print-none">
            <small class="text-muted">@(ColaboradoresFiltrados.Count()) registro(s) encontrado(s)</small>
            <Paginator State="pagination" />
        </div>
    }
</div>

@code {
    private List<Colaborador>? colaboradores;
    private List<Unidade> unidades = new();
    private string filtroTexto = string.Empty;
    private int filtroUnidadeId;
    private string filtroAtivo = string.Empty;

    private readonly PaginationState pagination = new() { ItemsPerPage = 10 };

    private readonly GridSort<Colaborador> sortPorAtivo = GridSort<Colaborador>.ByAscending(c => c.Ativo);

    private IQueryable<Colaborador> ColaboradoresFiltrados
    {
        get
        {
            if (colaboradores is null)
                return Enumerable.Empty<Colaborador>().AsQueryable();

            IEnumerable<Colaborador> resultado = colaboradores;

            if (!string.IsNullOrWhiteSpace(filtroTexto))
            {
                var termo = filtroTexto.Trim();
                resultado = resultado.Where(c =>
                    c.Nome.Contains(termo, StringComparison.OrdinalIgnoreCase) ||
                    c.Cpf.Contains(termo, StringComparison.OrdinalIgnoreCase));
            }

            if (filtroUnidadeId > 0)
                resultado = resultado.Where(c => c.UnidadeId == filtroUnidadeId);

            if (bool.TryParse(filtroAtivo, out var ativo))
                resultado = resultado.Where(c => c.Ativo == ativo);

            return resultado.AsQueryable();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CarregarDadosAsync();
    }

    private async Task CarregarDadosAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        colaboradores = await context.Colaboradores
            .AsNoTracking()
            .Include(c => c.Unidade)
            .OrderBy(c => c.Nome)
            .ToListAsync();

        unidades = await context.Unidades
            .AsNoTracking()
            .OrderBy(u => u.Nome)
            .ToListAsync();
    }

    private string NomeUnidadeFiltro =>
        filtroUnidadeId == 0
            ? "Todas"
            : unidades.FirstOrDefault(u => u.Id == filtroUnidadeId)?.Nome ?? "—";

    private string StatusFiltro => filtroAtivo switch
    {
        "true" => "Apenas Ativos",
        "false" => "Apenas Inativos",
        _ => "Todos"
    };

    private async Task ImprimirAsync()
    {
        var itensAnteriores = pagination.ItemsPerPage;
        await pagination.SetCurrentPageIndexAsync(0);
        pagination.ItemsPerPage = int.MaxValue;
        StateHasChanged();
        await Task.Yield();
        await JS.InvokeVoidAsync("window.print");
        pagination.ItemsPerPage = itensAnteriores;
    }

    private void NovoColaborador() => Navigation.NavigateTo("/colaboradores/novo");
    private void Editar(int id) => Navigation.NavigateTo($"/colaboradores/editar/{id}");

    private async Task ExcluirAsync(int id)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", "Deseja realmente excluir este colaborador?");
        if (!confirmado) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        var entidade = await context.Colaboradores.FindAsync(id);

        if (entidade is not null)
        {
            context.Colaboradores.Remove(entidade);
            await context.SaveChangesAsync();
            await CarregarDadosAsync();
        }
    }
}
