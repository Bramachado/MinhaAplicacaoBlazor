@page "/colaboradores/novo"
@attribute [Authorize(Policy = "Colaboradores.Ver")]
@page "/colaboradores/editar/{Id:int}"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using MinhaAplicacaoBlazor.Data
@using MinhaAplicacaoBlazor.Models

@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>@(IsNovo ? "Novo Colaborador" : "Editar Colaborador")</PageTitle>

<div class="container mt-4">
    <div class="card">
        <div class="card-header">
            <h3 class="mb-0">@(IsNovo ? "Novo Colaborador" : "Editar Colaborador")</h3>
        </div>
        <div class="card-body">
            @if (carregando)
            {
                <p>Carregando...</p>
            }
            else
            {
                <EditForm Model="colaborador" OnValidSubmit="SalvarAsync" FormName="form-colaborador">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Nome</label>
                            <InputText class="form-control" @bind-Value="colaborador.Nome" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Unidade</label>
                            <InputSelect class="form-select" @bind-Value="colaborador.UnidadeId">
                                <option value="0">-- Selecione --</option>
                                @foreach (var u in unidades)
                                {
                                    <option value="@u.Id">@u.Codigo - @u.Nome</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">CPF</label>
                            <InputCpf class="form-control" @bind-Value="colaborador.Cpf" />
                        </div>

                        <div class="col-md-4 mb-3">
                            <label class="form-label">RG</label>
                            <InputText class="form-control" @bind-Value="colaborador.Rg" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email</label>
                            <InputText type="email" class="form-control" @bind-Value="colaborador.Email" />
                        </div>

                        <div class="col-md-3 mb-3">
                            <label class="form-label">Telefone</label>
                            <InputText class="form-control" @bind-Value="colaborador.Telefone" />
                        </div>

                        <div class="col-md-3 mb-3">
                            <label class="form-label">Data de Nascimento</label>
                            <InputDate class="form-control" @bind-Value="colaborador.DataNascimento" />
                        </div>
                    </div>

                    <hr />
                    <h5>Dados Profissionais</h5>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Cargo</label>
                            <InputText class="form-control" @bind-Value="colaborador.Cargo" />
                        </div>

                        <div class="col-md-2 mb-3">
                            <label class="form-label">Carga Horária Semanal</label>
                            <InputNumber class="form-control text-end" @bind-Value="colaborador.CargaHorariaSemanal" step="0.01" />
                        </div>

                        <div class="col-md-2 mb-3">
                            <label class="form-label">Salário Base</label>
                            <InputNumber class="form-control text-end" @bind-Value="colaborador.SalarioBase" step="0.01" />
                        </div>

                        <div class="col-md-2 mb-3">
                            <label class="form-label">Ticket Alimentação</label>
                            <InputNumber class="form-control text-end" @bind-Value="colaborador.TicketAlimentacao" step="0.01" />
                        </div>
                    </div>

                    <hr />
                    <h5>Dados Bancários</h5>

                    <div class="mb-3">
                        <SelecionarContaBancaria @bind-ContaBancariaId="colaborador.ContaBancariaId" Titulo="Conta Bancária" />
                    </div>

                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <div class="form-check">
                                <InputCheckbox class="form-check-input" id="ativo-colaborador" @bind-Value="colaborador.Ativo" />
                                <label class="form-check-label" for="ativo-colaborador">Ativo</label>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(mensagemErro))
                    {
                        <div class="alert alert-danger">@mensagemErro</div>
                    }

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Salvar</button>
                        <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private Colaborador colaborador = new();
    private List<Unidade> unidades = new();
    private bool carregando = true;
    private string? mensagemErro;

    private bool IsNovo => Id is null or 0;

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        unidades = await context.Unidades
            .AsNoTracking()
            .Where(u => u.Ativa)
            .OrderBy(u => u.Nome)
            .ToListAsync();

        if (!IsNovo)
        {
            var existente = await context.Colaboradores
                .AsNoTracking()
                .FirstOrDefaultAsync(c => c.Id == Id);

            if (existente is null)
            {
                Navigation.NavigateTo("/colaboradores");
                return;
            }

            colaborador = existente;
        }

        carregando = false;
    }

    private async Task SalvarAsync()
    {
        if (colaborador.UnidadeId == 0)
        {
            mensagemErro = "Selecione uma unidade.";
            return;
        }

        mensagemErro = null;

        var usuario = AuthState is null ? null : (await AuthState).User;
        await using var context = await DbFactory.CreateDbContextAsync(usuario);

        var cpf = colaborador.Cpf?.Trim();
        var cpfDuplicado = await context.Colaboradores
            .AsNoTracking()
            .AnyAsync(c => c.Cpf == cpf && c.Id != colaborador.Id);

        if (cpfDuplicado)
        {
            mensagemErro = "Já existe um colaborador cadastrado com este CPF.";
            return;
        }

        if (IsNovo)
            context.Colaboradores.Add(colaborador);
        else
            context.Colaboradores.Update(colaborador);

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateException)
        {
            mensagemErro = "Não foi possível salvar. Verifique se o CPF já não está cadastrado para outro colaborador.";
            return;
        }

        Navigation.NavigateTo("/colaboradores");
    }

    private void Cancelar() => Navigation.NavigateTo("/colaboradores");
}
