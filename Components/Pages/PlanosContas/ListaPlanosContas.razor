@page "/planos-contas"
@attribute [Authorize(Policy = "PlanosContas.Ver")]
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using MinhaAplicacaoBlazor.Data
@using MinhaAplicacaoBlazor.Models

@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Plano de Contas</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Plano de Contas</h1>
        <PermissaoView Requer="PlanosContas.Criar">
            <button class="btn btn-primary" @onclick="Novo">
                Novo Plano de Conta
            </button>
        </PermissaoView>
    </div>

    <div class="row mb-3 g-2">
        <div class="col-md-6">
            <input type="text"
                   class="form-control"
                   placeholder="Pesquisar por nome..."
                   @bind="filtroTexto"
                   @bind:event="oninput" />
        </div>
        <div class="col-md-3">
            <select class="form-select" @bind="filtroAtivo">
                <option value="">Ativos e Inativos</option>
                <option value="true">Apenas Ativos</option>
                <option value="false">Apenas Inativos</option>
            </select>
        </div>
        <div class="col-md-2">
            <select class="form-select" @bind="pagination.ItemsPerPage">
                <option value="10">10 por página</option>
                <option value="25">25 por página</option>
                <option value="50">50 por página</option>
                <option value="100">100 por página</option>
            </select>
        </div>
    </div>

    @if (planos is null)
    {
        <p>Carregando...</p>
    }
    else
    {
        <div class="table-responsive">
            <QuickGrid Items="PlanosFiltrados" Pagination="@pagination.QuandoNecessario(PlanosFiltrados)" Class="table table-striped table-hover align-middle">
                <PropertyColumn Property="@(p => p.Nome)" Title="Nome" Sortable="true" InitialSortDirection="SortDirection.Ascending" IsDefaultSortColumn="true" />
                <TemplateColumn Title="Situação" Sortable="true" SortBy="@sortPorAtivo" Align="Align.Center">
                    @if (context.Ativo)
                    {
                        <span class="badge bg-success">Ativo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inativo</span>
                    }
                </TemplateColumn>
                <TemplateColumn Title="Ações" Align="Align.End">
                    <PermissaoView Requer="PlanosContas.Editar">
                        <button class="btn btn-sm btn-outline-secondary me-1"
                                title="Editar"
                                @onclick="() => Editar(context.Id)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
                            </svg>
                        </button>
                    </PermissaoView>
                    <PermissaoView Requer="PlanosContas.Excluir">
                        <button class="btn btn-sm btn-outline-danger"
                                title="Excluir"
                                @onclick="() => ExcluirAsync(context.Id)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                            </svg>
                        </button>
                    </PermissaoView>
                </TemplateColumn>
            </QuickGrid>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-2">
            <small class="text-muted">@(PlanosFiltrados.Count()) registro(s) encontrado(s)</small>
            <Paginator State="pagination" />
        </div>
    }
</div>

@code {
    private List<PlanoConta>? planos;
    private string filtroTexto = string.Empty;
    private string filtroAtivo = string.Empty;
    private readonly PaginationState pagination = new() { ItemsPerPage = 10 };

    private readonly GridSort<PlanoConta> sortPorAtivo = GridSort<PlanoConta>.ByAscending(p => p.Ativo);

    private IQueryable<PlanoConta> PlanosFiltrados
    {
        get
        {
            if (planos is null)
                return Enumerable.Empty<PlanoConta>().AsQueryable();

            IEnumerable<PlanoConta> resultado = planos;

            if (!string.IsNullOrWhiteSpace(filtroTexto))
            {
                var termo = filtroTexto.Trim();
                resultado = resultado.Where(p => p.Nome.Contains(termo, StringComparison.OrdinalIgnoreCase));
            }

            if (bool.TryParse(filtroAtivo, out var ativo))
                resultado = resultado.Where(p => p.Ativo == ativo);

            return resultado.AsQueryable();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CarregarDadosAsync();
    }

    private async Task CarregarDadosAsync()
    {
        await using var context = await DbFactory.CreateDbContextAsync();

        planos = await context.PlanosContas
            .AsNoTracking()
            .OrderBy(p => p.Nome)
            .ToListAsync();
    }

    private void Novo() => Navigation.NavigateTo("/planos-contas/novo");
    private void Editar(int id) => Navigation.NavigateTo($"/planos-contas/editar/{id}");

    private async Task ExcluirAsync(int id)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", "Deseja realmente excluir este plano de conta?");
        if (!confirmado) return;

        await using var context = await DbFactory.CreateDbContextAsync();
        var entidade = await context.PlanosContas.FindAsync(id);

        if (entidade is not null)
        {
            context.PlanosContas.Remove(entidade);
            await context.SaveChangesAsync();
            await CarregarDadosAsync();
        }
    }
}
