@page "/categorias-fornecedores/detalhes/{Id:int}"
@attribute [Authorize(Policy = "CategoriasFornecedores.Ver")]
@rendermode InteractiveServer

@using MinhaAplicacaoBlazor.Models
@using MinhaAplicacaoBlazor.Services

@inject CategoriaFornecedorService Service
@inject NavigationManager Navigation

<PageTitle>Detalhes da Categoria</PageTitle>

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3 class="mb-0">Detalhes da Categoria</h3>
            <button class="btn btn-secondary" @onclick="Voltar">Voltar</button>
        </div>
        <div class="card-body">
            @if (carregando)
            {
                <p>Carregando...</p>
            }
            else if (categoria is null)
            {
                <div class="alert alert-warning">Categoria não encontrada.</div>
            }
            else
            {
                <dl class="row">
                    <dt class="col-sm-3">Nome</dt>
                    <dd class="col-sm-9">@categoria.Nome</dd>

                    <dt class="col-sm-3">Descrição</dt>
                    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(categoria.Descricao) ? "—" : categoria.Descricao)</dd>

                    <dt class="col-sm-3">Situação</dt>
                    <dd class="col-sm-9">
                        @if (categoria.Ativa)
                        {
                            <span class="badge bg-success">Ativa</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inativa</span>
                        }
                    </dd>

                    <dt class="col-sm-3">Data de Cadastro</dt>
                    <dd class="col-sm-9">@categoria.DataCadastro.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-3">Última Atualização</dt>
                    <dd class="col-sm-9">@(categoria.DataAtualizacao?.ToString("dd/MM/yyyy HH:mm") ?? "—")</dd>

                    <dt class="col-sm-3">Fornecedores Vinculados</dt>
                    <dd class="col-sm-9"><span class="badge bg-info text-dark">@quantidadeFornecedores</span></dd>
                </dl>

                <div class="d-flex gap-2 mt-3">
                    <PermissaoView Requer="CategoriasFornecedores.Editar">
                        <button class="btn btn-primary" @onclick="Editar">Editar</button>
                    </PermissaoView>
                    <button class="btn btn-secondary" @onclick="Voltar">Voltar</button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }

    private CategoriaFornecedor? categoria;
    private int quantidadeFornecedores;
    private bool carregando = true;

    protected override async Task OnInitializedAsync()
    {
        categoria = await Service.ObterPorIdAsync(Id);

        if (categoria is not null)
        {
            quantidadeFornecedores = await Service.ContarFornecedoresVinculadosAsync(Id);
        }

        carregando = false;
    }

    private void Editar() => Navigation.NavigateTo($"/categorias-fornecedores/editar/{Id}");
    private void Voltar() => Navigation.NavigateTo("/categorias-fornecedores");
}
