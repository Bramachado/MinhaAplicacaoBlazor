@using Microsoft.AspNetCore.Components.Authorization

<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated != true)
                {
                    <RedirectToLogin />
                }
                else
                {
                    <LayoutView Layout="typeof(Layout.EmptyLayout)">
                        <div class="login-card">
                            <div class="login-brand">Edunorte ERP</div>
                            <h1 class="login-title">Acesso negado</h1>
                            <p>Você não tem permissão para acessar esta página. Fale com um administrador se acredita que deveria ter acesso.</p>
                            <a class="btn btn-primary w-100" href="/">Voltar ao início</a>
                        </div>
                    </LayoutView>
                }
            </NotAuthorized>
            <Authorizing>
                <div style="padding:2rem;text-align:center;">Carregando...</div>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
