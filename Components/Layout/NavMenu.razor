@code {
    private string? grupoExpandido;
    private HashSet<string> permissoes = new();
    private string nomeUsuario = string.Empty;

    private static readonly Dictionary<string, string[]> PermissoesPorGrupo = new()
    {
        ["geral"] = new[] { "Unidades.Ver", "Competencias.Ver" },
        ["academico"] = new[] { "Cursos.Ver", "Titulacoes.Ver", "EscalasAulasPraticas.Ver", "Tutores.Ver" },
        ["cadastros"] = new[] { "Colaboradores.Ver", "Fornecedores.Ver", "CategoriasFornecedores.Ver", "ContasBancarias.Ver", "PlanosContas.Ver", "FormasPagamento.Ver" },
        ["pagamentos"] = new[] { "FolhasTutores.Ver", "FolhasColaboradores.Ver", "FolhasFornecedores.Ver" },
        ["financeiro"] = new[] { "RelatoriosFinanceiros.Ver", "Entradas.Ver", "Cnab.Ver", "Arquivos.Ver" },
        ["admin"] = new[] { "Usuarios.Ver", "Perfis.Ver" },
    };

    private static readonly Dictionary<string, string[]> RotasPorGrupo = new()
    {
        ["geral"] = new[] { "unidades", "competencias" },
        ["academico"] = new[] { "cursos", "titulacoes", "escalas-aulas-praticas", "tutores" },
        ["cadastros"] = new[] { "colaboradores", "fornecedores", "categorias-fornecedores", "contas-bancarias", "planos-contas", "formas-pagamento" },
        ["pagamentos"] = new[] { "folhas-tutores", "folhas-colaboradores", "folhas-fornecedores" },
        ["financeiro"] = new[] { "relatorios-financeiros", "entradas", "financeiro/cnab", "arquivos" },
        ["admin"] = new[] { "admin/usuarios", "admin/perfis" },
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        permissoes = user.Claims
            .Where(c => c.Type == ClaimsPermissao.TipoPermissao)
            .Select(c => c.Value)
            .ToHashSet();

        nomeUsuario = user.FindFirst("nome_completo")?.Value
            ?? user.Identity?.Name
            ?? "Usuário";

        AtualizarGrupoPelaRota(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private bool PodeVer(string permissao) => permissoes.Contains(permissao);

    private bool GrupoVisivel(string grupo) =>
        PermissoesPorGrupo.TryGetValue(grupo, out var reqs) && reqs.Any(permissoes.Contains);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        AtualizarGrupoPelaRota(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void AtualizarGrupoPelaRota(string uri)
    {
        var rota = NavigationManager.ToBaseRelativePath(uri);

        var q = rota.IndexOf('?');
        if (q >= 0)
            rota = rota.Substring(0, q);

        rota = rota.Trim('/').ToLowerInvariant();

        // Home / raiz: recolhe todos os submenus
        if (string.IsNullOrEmpty(rota))
        {
            grupoExpandido = null;
            return;
        }

        foreach (var (grupo, rotas) in RotasPorGrupo)
        {
            foreach (var r in rotas)
            {
                if (rota == r || rota.StartsWith(r + "/", StringComparison.Ordinal))
                {
                    grupoExpandido = grupo;
                    return;
                }
            }
        }
        // Rota não mapeada: mantém o estado atual.
    }

    private bool GrupoAberto(string grupo) => grupoExpandido == grupo;

    private void ToggleGrupo(string grupo)
    {
        // Acordeão: abre o grupo clicado e recolhe os demais (ou fecha se já aberto).
        grupoExpandido = grupoExpandido == grupo ? null : grupo;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
